# Index
#
# Routing table for the breadstuffs hypersemantic tree.

#>spw_index
#:index

^"roots"{
  @readme: ~"./README.md"
  @poem: ~"./root.spw"
  @shelves: ~"./shelves.spw"
  @mount: ~"./mount.spw"
  @workspace: ~"./workspace.spw"
}

^"projections"{
  @polymap: ~"./topography/polymap.spw"
  @strata: ~"./topography/strata.spw"
  @lanes: ~"./topography/lanes.spw"
  @trust: ~"./topography/trust.spw"
  @valence: ~"./topography/valence.spw"
  @laws: ~"./topography/laws.spw"
  @horizon: ~"./topography/horizon.spw"
  @praxis: ~"./topography/praxis.spw"
  @chronicle: ~"./topography/chronicle.spw"
  @shadow: ~"./topography/shadow.spw"
}

^"regions"{
  @kernel: ~"./regions/kernel.spw"
  @metatheory: ~"./regions/metatheory.spw"
  @guardians: ~"./regions/guardians.spw"
  @settlement: ~"./regions/settlement.spw"
  @deos: ~"./regions/deos.spw"
  @mesh: ~"./regions/mesh.spw"
  @dreggnet: ~"./regions/dreggnet.spw"
  @intellect: ~"./regions/intellect.spw"
}

^"lenses"{
  @summon: ~"./lenses/summon.spw"
  @hoardlight: ~"./lenses/hoardlight.spw"
}

^"reading_order"{
  ~#machine: "poem → polymap → the projection you need → the region it names → a lens to inhabit it"
  ~#human: "README.md first"
}
