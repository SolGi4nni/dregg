# Gauge
#
# The density instrument: how much mirror per unit of crystal, measured.

#>spw_gauge
#:topography #!instrument

^"crystal"{
  ~#rust: "2,152,394 lines (target/, vendor/, .lake pruned)"
  ~#lean: "~807,544 lines (excluding .lake)"
  ~#prose: "~658,827 lines of markdown"
  ~#total: "~3.6M lines" .{ measured: "2026-07-23" }
}

^"mirror"{
  ~#floor: "0.02% of crystal — the agreed minimum, ~720 lines"
  ~#waypoint: "0.1% — ~3,600 lines; enough for cards over every region, lane, and load-bearing concept"
  ~#measure: "npm run spw:invent -- @spw — the lines column sums the mirror; recompute crystal with the pruned find|wc"
}

^"ratio_discipline"{
  ~#not_a_race: "density is a floor, not a goal — a bloated mirror is documentation wearing a costume (see lens discipline)"
  ~#growth_vector: "grow by CARDS (concepts, regions) and STATUS CHANGES, not by prose; a card that cannot be emitted as a pack is too big"
  ~#staleness: "when a card contradicts the crystal, the card notes the move (see polymap drift clause) — a stale mirror is worse than a small one"
}
