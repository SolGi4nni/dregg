# Polymap
#
# Router for the semantic polymapping: several projections of one territory,
# each a different answer to "what is this repo?". A crate may appear in
# every map with a different role — that is the point, not a conflict.

#>spw_polymap
#:topography #!router

^"projections"{
  @strata: ~"./strata.spw"       // geology — what layers the mass deposits in
  @lanes: ~"./lanes.spw"         // excavation — who is digging, where, and why
  @trust: ~"./trust.spw"         // assurance — what is proven, assumed, owed
  @valence: ~"./valence.spw"     // material — how each mass is changing
  @laws: ~"./laws.spw"           // constitution — the ember-set non-negotiables
  @horizon: ~"./horizon.spw"     // frontier — the named-follow-up burn-down
  @praxis: ~"./praxis.spw"       // methodology — how the work actually works
  @chronicle: ~"./chronicle.spw" // time — nine days that contain two months
  @shadow: ~"./shadow.spw"       // undocumented mass — what the story omits
}

^"regions"{
  ~#role: "summonable one-screen cards, one per territory — the projections say where and why; the regions say what"
  #[cards]{ kernel metatheory guardians settlement deos mesh dreggnet intellect }
  @dir: ~"../regions"
}

^"discipline"{
  ~#poly: "projections may disagree; disagreement between maps is signal, not error" #!projections_may_disagree
  ~#ground: "every ~ ref exists on disk; families are glob-prose; claims trace to the crystal or a trail file"
  ~#drift: "when the crystal moves, the map that noticed records the move; the others catch up on their own beat"
  ~#summon: "any projection section should be emittable alone — one screen, one region, one tension"
}

^"wonder"{
  ?["Which projection is missing — time? affect? blast radius?"]{
    #:ideation #!schizophrenic_ok
    $%[map.axes, corpus.strands] => ~#next_projection
  }
}
