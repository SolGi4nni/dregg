{
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext (not `bundler`) so `tsc` EMITS runnable ESM: the gate runs the
    // compiled `dist/` output, which is what makes a type error in the
    // committed sources a gate failure rather than a scratch-dir surprise.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // REQUIRED by o1js's `@state`/`@method` decorators. With `target: ES2022`
    // TypeScript defaults this to `true`, which emits `Object.defineProperty`
    // for class fields; that runs BEFORE the decorator has bound the field to
    // its contract, and `State.set` then throws "set can only be called when
    // the State is assigned to a SmartContract @state". Matches the o1js
    // zkapp-cli template.
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
