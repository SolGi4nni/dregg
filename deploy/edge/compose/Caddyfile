# TLS + routing for the edge. Caddy issues and renews certs itself; the CAA
# record in the tofu outputs authorizes Let's Encrypt to do it.

{
	email ops@dregg.net
}

# ── dregg.gg — the mirror resolver ─────────────────────────────────────────
# The click-through target for a `dregg://` object shared anywhere. Kept on its
# own domain deliberately: this is trust-tier `server`, the weakest tier in the
# system, and it should not wear the flagship domain's authority.
dregg.gg, www.dregg.gg {
	encode zstd gzip
	reverse_proxy resolver:8080

	header {
		# The resolver renders untrusted content-addressed objects. Lock it down —
		# and it can be locked down HARD, because the resolver ships NO script and
		# loads NO external resource: its CSS is inline in one <style>, and a page
		# with no in-tab executor deliberately carries no affordance wire (a
		# live-looking button over a missing executor is a lie). So `default-src
		# 'none'` with a single inline-style allowance is not aspirational here, it
		# is exactly the page. `form-action 'none'`: the only control on the page is
		# a readonly copy field, so there is no legitimate submission target.
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# ── dregg.app — the play surface ───────────────────────────────────────────
# `.app` is HSTS-preloaded at the TLD, so browsers refuse plaintext to it with
# no configuration on our part. Uncomment when the surface is ready to serve.
