# ⚠ ASPIRATIONAL — this is the GATEWAY-variant env, for a topology that does not
# exist (no Caddy on the edge; edge and hbox are on different tailnets). The LIVE
# demo uses .env.funnel.example -> ~/.config/dregg/games-funnel.env.
# See deploy/games/RUNBOOK.md's banner and deploy/README.md.
#
# deploy/games/.env.example — the dregg games stack env template.
#
# Copy to hbox at ~/.config/dregg/games.env and fill the real values, then
# `chmod 600 ~/.config/dregg/games.env`. NEVER commit the filled file.
# Both units (dregg-web-games.service + dregg-games-bot.service) read this one
# file; each ignores the vars it does not use.
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ WEB GAMES SERVER (dregg-web-games.service — dreggnet-web-server)          │
# └──────────────────────────────────────────────────────────────────────────┘

# Bind address for the games web server — the TAILSCALE interface (hbox-dregg,
# 100.95.240.73), so the AWS gateway's Caddy reaches it over the tailnet. NEVER
# 0.0.0.0 (only tailnet peers may reach it; the public internet cannot). 8790 is
# FREE on hbox (8787/8781 already taken; OPS-RUNBOOK).
DREGGNET_WEB_BIND=100.95.240.73:8790

# Durable no-cheat Descent leaderboard (sqlite). Unset -> in-RAM (lost on restart).
# Re-verified by replay on boot. Lives in the units' ReadWritePaths.
DATABASE_URL=sqlite:/home/hbox/.local/state/dregg-games/leaderboard.db

# SHARED interaction-envelope audit dir (dreggnet-audit), read by BOTH the web
# server and the games Discord bot. Point every service at the SAME absolute dir
# (this stack + dregg-telegram-bot + the discord unit) so one `auditq correlate
# --dir <this>` joins a chain across them; per-process filenames
# (audit-DATE.<platform>-<pid>.NN.jsonl) keep the one dir contention-free. `off`
# disables the audit log entirely.
# ⚠ GATEWAY-VARIANT SANDBOX: dregg-web-games.service and dregg-games-bot.service
# run ProtectSystem=strict, so for a dir OUTSIDE their ReadWritePaths (this dir
# is under .local/state/dregg, not dregg-games) the audit writer would fail-safe
# to DISABLED. To use it there, add `ReadWritePaths=%h/.local/state/dregg` to
# those units and pre-create the dir. The live funnel/telegram/hbox-discord units
# carry no such sandbox and already set this via Environment=.
DREGG_AUDIT_DIR=/home/hbox/.local/state/dregg/audit

# ── SHIELDED OPERATIONS ─────────────────────────────────────────────────────
# The deploy builds dreggnet-web with `public-shielded-games`; these variables
# decide which key-bearing operations are registered at runtime. Absence is a
# fail-closed disable, never a demo key fallback.

# fhEgg settlement upload authority. Set the comma-separated Ed25519 public-key
# roster and the minimum distinct valid signers together, or leave both unset.
# DREGG_FHEGG_QUORUM_PUBLIC_KEYS=
# DREGG_FHEGG_QUORUM_THRESHOLD=

# Proof-required Dark AMM v2. The protected regular owner-only file contains the
# canonical postcard BFV secret key; INITIAL_ROOT is the eight-comma-separated
# BabyBear state root emitted by the private-transition prover. Set BOTH. A key
# without a root would select legacy proofless v1 in the generic runtime; this
# public deploy script refuses that half-configuration.
# DREGG_DARK_AMM_SECRET_KEY_FILE=/home/hbox/.config/dregg/dark-amm-secret-key.postcard
# DREGG_DARK_AMM_INITIAL_ROOT=<eight comma-separated decimal lanes from private-init>
# Strict v3 also requires a relying-party-selected issuer roster. Each issuer
# sees the private transition and exact encryption seeds before signing; this
# authenticates same-opening but is not no-viewer custody. Set BOTH values.
# DREGG_DARK_AMM_AUTHORITY_PUBLIC_KEYS=<comma-separated 32-byte Ed25519 keys in hex>
# DREGG_DARK_AMM_AUTHORITY_THRESHOLD=<required signatures, 1..roster length>

# ┌──────────────────────────────────────────────────────────────────────────┐
# │ DISCORD GAMES BOT (dregg-games-bot.service — dregg-discord-bot)           │
# └──────────────────────────────────────────────────────────────────────────┘

# REQUIRED — from the Discord developer portal. ⚠ ember places these; no prod
# token is ever committed or slung by an agent.
DISCORD_TOKEN=
DISCORD_APP_ID=
# 64 hex chars (32 bytes) — deterministic per-user cipherclerk derivation.
BOT_SECRET=

# The Descent daily-reveal announce channel (numeric Discord channel id). Unset ->
# the daily still rolls, it is only logged (no channel post). reveal_cron.rs.
DESCENT_ANNOUNCE_CHANNEL_ID=

# drand HTTP API base the daily-reveal cron fetches today's BLS-verified round
# from. Default (unset) = https://api.drand.sh (procgen_dregg::beacon::DRAND_API_BASE).
DRAND_API_BASE=https://api.drand.sh

# The bot's sqlite db (channels, gallery, characters). In the units' ReadWritePaths.
# NOTE: DATABASE_URL is shared with the web server above — if you want the bot and
# the web board in SEPARATE sqlite files, split games.env into two EnvironmentFiles
# (see deploy/games/RUNBOOK.md). One combined file is the low-friction default.

# ── OPTIONAL ────────────────────────────────────────────────────────────────
# Explicit node URL. The games demo is node-FREE, so leave UNSET for the standalone
# public demo. Set only if you also want the bot's devnet-backed commands live
# against a testnet node (Phase 2).
# DEVNET_URL=https://devnet.dregg.fg-goose.online

# The bot's HTTP read surface (Starbridge RemoteRuntime / observability). Localhost
# only; not part of the games public demo. Defaults 0.0.0.0:8080 in code — pin to
# localhost here so it is never exposed.
HTTP_HOST=127.0.0.1
HTTP_PORT=8092

# ── GATEWAY / DEPLOY ─────────────────────────────────────────────────────────
# These are read by the AWS GATEWAY's Caddy (deploy/games/caddy/Caddyfile.games
# runs on the gateway, NOT on hbox — set them in the gateway Caddy's environment,
# e.g. its systemd Environment=). They are NOT used by the hbox units.
# The public games domain the gateway's Caddy serves with Let's Encrypt TLS.
DREGG_GAMES_DOMAIN=games.dregg.fg-goose.online
# The Tailscale upstream the gateway reverse-proxies to (hbox-dregg:8790).
DREGG_GAMES_UPSTREAM=100.95.240.73:8790
