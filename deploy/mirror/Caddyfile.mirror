# ==============================================================================
# dregg.gg — the MIRROR RESOLVER site block (tier-`server` view of dregg:// objects)
# ==============================================================================
#
# Serves `dregg-mirror` (package `dregg-mirror`, bin `dregg-mirror`): the no-extension
# on-ramp. Someone clicks `https://dregg.gg/poll/7f2a9c4d` from X or Discord with nothing
# installed; the mirror resolves the content address and renders the object under an
# honest tier-`server` label. DREGG-QUIET-UPGRADE.md §9 item 4.
#
# ── STATUS ────────────────────────────────────────────────────────────────────
# NOT INSTALLED. This is the config to install, not a description of a running box.
# The two prerequisites, both ember-gated, both verifiable in one command each:
#
#   P1. DNS: dregg.gg A -> the edge EIP 34.224.208.52  (and www.dregg.gg the same).
#           `dig +short dregg.gg` must return that address before Caddy can pass ACME.
#   P2. The EC2 security group must admit :80 and :443 from 0.0.0.0/0. Today the edge
#           publishes :8420 and :9420/udp (deploy/README.md); 80/443 are NOT known open.
#           `aws ec2 describe-security-groups` on i-03365e2bcf4ea08b2 to confirm.
#
# ── WHY THE EDGE AND NOT hbox ─────────────────────────────────────────────────
# hbox serves the live games at https://hbox-dregg.skunk-emperor.ts.net via
# `tailscale funnel`. Funnel can ONLY publish a `*.ts.net` name — it cannot serve
# dregg.gg, so the mirror cannot ride the games' existing public path. And the edge
# CANNOT reverse-proxy hbox: they are on two disconnected tailnets (deploy/README.md's
# load-bearing fact). So the mirror runs ON the edge, next to the node, and Caddy on
# the edge is the one new public component.
#
# The edge runs a docker compose stack, NOT systemd (deploy/README.md). So this file is
# mounted into a `caddy` service added to /opt/dreggnet/docker-compose.yml, alongside a
# `dregg-mirror` service. `deploy/mirror/dregg-mirror.service` is the systemd variant for
# a box that does use units (persvati, hbox) — same binary, same env.
#
# ── WHY A PLAIN SITE BLOCK, NOT THE ON-DEMAND-TLS GATEWAY ─────────────────────
# `deploy/gateway-ask/Caddyfile.on-demand-tls` is the right pattern for HOSTED CUSTOMER
# domains: one wildcard block, certificates minted per inbound SNI, gated by an `ask` to
# the verified-domain registry. The mirror is a FIRST-PARTY apex we own — there is exactly
# one name, it is known at config time, and on-demand issuance would only add an
# unbounded-issuance surface for nothing. If the on-demand gateway is what ends up
# deployed on the edge, fold the mirror in as one more `handle` rather than running two
# Caddies.
#
# ── ACME ──────────────────────────────────────────────────────────────────────
# Plain HTTP-01, which Caddy does by itself: no plugin, no DNS API token, no wildcard.
# A wildcard (`*.dregg.gg`) would force DNS-01 and therefore a registrar API credential
# on the box — we do not need one, because the mirror needs exactly `dregg.gg` and
# `www.dregg.gg`. Keep it that way; a wildcard here would be a credential we do not have
# to hold.
#
# ── PARAMETERS ────────────────────────────────────────────────────────────────
#   {$DREGG_MIRROR_DOMAIN}    default dregg.gg
#   {$DREGG_MIRROR_UPSTREAM}  default 127.0.0.1:8791 (the mirror's loopback bind)
#   {$ACME_EMAIL}             the Let's Encrypt account contact

{
	email {$ACME_EMAIL}
}

{$DREGG_MIRROR_DOMAIN:dregg.gg}, www.{$DREGG_MIRROR_DOMAIN:dregg.gg} {
	# The mirror is READ-ONLY (it answers 405 to anything but GET/HEAD — acting on a
	# dregg object needs custody, which is never on this server). A body cap is
	# therefore pure defence: nothing here has a use for a request body at all.
	request_body {
		max_size 16KB
	}

	# CONTENT SECURITY POLICY — genuinely tight, because the mirror earns it: the page
	# ships NO script (deliberately: a live-looking affordance over a missing executor
	# is a lie), loads NO external resource, and its CSS is inline in one <style>. So
	# everything except that one style source can be denied outright. `form-action
	# 'none'` matters: the page carries a readonly copy field and nothing else, so
	# there is no legitimate submission target.
	header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "DENY"
	header Referrer-Policy "strict-origin-when-cross-origin"
	# HSTS — turn on AFTER a first successful certificate, not before. Enabling it on a
	# name whose TLS is not yet working pins browsers to a broken https.
	# header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# RATE LIMITING — NAMED, not built in. Caddy core has no `rate_limit`; it needs
	# `caddyserver/caddy-ratelimit` baked in via xcaddy. This is a NICE-TO-HAVE here, not
	# a gate: the mirror's per-request work is one blake3 over a small object plus a
	# string render, with no compute-amplifying endpoint (contrast DrEX's POST /clear).
	# With the plugin:
	#   rate_limit {
	#       zone mirror_per_ip { key {remote_host}  events 240  window 1m }
	#   }

	# The uptime probe. Proxied so it reflects the mirror, not merely Caddy being up.
	handle /healthz {
		reverse_proxy {$DREGG_MIRROR_UPSTREAM:127.0.0.1:8791}
	}

	handle {
		reverse_proxy {$DREGG_MIRROR_UPSTREAM:127.0.0.1:8791}
	}

	log {
		output stderr
		format console
	}
}
