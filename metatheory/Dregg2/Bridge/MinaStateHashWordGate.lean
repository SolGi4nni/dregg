/-- The endomorphism scalar for the **Tick / Step** side — Vesta's `endo_r`, an `Fp` element
(`endo.ml:5-12`, `Endo.Wrap_inner_curve.scalar`). `Ipa.Step.compute_challenges` maps every 128-bit
step prechallenge through it before it enters the 93-element preimage. -/
def ENDO_TICK : Nat :=
  8503465768106391777493614032514048814691664078728891710322960303815233784505

/-- The endomorphism scalar for the **Tock / Wrap** side — Pallas's `endo_r`, an `Fq` element
(`endo.ml:14-21`, `Endo.Step_inner_curve.scalar`). Same constant `MinaRealBlockTranscript.ENDO_R`
uses for α′ ↦ α and ζ′ ↦ ζ. -/
def ENDO_TOCK : Nat :=
  26005156700822196841419187675678338661165322343552424574062261873906994770353

/-- `ScalarChallenge::limbs_to_field` on the STEP side: `KimchiVerify.endoMap` at `ZMod pN`.

⚑ The expansion is done HERE, in Lean, over the map `MinaRealBlockTranscript` already pins against
real Mina data — not in the Rust decoder. The wire carries the RAW 128-bit prechallenge exactly as
`bridge/src/mina_pickles.rs` reads it, so no field arithmetic exists on the Rust side to drift. -/
def expandTick (c : Nat) : Nat := (Dregg2.Circuit.Emit.KimchiVerify.endoMap
  ((ENDO_TICK : ZMod pN)) c).val

/-- …and on the WRAP side, at `ZMod qN`. -/
def expandTock (c : Nat) : Nat := (Dregg2.Circuit.Emit.KimchiVerify.endoMap
  ((ENDO_TOCK : ZMod qN)) c).val

/-- **`accFields`** — the 36-element accumulator half of the `messages_for_next_step_proof`
preimage, INTERLEAVED per proof: `[x₀, y₀] ‖ chals₀(16) ‖ [x₁, y₁] ‖ chals₁(16)`
(`composition_types.ml:580-593` — `Vector.map2`, so commitment and challenges alternate; a gate
that grouped all commitments then all challenges would hash a different list). -/
def accFields (comm chals : List Nat) : List Nat :=
  comm.take 2 ++ (chals.take 16).map expandTick
  ++ comm.drop 2 ++ (chals.drop 16).map expandTick

/-- **`mnwFields`** — the 32-element `messages_for_next_wrap_proof` preimage: all `2 × 15` Tock
challenges FIRST, the commitment `(x, y)` LAST (`composition_types.ml:411-418`) — the mirror of
the step side, and the ordering that is easy to get backwards.

⚑ `Wrap_hack`'s front-padding with `Dummy.Ipa.Wrap.challenges_computed` is NOT implemented: this
gate requires exactly two challenge vectors and refuses anything else, rather than silently
inserting a constant that would let a proof with fewer accumulators hash to a well-formed word. -/
def mnwFields (comm chals : List Nat) : List Nat := chals.map expandTock ++ comm

/-- **`word12`** — public-input word 12, the ONLY block-dependent word of the Wrap statement.
`Poseidon_fp(VK_INDEX ‖ [stateHash] ‖ accFields)`, a zero-state `fp_kimchi` sponge with no domain
prefix (`hash_fields`, `mina-rust/poseidon/src/hash.rs:225`; `make_sponge.ml:135-139`). -/
def word12 (stateHash : Nat) (comm chals : List Nat) : Nat :=
  hash fpParams (VK_INDEX ++ stateHash :: accFields comm chals)

/-- **`word11`** — public-input word 11, `messages_for_next_wrap_proof`. Over **`Fq`**
(`fq_kimchi`), not `Fp`: the wrap-hack digest is a Tock sponge. Getting that field wrong is the
mistake the parametric `Core` exists to make impossible to make twice — §4 pins the anti-value. -/
def word11 (comm chals : List Nat) : Nat := hash fqParams (mnwFields comm chals)

/-- **One block's header-side projection**, every field a READ. `stateHash` is the Base58Check
decode of the served `stateHash` as an `Fp`; the four lists come straight out of the binprot proof
with no arithmetic; the two golds are what an accepted `kimchi::verifier::verify` consumed. -/
structure Header where
  /-- `blockchain_length`, so a pin names a block rather than an index. -/
  height : Nat
  /-- the served `stateHash`, Base58Check-decoded into `Fp`. -/
  stateHash : Nat
  /-- `messages_for_next_step_proof.challenge_polynomial_commitments` — `[x₀, y₀, x₁, y₁]`. -/
  accComm : List Nat
  /-- `…old_bulletproof_challenges` — 2 × 16 RAW 128-bit prechallenges. -/
  accChals : List Nat
  /-- `messages_for_next_wrap_proof.challenge_polynomial_commitment` — `[x, y]`. -/
  mnwComm : List Nat
  /-- `…old_bulletproof_challenges` — 2 × 15 RAW 128-bit prechallenges. -/
  mnwChals : List Nat
  /-- public-input word 12, as the accepted verification saw it. -/
  word12Gold : Nat
  /-- public-input word 11, likewise. -/
  word11Gold : Nat
deriving Repr

/-- **`headerShapeOk`** — arities and ranges, checked before any hashing.

The `stateHash` bound is `Fp`, not `Fq`: a state hash that does not reduce is not a Mina state
hash, and openmina's `four_u64_to_field` FAILS on it rather than wrapping (`util.rs:58-67`). `0` is
refused for the same reason `(0,0)` is refused as an accumulator in the chain gate — it is what an
absent field decodes to. Every prechallenge must be `< 2^128`, the width `Challenge.Constant`
declares; a wider value would silently lose bits in `endoMap`'s 64-iteration loop. -/
def headerShapeOk (h : Header) : Bool :=
  decide (h.accComm.length = 4)
  && decide (h.accChals.length = ACC_CHALS)
  && decide (h.mnwComm.length = 2)
  && decide (h.mnwChals.length = MNW_CHALS)
  && decide (0 < h.stateHash)
  && decide (h.stateHash < pN)
  && decide (h.word12Gold < pN)
  && decide (h.word11Gold < qN)
  && h.accChals.all (fun c => decide (c < 2 ^ 128))
  && h.mnwChals.all (fun c => decide (c < 2 ^ 128))
  && h.accComm.all (fun x => decide (x < pN))
  && h.mnwComm.all (fun x => decide (x < qN))

/-- **`headerOk`** — THE DECISION: the served header and the served proof bytes hash to the two
public-input words the verification consumed. -/
def headerOk (h : Header) : Bool :=
  headerShapeOk h
  && decide (word12 h.stateHash h.accComm h.accChals = h.word12Gold)
  && decide (word11 h.mnwComm h.mnwChals = h.word11Gold)

/-! ## §2 — WHAT AN ACCEPT ENTAILS. Kernel theorems about the CHECKER; §4 is the INSTANCE. -/

/-- An accept entails both derivations, at the right arities, over a reduced state hash. -/
theorem headerOk_entails {h : Header} (hok : headerOk h = true) :
    h.accComm.length = 4 ∧ h.accChals.length = ACC_CHALS
    ∧ h.mnwComm.length = 2 ∧ h.mnwChals.length = MNW_CHALS
    ∧ 0 < h.stateHash ∧ h.stateHash < pN
    ∧ word12 h.stateHash h.accComm h.accChals = h.word12Gold
    ∧ word11 h.mnwComm h.mnwChals = h.word11Gold := by
  unfold headerOk headerShapeOk at hok
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hok
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> tauto

/-- ⚑ **The accumulator half really is 36 elements** at the accepted arities, so word 12 is the
digest of the object `hash_messages_for_next_step_proof` hashes. -/
theorem accFields_length {comm chals : List Nat}
    (hc : comm.length = 4) (hh : chals.length = ACC_CHALS) :
    (accFields comm chals).length = 36 := by
  unfold accFields ACC_CHALS at *
  simp [List.length_append, List.length_map, List.length_take, List.length_drop, hc, hh]

/-- …hence the whole preimage is **93**. -/
theorem word12_preimage_is_93 {comm chals : List Nat}
    (hc : comm.length = 4) (hh : chals.length = ACC_CHALS) (sh : Nat) :
    (VK_INDEX ++ sh :: accFields comm chals).length = MNS_LEN := by
  have hv : VK_INDEX.length = 56 := by decide
  simp [List.length_append, List.length_cons, hv, accFields_length hc hh, MNS_LEN]

/-- …and the `messages_for_next_wrap_proof` preimage is **32**. -/
theorem mnwFields_length {comm chals : List Nat}
    (hc : comm.length = 2) (hh : chals.length = MNW_CHALS) :
    (mnwFields comm chals).length = MNW_LEN := by
  unfold mnwFields MNW_CHALS MNW_LEN at *
  simp [List.length_append, List.length_map, hc, hh]

/-- ⚑ **The state hash sits at index 56**, between the verification key and the accumulators — the
position `to_fields` puts it in. A gate that hashed the right 93 values in the wrong ORDER would
still be a function of the header; this says WHICH function. -/
theorem state_hash_is_at_index_56 (sh : Nat) (acc : List Nat) :
    (VK_INDEX ++ sh :: acc).drop 56 = sh :: acc := by
  rfl

/-- A refused header is refused: the contrapositive an observer reports on. -/
theorem headerOk_false_of_word12 {h : Header}
    (hw : word12 h.stateHash h.accComm h.accChals ≠ h.word12Gold) : headerOk h = false := by
  unfold headerOk
  have : decide (word12 h.stateHash h.accComm h.accChals = h.word12Gold) = false := by simp [hw]
  rw [this]; simp

