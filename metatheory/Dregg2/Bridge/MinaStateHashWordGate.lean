/-! ## §5 — THE WIRE GATE + `@[export]`. Same `String → String` C-ABI shape as
`dregg_mina_proof_chain_ok`: `"1"` ACCEPT, `"0"` REJECT, `"ERR"` on any malformed wire (the caller
treats `"ERR"` as REJECT). One call per exhibited block. -/

/-- Parse a `key=value` field, fail-closed on a key mismatch or a missing `=`. -/
def parseField? (key part : String) : Option String :=
  match part.splitOn "=" with
  | [k, v] => if k == key then some v else none
  | _ => none

/-- Parse a `,`-separated `Nat` list, fail-closed on any non-numeral. The EMPTY string is `none`,
not `some []`: an absent vector must not read as a well-formed empty one. -/
def parseNats? (s : String) : Option (List Nat) :=
  match s.splitOn "," with
  | [] => none
  | parts => parts.foldr (fun p acc => do
      let rest ← acc
      let n ← p.toNat?
      pure (n :: rest)) (some [])

/-- **`decodeHeaderWire`** — the `INPUT` grammar, fail-closed on any deviation. Every field is a
decoder READ; no field on this wire was produced by Rust arithmetic.

```
INPUT := "sh="  Nat                  -- the served stateHash, Base58Check-decoded into Fp
       ";ac="  Nat("," Nat)*3        -- challenge_polynomial_commitments: x0,y0,x1,y1
       ";ah="  Nat("," Nat)*31       -- 2 x 16 RAW 128-bit step prechallenges
       ";wc="  Nat("," Nat)          -- messages_for_next_wrap_proof commitment: x,y
       ";wh="  Nat("," Nat)*29       -- 2 x 15 RAW 128-bit wrap prechallenges
       ";w12=" Nat ";w11=" Nat       -- the two public-input words the verification consumed
```
-/
def decodeHeaderWire (s : String) : Option Header :=
  match s.splitOn ";" with
  | [p0, p1, p2, p3, p4, p5, p6] => do
      let sh ← (parseField? "sh" p0).bind String.toNat?
      let ac ← (parseField? "ac" p1).bind parseNats?
      let ah ← (parseField? "ah" p2).bind parseNats?
      let wc ← (parseField? "wc" p3).bind parseNats?
      let wh ← (parseField? "wh" p4).bind parseNats?
      let w12 ← (parseField? "w12" p5).bind String.toNat?
      let w11 ← (parseField? "w11" p6).bind String.toNat?
      some { height := 0, stateHash := sh, accComm := ac, accChals := ah,
             mnwComm := wc, mnwChals := wh, word12Gold := w12, word11Gold := w11 }
  | _ => none

/-- **`minaStateHashWordGate`** — THE GATE. -/
def minaStateHashWordGate (s : String) : String :=
  match decodeHeaderWire s with
  | some h => if headerOk h then "1" else "0"
  | none => "ERR"

/-- **THE EXPORT.** The C-ABI entry `dregg-lean-ffi` calls once per exhibited block. -/
@[export dregg_mina_state_hash_word_ok]
def dregg_mina_state_hash_word_ok (s : String) : String := minaStateHashWordGate s

/-- **`minaStateHashWordGate_eq_decision`** — the gate string IS the decision, by construction, so
§2's theorems are theorems about what the export returns. -/
theorem minaStateHashWordGate_eq_decision (s : String) (h : Header)
    (hd : decodeHeaderWire s = some h) :
    minaStateHashWordGate s = (if headerOk h then "1" else "0") := by
  unfold minaStateHashWordGate
  rw [hd]

/-! ## §6 — the wire, on the REAL blocks, in the compiled evaluator. -/

/-- Render a header as its own wire, so the Rust builder (`dregg-lean-ffi`'s
`mina_state_hash_word_wire`) and this module are checkable against one another. -/
def wireOf (h : Header) : String :=
  "sh=" ++ toString h.stateHash
  ++ ";ac=" ++ String.intercalate "," (h.accComm.map toString)
  ++ ";ah=" ++ String.intercalate "," (h.accChals.map toString)
  ++ ";wc=" ++ String.intercalate "," (h.mnwComm.map toString)
  ++ ";wh=" ++ String.intercalate "," (h.mnwChals.map toString)
  ++ ";w12=" ++ toString h.word12Gold
  ++ ";w11=" ++ toString h.word11Gold

-- ⚑ Every real block ACCEPTS through the string surface the C ABI actually crosses.
#guard HEADERS.all (fun h => minaStateHashWordGate (wireOf h) == "1") == true
-- ⚑ …and a foreign header REFUSES at the wire, not merely in the decision.
#guard minaStateHashWordGate (wireOf { B539508 with stateHash := B539795.stateHash }) == "0"
#guard minaStateHashWordGate (wireOf { B539795 with stateHash := B539508.stateHash }) == "0"
-- the round trip really is the same header (a wire that decoded to something else would make the
-- accepts above true of the wrong object)
#guard (decodeHeaderWire (wireOf B539508)).map (fun h =>
          h.stateHash == B539508.stateHash && h.accComm == B539508.accComm
          && h.accChals == B539508.accChals && h.mnwComm == B539508.mnwComm
          && h.mnwChals == B539508.mnwChals && h.word12Gold == B539508.word12Gold
          && h.word11Gold == B539508.word11Gold)
       == some true
-- A malformed wire is `"ERR"`, never an accept.
#guard minaStateHashWordGate "sh=1;ac=1;ah=1;wc=1;wh=1;w12=1" == "ERR"
#guard minaStateHashWordGate "xh=1;ac=1;ah=1;wc=1;wh=1;w12=1;w11=1" == "ERR"
#guard minaStateHashWordGate "sh=1;ac=1,x;ah=1;wc=1;wh=1;w12=1;w11=1" == "ERR"
#guard minaStateHashWordGate "sh=1;ac=;ah=;wc=;wh=;w12=1;w11=1" == "ERR"
#guard minaStateHashWordGate "garbage" == "ERR"
#guard minaStateHashWordGate "" == "ERR"
-- A well-formed wire with the right arities but a wrong value REFUSES (`"0"`), so `"ERR"` and
-- `"0"` are distinguishable and the arity conjunct is not what every refusal is.
#guard minaStateHashWordGate (wireOf { B539508 with word12Gold := B539508.word12Gold + 1 }) == "0"

