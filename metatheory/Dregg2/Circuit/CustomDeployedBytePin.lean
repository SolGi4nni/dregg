/-- The committed NAME (TSV column 2). -/
def CUSTOM_V3_DEPLOYED_NAME : String :=
  "dregg-effectvm-custom-v1-rot24-v3-staged-gentian-deployed-bare-refuse"

/-- The `proof_bind` op AS COMMITTED, verbatim from the golden. The ONLY recursion-binding op in
the deployed custom descriptor. -/
def CUSTOM_V3_DEPLOYED_PROOF_BIND_JSON : String :=
  ProofBind.toJson customV3ProofBind

/-! ## §2 — THE BYTE PIN (the (b) → (c) step). -/

-- THE PIN: the Lean object emits the committed bytes, character for character. If the deployed
-- descriptor is ever regenerated with a different shape, THIS goes red at elaboration — no shell
-- script, no full-tree rebuild, no `PROVENANCE.json` round-trip required.
#guard emitVmJson2 deployedCustomV3 == CUSTOM_V3_DEPLOYED_GOLDEN

-- ...and the object IS the registry member the emitter prints for the key (not a look-alike built
-- alongside it). `Option.any` is FALSE on `none`, so a missing key fails the guard.
#guard (v3RegistryCapOpenDep.lookup "customVmDescriptor2R24").any
  (fun d => emitVmJson2 (dropUnforcedPins (hardenLastRow
    (Dregg2.Circuit.Emit.FieldsCanonicity9Emit.fieldsCanonical9Wire
      (Dregg2.Circuit.Emit.KeyCanonicity9Emit.keyCanonical9Wire
        (ownerFreezeWire d))))) == CUSTOM_V3_DEPLOYED_GOLDEN)

#guard deployedCustomV3.name == CUSTOM_V3_DEPLOYED_NAME

/-! ## §3 — what the committed bytes DO and DO NOT contain. -/

-- EXACTLY ONE `proof_bind` op in the shipped bytes (a `splitOn` of a string containing `n`
-- occurrences has `n+1` pieces).
#guard (CUSTOM_V3_DEPLOYED_GOLDEN.splitOn "\"t\":\"proof_bind\"").length == 2

-- ...and it is EXACTLY the deployed-column op: guard = the Custom selector column 8,
-- commit = `custom_proof_commitment` limb 0 (col 72), vk = `custom_program_vk_hash` limb 0 (col 68).
#guard (CUSTOM_V3_DEPLOYED_GOLDEN.splitOn CUSTOM_V3_DEPLOYED_PROOF_BIND_JSON).length == 2

-- The structural counterpart, read off the descriptor value rather than the string.
#guard (proofBindsOf deployedCustomV3).length == 1

/-! ### §3b — the commitment / VK columns are READ BY NOTHING in the deployed bytes.

The eight commitment limbs (`custom_proof_commitment` = cols 72..75 low + `CUSTOM_COMMIT_TEETH_COL`
+0..3 high = 1679..1682) and the eight VK limbs (`custom_program_vk_hash` = cols 68..71 low +
`CUSTOM_VK_TEETH_COL`+0..3 high = 1667..1670) are the columns the
`proof_bind` op names and the sixteen `customPiExposure` pins publish. The question the vacuity
theorem below turns on is whether ANY OTHER constraint in the shipped descriptor reads them — a
gate, a boundary polynomial, a lookup tuple, a window gate. It does not, and that is CHECKED here
over the value the §2 pin ties to the committed bytes, not asserted in prose. -/

/-- The sixteen deployed custom binding columns. The eight HIGH limbs are named by the emitter's own
teeth constants (`CUSTOM_COMMIT_TEETH_COL` / `CUSTOM_VK_TEETH_COL`), so a geometry flag day moves
them here automatically instead of leaving a stale literal that silently checks the wrong columns —
the `#guard` below is what pins the concrete numerals. -/
def customBindingCols : List Nat :=
  [ 68, 69, 70, 71, 72, 73, 74, 75
  , CUSTOM_COMMIT_TEETH_COL, CUSTOM_COMMIT_TEETH_COL + 1
  , CUSTOM_COMMIT_TEETH_COL + 2, CUSTOM_COMMIT_TEETH_COL + 3
  , CUSTOM_VK_TEETH_COL, CUSTOM_VK_TEETH_COL + 1
  , CUSTOM_VK_TEETH_COL + 2, CUSTOM_VK_TEETH_COL + 3 ]

-- ⚑ The concrete indices used to be spelled here (1619..1626, then 1663..1670, then 1679..1686,
-- then 1791..1798 — retyped once per flag day, red once per flag day, and detecting nothing in
-- between, because they were `CUSTOM_{COMMIT,VK}_TEETH_COL` checked against their own definitions).
-- What the list actually claims is its SHAPE: the eight v1 commitment limbs, then two contiguous
-- four-column teeth windows at the emitter's own teeth bases.  That holds at any geometry.
#guard customBindingCols.length == 16
#guard customBindingCols.take 8 == [68, 69, 70, 71, 72, 73, 74, 75]
#guard customBindingCols.drop 8
  == (List.range 4).map (CUSTOM_COMMIT_TEETH_COL + ·) ++ (List.range 4).map (CUSTOM_VK_TEETH_COL + ·)
#guard customBindingCols.Nodup

/-- Does an `EmittedExpr` read any of the custom binding columns? -/
def readsBindingCol : EmittedExpr → Bool
  | .var c   => customBindingCols.contains c
  | .const _ => false
  | .add a b => readsBindingCol a || readsBindingCol b
  | .mul a b => readsBindingCol a || readsBindingCol b

/-- Does a `WindowExpr` (the two-row carrier) read any of the custom binding columns? -/
def windowReadsBindingCol : WindowExpr → Bool
  | .loc c   => customBindingCols.contains c
  | .nxt c   => customBindingCols.contains c
  | .const _ => false
  | .add a b => windowReadsBindingCol a || windowReadsBindingCol b
  | .mul a b => windowReadsBindingCol a || windowReadsBindingCol b

/-- Does a challenge body read a Custom binding column? (`chal` leaves read no column.) -/
def chalReadsBindingCol : ChalExpr → Bool
  | .loc c | .nxt c => customBindingCols.contains c
  | .const _ | .chal _ => false
  | .add a b | .mul a b => chalReadsBindingCol a || chalReadsBindingCol b

/-- Does a constraint IMPOSE anything on a custom binding column? The two carriers that legitimately
NAME one are excluded: `.proofBind` (whose deployed denotation is `True` — it imposes nothing, which
is exactly the point) and `.base (.piBinding …)` (which only publishes the column as a public input,
imposing nothing on its VALUE). Everything else counts.

⚑ `chalGate` counts too — see `chalReadsBindingCol` above. -/
def constrainsBindingCol : VmConstraint2 → Bool
  | .base (.gate b)           => readsBindingCol b
  | .base (.boundary _ b)     => readsBindingCol b
  | .base (.transition hi lo) => customBindingCols.contains hi || customBindingCols.contains lo
  | .base (.piBinding ..)     => false
  -- ⚑ A challenge gate CONSTRAINS every binding column its body reads. `Chal(i)` reads none.
  | .chalGate w               => chalReadsBindingCol w.body
  | .lookup l                 => l.tuple.any readsBindingCol
  | .memOp _                  => true
  | .mapOp _                  => true
  | .umemOp _                 => true
  | .proofBind _              => false
  | .windowGate w             => windowReadsBindingCol w.body

-- **NO constraint in the SHIPPED descriptor imposes anything on the custom binding columns.**
-- (`memOp`/`mapOp`/`umemOp` are counted as constraining — conservatively — and the guard still
-- passes because the deployed custom member carries none of them, per `EffectVmEmitRotationV3`'s
-- own `#guard (memOpsOf customV3).length == 0` / `(mapOpsOf customV3).length == 0`.)
#guard deployedCustomV3.constraints.all (fun c => !(constrainsBindingCol c))

-- Non-vacuity of the checker itself: it is not the constant `false`. A gate reading the
-- commitment column IS detected, and one reading an unrelated column is NOT.
#guard constrainsBindingCol (.base (.gate (.var 72))) == true
#guard constrainsBindingCol (.base (.gate (.var 71))) == true
#guard constrainsBindingCol (.base (.gate (.var CUSTOM_COMMIT_TEETH_COL))) == true
#guard constrainsBindingCol (.base (.gate (.var 54))) == false
#guard constrainsBindingCol (.windowGate ⟨.nxt 72, true⟩) == true

/-! ## §4 — the DEPLOYED columns, as theorems. -/

set_option maxRecDepth 40000 in
/-- **The op's columns are the shipped ones — ALL SIXTEEN.** ⚑ Until 2026-08-05 this theorem read
`(guard := var 8, commit := var 72, vk := var 68)`: the op named LIMB 0 of each eight-felt object
while the sixteen `customPiExposure` pins published both digests whole. The declaration is now the
same width as the exposure — the four low commitment limbs then the four commit-teeth, the four low
VK limbs then the four VK-teeth. -/
theorem customV3ProofBind_is_deployed_columns :
    customV3ProofBind =
      { guard  := .var 8
      , commit := [.var 72, .var 73, .var 74, .var 75
                  , .var CUSTOM_COMMIT_TEETH_COL, .var (CUSTOM_COMMIT_TEETH_COL + 1)
                  , .var (CUSTOM_COMMIT_TEETH_COL + 2), .var (CUSTOM_COMMIT_TEETH_COL + 3)]
      , vk     := [.var 68, .var 69, .var 70, .var 71
                  , .var CUSTOM_VK_TEETH_COL, .var (CUSTOM_VK_TEETH_COL + 1)
                  , .var (CUSTOM_VK_TEETH_COL + 2), .var (CUSTOM_VK_TEETH_COL + 3)]
      , vkPin := none, bound := none } := rfl

set_option maxRecDepth 40000 in
/-- ⚑ **AND IT IS AT THE LANE FLOOR.** The shipped seam declares eight lanes on each half — the
width `PROOF_BIND_MIN_LANES` names and the Rust admission door enforces. A four-lane custom
artifact does not load. -/
theorem deployed_custom_seam_widthOk : customV3ProofBind.widthOk = true := by
  unfold ProofBind.widthOk customV3ProofBind customProofBindAt
  decide

/-- ⚑ **THE (c) STATEMENT, CORRECTED 2026-08-04.** It used to read "the deployed AIR constrains
NOTHING about the custom binding … for EVERY environment", proved by `trivial`. That is now FALSE:
the seam gates the guard, so an environment with `sel::CUSTOM = 2` is REFUSED. What survives — and
it is the residual that matters — is that at an ACTIVE Custom row the deployed gate constrains
nothing about the commitment or the VK, because this descriptor declares NEITHER pin. The quantifier
is over the two columns, not over the whole environment, and that difference is exactly what the
`Option` made sayable. -/
theorem deployed_custom_proofBind_unpinned : customV3ProofBind.isDeclarative = true := rfl

/-- The seam still bites on the SELECTOR at the deployed columns: a fractional Custom selector is
refused by the shipped gate. So even the declarative case is not the old `True`. -/
theorem deployed_custom_seam_refuses_fractional_selector
    (hash : List ℤ → ℤ) (tf : TraceFamily) (isFirst isLast : Bool) :
    ¬ VmConstraint2.holdsAt hash tf
        { loc := fun i => if i = 8 then 2 else 0, nxt := fun _ => 0, pub := fun _ => 0 }
        isFirst isLast (.proofBind customV3ProofBind) := by
  show ¬ ProofBind.holdsAt
    { loc := fun i => if i = 8 then 2 else 0, nxt := fun _ => 0, pub := fun _ => 0 }
    customV3ProofBind
  unfold ProofBind.holdsAt customV3ProofBind customProofBindAt
  decide

/-! ## §5 — NON-VACUITY at the DEPLOYED columns (both polarities, concrete witnesses).

`demoEngine` (`DescriptorIR2.lean:1932`) is the in-tree toy recursion engine: `Proof := Bool`,
`verify := id`, `piCommit ≡ 123`, `vkOf ≡ 45`. Its ONLY verifying proof exposes commitment `123`,
so `999` is a commitment genuinely beyond its reach — the same separation
`CustomCarrierAttack.forgedRow` uses, moved onto the DEPLOYED column indices. -/

/-- ⚑ **A deployed custom row, ALL SIXTEEN BINDING COLUMNS LAID** (the 2026-08-05 widening): the
eight commitment lanes carry `demoEngine`'s `[123..130]` and the eight program-VK lanes its
`[45..52]`, on the columns `customV3ProofBind` names — low limbs in the `param` block, high limbs on
the teeth. `commitLane3` is the one cell the forgery moves.

⚠ The branch ORDER is deliberate: every literal column is decided before either teeth base is
consulted, so the refutations below reduce without unfolding the emitter's geometry. -/
def deployedRowLoc (commitLane3 : ℤ) : Nat → ℤ := fun i =>
  if i = 8 then 1
  else if 68 ≤ i ∧ i < 72 then (45 + (i - 68) : ℤ)
  else if i = 75 then commitLane3
  else if 72 ≤ i ∧ i < 76 then (123 + (i - 72) : ℤ)
  else if CUSTOM_COMMIT_TEETH_COL ≤ i ∧ i < CUSTOM_COMMIT_TEETH_COL + 4 then
    (127 + (i - CUSTOM_COMMIT_TEETH_COL) : ℤ)
  else if CUSTOM_VK_TEETH_COL ≤ i ∧ i < CUSTOM_VK_TEETH_COL + 4 then
    (49 + (i - CUSTOM_VK_TEETH_COL) : ℤ)
  else 0

/-- The HONEST deployed custom row: Custom selector (col 8) ON, the eight commitment lanes carrying
the vector `demoEngine`'s verifying proof exposes, the eight VK lanes its program fingerprint. -/
def deployedHonestRow : VmRowEnv :=
  { loc := deployedRowLoc 126, nxt := fun _ => 0, pub := fun _ => 0 }

/-- The FORGED deployed custom row: identical, except LANE 3 of the commitment (col 75) carries
`999`. ⚑ Seven of the eight lanes are honest — the row the retired one-felt seam could not even
describe, because it named lane 0 and lane 0 is untouched here. -/
def deployedForgedRow : VmRowEnv :=
  { loc := deployedRowLoc 999, nxt := fun _ => 0, pub := fun _ => 0 }

/-- The two rows differ EXACTLY at lane 3 of the deployed `custom_proof_commitment` (col 75). -/
theorem deployed_rows_differ_at_commit_column :
    deployedForgedRow.loc 75 ≠ deployedHonestRow.loc 75 := by decide

set_option maxRecDepth 40000 in
/-- ⚑ **The forged row is STILL ADMITTED by the deployed AIR — the seam did NOT close Custom.** The
shipped `proof_bind` declares no `bound`, so nothing row-local relates col 72 to anything, and `999`
passes. This is the honest limit of the seam: it closes the descriptors that CAN name their program
and derive their commitment (the light-client folds), and it makes Custom's inability to do either a
COUNTED value (`deployed_custom_proofBind_unpinned`) instead of an unreadable `True`. The binding
for Custom remains the fold's lane-by-lane `connect`. -/
theorem deployed_forged_row_admitted (hash : List ℤ → ℤ) (tf : TraceFamily)
    (isFirst isLast : Bool) :
    VmConstraint2.holdsAt hash tf deployedForgedRow isFirst isLast
      (.proofBind customV3ProofBind) := by
  show ProofBind.holdsAt deployedForgedRow customV3ProofBind
  unfold ProofBind.holdsAt customV3ProofBind customProofBindAt
  decide

set_option maxRecDepth 40000 in
/-- **The forged row is REJECTED by the STAGED in-AIR verifier.** `holdsAtStaged` replaces the one
`proofBind` arm with `ProofBind.boundAt`, which on an ACTIVE row demands a verifying sub-proof
exposing the commitment column. No `demoEngine` proof exposes `999`, so the staged gate bites. The
gap between this and `deployed_forged_row_admitted` IS the un-flipped gate, at the deployed
columns. -/
theorem deployed_forged_row_rejected_by_staged (hash : List ℤ → ℤ) (tf : TraceFamily)
    (isFirst isLast : Bool) :
    ¬ VmConstraint2.holdsAtStaged demoEngine hash tf deployedForgedRow isFirst isLast
        (.proofBind customV3ProofBind) := by
  intro h
  obtain ⟨p, _hv, hc, _hvk⟩ := h.1 (by decide)
  -- Lane 3 alone: the engine's vector carries `126` there, the forged row carries `999`.
  have hlane := congrArg (fun l : List ℤ => l.getD 3 (0 : ℤ)) hc
  simp only [demoEngine, customV3ProofBind, customProofBindAt, deployedForgedRow,
    deployedRowLoc] at hlane
  exact absurd hlane (by decide)

set_option maxRecDepth 40000 in
/-- **The staged gate is not refusing everything (POSITIVE non-vacuity).** The honest row — same
descriptor, same columns, commitment `123` — passes the STAGED gate too, witnessed by the concrete
verifying proof `true`. So the separation above is about the FORGERY, not about the staged gate
being unsatisfiable. -/
theorem deployed_honest_row_accepted_by_staged (hash : List ℤ → ℤ) (tf : TraceFamily)
    (isFirst isLast : Bool) :
    VmConstraint2.holdsAtStaged demoEngine hash tf deployedHonestRow isFirst isLast
      (.proofBind customV3ProofBind) := by
  refine ⟨fun _ => ⟨true, rfl, ?_, ?_⟩, ?_⟩
  · unfold demoEngine customV3ProofBind customProofBindAt deployedHonestRow
    decide
  · unfold demoEngine customV3ProofBind customProofBindAt deployedHonestRow
    decide
  show ProofBind.holdsAt deployedHonestRow customV3ProofBind
  unfold ProofBind.holdsAt customV3ProofBind customProofBindAt
  decide

set_option maxRecDepth 40000 in
/-- ...and the honest row is admitted by the deployed gate as well, so the deployed AIR is strictly
WEAKER: it accepts both rows, the staged AIR accepts only one. -/
theorem deployed_honest_row_admitted (hash : List ℤ → ℤ) (tf : TraceFamily)
    (isFirst isLast : Bool) :
    VmConstraint2.holdsAt hash tf deployedHonestRow isFirst isLast
      (.proofBind customV3ProofBind) := by
  show ProofBind.holdsAt deployedHonestRow customV3ProofBind
  unfold ProofBind.holdsAt customV3ProofBind customProofBindAt
  decide

/-! ## §6 — Axiom hygiene. -/

#assert_axioms customV3ProofBind_is_deployed_columns
#assert_axioms deployed_custom_seam_widthOk
#assert_axioms deployed_custom_proofBind_unpinned
#assert_axioms deployed_custom_seam_refuses_fractional_selector
#assert_axioms deployed_rows_differ_at_commit_column
#assert_axioms deployed_forged_row_admitted
#assert_axioms deployed_forged_row_rejected_by_staged
#assert_axioms deployed_honest_row_accepted_by_staged
#assert_axioms deployed_honest_row_admitted

end Dregg2.Circuit.CustomDeployedBytePin
