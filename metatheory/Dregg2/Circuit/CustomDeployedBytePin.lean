/-- The committed NAME (TSV column 2). -/
def CUSTOM_V3_DEPLOYED_NAME : String :=
  "dregg-effectvm-custom-v1-rot24-v3-staged-gentian-deployed-bare-refuse"

/-- The `proof_bind` op AS COMMITTED, verbatim from the golden. The ONLY recursion-binding op in
the deployed custom descriptor. -/
def CUSTOM_V3_DEPLOYED_PROOF_BIND_JSON : String :=
  "{\"t\":\"proof_bind\",\"guard\":{\"t\":\"var\",\"v\":8},\"commit\":{\"t\":\"var\",\"v\":72},\"vk\":{\"t\":\"var\",\"v\":68}}"

/-! ## §2 — THE BYTE PIN (the (b) → (c) step). -/

-- THE PIN: the Lean object emits the committed bytes, character for character. If the deployed
-- descriptor is ever regenerated with a different shape, THIS goes red at elaboration — no shell
-- script, no full-tree rebuild, no `PROVENANCE.json` round-trip required.
#guard emitVmJson2 deployedCustomV3 == CUSTOM_V3_DEPLOYED_GOLDEN

-- ...and the object IS the registry member the emitter prints for the key (not a look-alike built
-- alongside it). `Option.any` is FALSE on `none`, so a missing key fails the guard.
#guard (v3RegistryCapOpenDep.lookup "customVmDescriptor2R24").any
  (fun d => emitVmJson2 (dropUnforcedPins (hardenLastRow
    (Dregg2.Circuit.Emit.FieldsCanonicity9Emit.fieldsCanonical9Wire d))) == CUSTOM_V3_DEPLOYED_GOLDEN)

#guard deployedCustomV3.name == CUSTOM_V3_DEPLOYED_NAME

/-! ## §3 — what the committed bytes DO and DO NOT contain. -/

-- EXACTLY ONE `proof_bind` op in the shipped bytes (a `splitOn` of a string containing `n`
-- occurrences has `n+1` pieces).
#guard (CUSTOM_V3_DEPLOYED_GOLDEN.splitOn "\"t\":\"proof_bind\"").length == 2

-- ...and it is EXACTLY the deployed-column op: guard = the Custom selector column 8,
-- commit = `custom_proof_commitment` limb 0 (col 72), vk = `custom_program_vk_hash` limb 0 (col 68).
#guard (CUSTOM_V3_DEPLOYED_GOLDEN.splitOn CUSTOM_V3_DEPLOYED_PROOF_BIND_JSON).length == 2

-- The structural counterpart, read off the descriptor value rather than the string.
#guard (proofBindsOf deployedCustomV3).length == 1

/-! ### §3b — the commitment / VK columns are READ BY NOTHING in the deployed bytes.

The eight commitment limbs (`custom_proof_commitment` = cols 72..75 low + `CUSTOM_COMMIT_TEETH_COL`
+0..3 high = 1679..1682) and the eight VK limbs (`custom_program_vk_hash` = cols 68..71 low +
`CUSTOM_VK_TEETH_COL`+0..3 high = 1667..1670) are the columns the
`proof_bind` op names and the sixteen `customPiExposure` pins publish. The question the vacuity
theorem below turns on is whether ANY OTHER constraint in the shipped descriptor reads them — a
gate, a boundary polynomial, a lookup tuple, a window gate. It does not, and that is CHECKED here
over the value the §2 pin ties to the committed bytes, not asserted in prose. -/

/-- The sixteen deployed custom binding columns. The eight HIGH limbs are named by the emitter's own
teeth constants (`CUSTOM_COMMIT_TEETH_COL` / `CUSTOM_VK_TEETH_COL`), so a geometry flag day moves
them here automatically instead of leaving a stale literal that silently checks the wrong columns —
the `#guard` below is what pins the concrete numerals. -/
def customBindingCols : List Nat :=
  [ 68, 69, 70, 71, 72, 73, 74, 75
  , CUSTOM_COMMIT_TEETH_COL, CUSTOM_COMMIT_TEETH_COL + 1
  , CUSTOM_COMMIT_TEETH_COL + 2, CUSTOM_COMMIT_TEETH_COL + 3
  , CUSTOM_VK_TEETH_COL, CUSTOM_VK_TEETH_COL + 1
  , CUSTOM_VK_TEETH_COL + 2, CUSTOM_VK_TEETH_COL + 3 ]

-- The concrete deployed column indices at the FIELDS-CANONICITY geometry (were 1679..1686 at the
-- rc-FOLD geometry, 1663..1670 at the 184-limb geometry, 1619..1626 before it).
#guard customBindingCols
  == [68, 69, 70, 71, 72, 73, 74, 75, 1791, 1792, 1793, 1794, 1795, 1796, 1797, 1798]

/-- Does an `EmittedExpr` read any of the custom binding columns? -/
def readsBindingCol : EmittedExpr → Bool
  | .var c   => customBindingCols.contains c
  | .const _ => false
  | .add a b => readsBindingCol a || readsBindingCol b
  | .mul a b => readsBindingCol a || readsBindingCol b

/-- Does a `WindowExpr` (the two-row carrier) read any of the custom binding columns? -/
def windowReadsBindingCol : WindowExpr → Bool
  | .loc c   => customBindingCols.contains c
  | .nxt c   => customBindingCols.contains c
  | .const _ => false
  | .add a b => windowReadsBindingCol a || windowReadsBindingCol b
  | .mul a b => windowReadsBindingCol a || windowReadsBindingCol b

/-- Does a constraint IMPOSE anything on a custom binding column? The two carriers that legitimately
NAME one are excluded: `.proofBind` (whose deployed denotation is `True` — it imposes nothing, which
is exactly the point) and `.base (.piBinding …)` (which only publishes the column as a public input,
imposing nothing on its VALUE). Everything else counts. -/
def constrainsBindingCol : VmConstraint2 → Bool
  | .base (.gate b)           => readsBindingCol b
  | .base (.boundary _ b)     => readsBindingCol b
  | .base (.transition hi lo) => customBindingCols.contains hi || customBindingCols.contains lo
  | .base (.piBinding ..)     => false
  | .lookup l                 => l.tuple.any readsBindingCol
  | .memOp _                  => true
  | .mapOp _                  => true
  | .umemOp _                 => true
  | .proofBind _              => false
  | .windowGate w             => windowReadsBindingCol w.body

-- **NO constraint in the SHIPPED descriptor imposes anything on the custom binding columns.**
-- (`memOp`/`mapOp`/`umemOp` are counted as constraining — conservatively — and the guard still
-- passes because the deployed custom member carries none of them, per `EffectVmEmitRotationV3`'s
-- own `#guard (memOpsOf customV3).length == 0` / `(mapOpsOf customV3).length == 0`.)
#guard deployedCustomV3.constraints.all (fun c => !(constrainsBindingCol c))

-- Non-vacuity of the checker itself: it is not the constant `false`. A gate reading the
-- commitment column IS detected, and one reading an unrelated column is NOT.
#guard constrainsBindingCol (.base (.gate (.var 72))) == true
#guard constrainsBindingCol (.base (.gate (.var 71))) == true
#guard constrainsBindingCol (.base (.gate (.var 1791))) == true
#guard constrainsBindingCol (.base (.gate (.var 54))) == false
#guard constrainsBindingCol (.windowGate ⟨.nxt 72, true⟩) == true

/-! ## §4 — the DEPLOYED columns, as theorems. -/

/-- **The op's columns are the shipped ones.** `customProofBind` is literally
`(guard := var 8, commit := var 72, vk := var 68)` — the same triple the golden's `proof_bind`
object spells, pinned byte-wise in §3. -/
theorem customProofBind_is_deployed_columns :
    customProofBind = { guard := .var 8, commit := .var 72, vk := .var 68 } := rfl

/-- **THE (c) STATEMENT — the deployed AIR constrains NOTHING about the custom binding.** For the
op that the committed bytes carry, at the columns the committed bytes name, the DEPLOYED per-row
denotation holds for EVERY environment: every hash, every trace family, every row assignment, every
row tag. There is no assignment of the commitment or VK columns this gate can reject. -/
theorem deployed_custom_proofBind_vacuous
    (hash : List ℤ → ℤ) (tf : TraceFamily) (env : VmRowEnv) (isFirst isLast : Bool) :
    VmConstraint2.holdsAt hash tf env isFirst isLast (.proofBind customProofBind) := trivial

/-! ## §5 — NON-VACUITY at the DEPLOYED columns (both polarities, concrete witnesses).

`demoEngine` (`DescriptorIR2.lean:1932`) is the in-tree toy recursion engine: `Proof := Bool`,
`verify := id`, `piCommit ≡ 123`, `vkOf ≡ 45`. Its ONLY verifying proof exposes commitment `123`,
so `999` is a commitment genuinely beyond its reach — the same separation
`CustomCarrierAttack.forgedRow` uses, moved onto the DEPLOYED column indices. -/

/-- The HONEST deployed custom row: Custom selector (col 8) ON, `custom_proof_commitment` limb 0
(col 72) = `123` (the commitment `demoEngine`'s verifying proof exposes), `custom_program_vk_hash`
limb 0 (col 68) = `45`. -/
def deployedHonestRow : VmRowEnv :=
  { loc := fun i => if i = 8 then 1 else if i = 72 then 123 else if i = 68 then 45 else 0
   , nxt := fun _ => 0
   , pub := fun _ => 0 }

/-- The FORGED deployed custom row: identical, except col 72 carries `999` — a commitment NO
verifying `demoEngine` proof exposes. The selector stays ON, so the binding gate is ACTIVE. -/
def deployedForgedRow : VmRowEnv :=
  { loc := fun i => if i = 8 then 1 else if i = 72 then 999 else if i = 68 then 45 else 0
   , nxt := fun _ => 0
   , pub := fun _ => 0 }

/-- The two rows differ EXACTLY at the deployed `custom_proof_commitment` column. -/
theorem deployed_rows_differ_at_commit_column :
    deployedForgedRow.loc 72 ≠ deployedHonestRow.loc 72 := by decide

/-- **The forged row is ADMITTED by the deployed AIR.** The shipped `proof_bind` gate passes it —
this is `deployed_custom_proofBind_vacuous` at a witness that is genuinely unbacked. -/
theorem deployed_forged_row_admitted (hash : List ℤ → ℤ) (tf : TraceFamily)
    (isFirst isLast : Bool) :
    VmConstraint2.holdsAt hash tf deployedForgedRow isFirst isLast (.proofBind customProofBind) :=
  trivial

/-- **The forged row is REJECTED by the STAGED in-AIR verifier.** `holdsAtStaged` replaces the one
`proofBind` arm with `ProofBind.boundAt`, which on an ACTIVE row demands a verifying sub-proof
exposing the commitment column. No `demoEngine` proof exposes `999`, so the staged gate bites. The
gap between this and `deployed_forged_row_admitted` IS the un-flipped gate, at the deployed
columns. -/
theorem deployed_forged_row_rejected_by_staged (hash : List ℤ → ℤ) (tf : TraceFamily)
    (isFirst isLast : Bool) :
    ¬ VmConstraint2.holdsAtStaged demoEngine hash tf deployedForgedRow isFirst isLast
        (.proofBind customProofBind) := by
  intro h
  obtain ⟨p, _hv, hc, _hvk⟩ := h (by decide)
  exact absurd (hc.symm.trans (by decide : (123 : ℤ) = 123)) (by decide)

/-- **The staged gate is not refusing everything (POSITIVE non-vacuity).** The honest row — same
descriptor, same columns, commitment `123` — passes the STAGED gate too, witnessed by the concrete
verifying proof `true`. So the separation above is about the FORGERY, not about the staged gate
being unsatisfiable. -/
theorem deployed_honest_row_accepted_by_staged (hash : List ℤ → ℤ) (tf : TraceFamily)
    (isFirst isLast : Bool) :
    VmConstraint2.holdsAtStaged demoEngine hash tf deployedHonestRow isFirst isLast
      (.proofBind customProofBind) := by
  intro _
  exact ⟨true, rfl, rfl, rfl⟩

/-- ...and the honest row is admitted by the deployed gate as well, so the deployed AIR is strictly
WEAKER: it accepts both rows, the staged AIR accepts only one. -/
theorem deployed_honest_row_admitted (hash : List ℤ → ℤ) (tf : TraceFamily)
    (isFirst isLast : Bool) :
    VmConstraint2.holdsAt hash tf deployedHonestRow isFirst isLast (.proofBind customProofBind) :=
  trivial

/-! ## §6 — Axiom hygiene. -/

#assert_axioms customProofBind_is_deployed_columns
#assert_axioms deployed_custom_proofBind_vacuous
#assert_axioms deployed_rows_differ_at_commit_column
#assert_axioms deployed_forged_row_admitted
#assert_axioms deployed_forged_row_rejected_by_staged
#assert_axioms deployed_honest_row_accepted_by_staged
#assert_axioms deployed_honest_row_admitted

end Dregg2.Circuit.CustomDeployedBytePin
