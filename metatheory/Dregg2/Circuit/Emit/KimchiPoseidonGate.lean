/-! ## §2 — The MDS in the gate bodies IS K3's baked Kimchi matrix.

The Poseidon gate constraint reads `env.mds(row, col)`, which `PolishToken::evaluate` resolves from
`Constants { mds: &Vesta::sponge_params().mds, .. }` — the `fp_kimchi` matrix. `PastaPoseidon`
(K3) baked exactly that matrix as `mdsN`. So this is not a second copy of a constant: it is the
same matrix, and the tie is checked in the kernel. -/

theorem mds_is_k3 : MDS.map (fun r => r.map ZMod.val) = mdsN := by decide

/-! ## §3 — C1: the shipped shape decision on THIS proof's counts. -/

theorem c1_real_accepts : kimchiVerifyDecision 0 5 15 6 15 7 1 true true true = true := by decide

/-! ## §4 — C8 / C5: the shipped aggregation and `ft(ζ)` formulas on the real values. -/

theorem c8_real_matches : cipR VV UU EVZ EVZW = CIP := by decide
theorem c8_discriminates_on_real : cipR VV UU (EVZ.set 0 (0 : Fp)) EVZW ≠ CIP := by decide

theorem denom_form_ok : DENOM = (ZETA - OMEGA ^ (N - 3)) * (ZETA - 1) := by decide
theorem denom_inv_ok : DENOM * DINV = 1 := by decide

theorem c5_ft_real_matches :
    ftEval0R N OMEGA ZETA BETA GAMMA A0 A1 A2 WZ SZ SHIFT ZZ ZZW PZ LCT DINV = FT0 := by decide

/-! ## §5 — C6: the POSEIDON GATE FIRES, and the whole `linConstTerm` is DERIVED.

`poseidon_selector(ζ) ≠ 0` here (the circuit contains a real 55-round Poseidon gadget), so the
15 Poseidon round-equation constraints are LIVE inside `linConstTerm`. `gateLinConst` sums the six
transcribed gate bodies behind their selectors; the four unused customs have identically-zero
selectors. The result reproduces Rust's `PolishToken::evaluate(linearization.constant_term)`. -/

/-- The Poseidon gate FIRES: its selector at ζ is nonzero (contrast `KimchiRealProofGate`, where it
is zero and the Poseidon body is inert). The four unused custom selectors ARE zero. -/
theorem poseidon_gate_fires :
    POSSEL ≠ 0 ∧ GENSEL ≠ 0
    ∧ CADDSEL = 0 ∧ MULSEL = 0 ∧ EMULSEL = 0 ∧ EMULSCSEL = 0 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

/-- The real proof's gate environment: the ζ/ζω evals, the `fp_kimchi` MDS, the endo coefficient,
the witnessed `EndomulScalar` quotients, and the six selectors. -/
def GEV : GateEvals Fp :=
  { alpha := ALPHA, endo := ENDO_R, mds := MDS
  , coeff := COEFFZ, w := WZ, wNext := WZW
  , cA := CA, cB := CB, cC := CC
  , genSel := GENSEL, posSel := POSSEL, caddSel := CADDSEL
  , mulSel := MULSEL, emulSel := EMULSEL, emulScalarSel := EMULSCSEL }

/-- **C6 HEADLINE: the six transcribed gate bodies REPRODUCE Rust's `lin_const_term`** on a proof
that fires the Poseidon gate. The `linConstTerm` carrier is retired: its value is now
`genericGateConstraint + poseidon_selector·(Σᵢ alpha^i·poseidon_constraintᵢ)`. -/
theorem gate_lin_const_matches_lct : gateLinConst GEV = LCT := by decide

/-- The Poseidon term is genuinely CARRYING the value: dropping it (selector → 0) breaks the match,
so this is not the generic gate wearing a Poseidon label. -/
theorem poseidon_term_is_load_bearing : gateLinConst { GEV with posSel := 0 } ≠ LCT := by decide

/-- Non-vacuity: bumping a COEFFICIENT eval — for a Poseidon row the coefficient columns hold the 15
ROUND CONSTANTS — breaks the reproduction. -/
theorem gate_lin_const_discriminates_on_round_constant :
    gateLinConst { GEV with coeff := COEFFZ.set 14 (0 : Fp) } ≠ LCT := by decide

/-- Non-vacuity: bumping a ζω WITNESS eval breaks it. Only the FIFTH round equation reads the next
row (`ROUND_EQUATIONS`'s `4 → (Next, 0)`), and only lanes 0..2 — so `wNext[1]` moving the value is
evidence the Curr/Next split of the transcription is right. -/
theorem gate_lin_const_discriminates_on_next_row :
    gateLinConst { GEV with wNext := WZW.set 1 (0 : Fp) } ≠ LCT := by decide

/-- Non-vacuity: a ζω eval OUTSIDE lanes 0..2 must NOT move the value (nothing reads it) — the
transcription does not accidentally depend on columns the gate never touches. -/
theorem gate_lin_const_ignores_unread_next_row :
    gateLinConst { GEV with wNext := WZW.set 7 (0 : Fp) } = LCT := by decide

/-- Non-vacuity: the alpha fold is real — perturbing `alpha` alone breaks it. -/
theorem gate_lin_const_discriminates_on_alpha :
    gateLinConst { GEV with alpha := ALPHA + 1 } ≠ LCT := by decide

/-- Non-vacuity: the MDS is load-bearing — zeroing one entry of K3's matrix breaks it. -/
theorem gate_lin_const_discriminates_on_mds :
    gateLinConst { GEV with mds := MDS.set 1 [(0 : Fp), 0, 0] } ≠ LCT := by decide

/-- The witnessed `EndomulScalar` quotients are the genuine `11/6, −5/2, 2/3` in `Fp`. -/
theorem endomul_scalar_consts_ok : endomulScalarConstsOk CA CB CC = true := by decide

/-! ## §6 — C3: v and u RE-DERIVED end-to-end; α and ζ from their prechallenges. -/

/-- The phase-2 stream is the 5 scalar absorbs + 43 points × 2 = 91 elements, and it starts with the
fq-sponge digest and the (empty) prev-challenge digest. -/
theorem frstream_shape :
    FRSTREAM.length = 91
    ∧ FRSTREAM.getD 0 0 = DIGEST
    ∧ FRSTREAM.getD 1 0 = PREV_CHAL_DIGEST := by
  refine ⟨?_, ?_, ?_⟩ <;> decide

/-! The empty prev-challenge digest IS K3's `Ref.hash []` — a fresh Fr-sponge squeezed once
(`verifier.rs:288-296` with `prev_challenges = []`). Nothing about it is carried. -/
#guard PREV_CHAL_DIGEST == Ref.hash []

/-! **The two `challenge()` squeezes of the Fr-sponge reproduce the REAL `v_chal` and `u_chal`.**
K3's Poseidon-over-Fp sponge absorbs the 91-element stream; lane 0 and lane 1 of the resulting
permuted state, truncated to 128 bits, are exactly the prover's raw challenges. (`#guard`, the same
kernel-evaluated check K3 uses for its Poseidon gold vectors — the `by decide` proof-term path
overflows on the 255-bit permutation.) -/
#guard frSqueezePair FRSTREAM == (V_CHAL, U_CHAL)
-- Non-vacuity: perturbing ONE absorbed evaluation changes both squeezed challenges.
#guard frSqueezePair (FRSTREAM.set 90 0) != (V_CHAL, U_CHAL)
#guard frSqueezePair (FRSTREAM.set 2 0) != (V_CHAL, U_CHAL)

/-- **The endo map reproduces all four endo-derived challenges** from their raw 128-bit
prechallenges: α, ζ, v, u = `to_field(endo_r)` of α', ζ', v', u'. -/
theorem endo_map_reproduces_challenges :
    endoMap ENDO_R ALPHA_CHAL = ALPHA
    ∧ endoMap ENDO_R ZETA_CHAL = ZETA
    ∧ endoMap ENDO_R V_CHAL = VV
    ∧ endoMap ENDO_R U_CHAL = UU := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> decide

/-- Non-vacuity: flipping the low bit of a prechallenge changes its endo image. -/
theorem endo_map_discriminates :
    endoMap ENDO_R (ZETA_CHAL + 1) ≠ ZETA ∧ endoMap ENDO_R (V_CHAL + 1) ≠ VV := by
  refine ⟨?_, ?_⟩ <;> decide

/-- β and γ are the RAW phase-1 squeezes (`squeeze_order`'s `false` flags): 128-bit, NOT endo
images. α, ζ, v, u are full-width. -/
theorem c3_raw_vs_endo_shape_real :
    (BETA.val < 2 ^ 128 ∧ GAMMA.val < 2 ^ 128)
    ∧ (2 ^ 128 < ZETA.val ∧ 2 ^ 128 < ALPHA.val ∧ 2 ^ 128 < VV.val ∧ 2 ^ 128 < UU.val) := by
  refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩ <;> decide

/-! ## §7 — C9: the shipped deferral on this proof's IPA rounds. -/

theorem c9_real_deferral :
    ipaDeferralOk
        (absorbChallenges (⟨[], ((0 : Fp), (0 : Fp), (0 : Fp))⟩ : IpaDeferred Fp (Fp × Fp × Fp))
          IPACHALS) 16 = true := by decide

/-! ## §8 — THE COMPOSED ACCEPT on the real Poseidon-firing proof.

`kimchiVerifyDecisionGates` = C1 (shape) ∧ C8 (`cip`) ∧ the witnessed inverse ∧ C5 (`ft(ζ)` with its
linearization constant term DERIVED from the six gate bodies) ∧ the `EndomulScalar` quotient check,
all over `ZMod pN`, plus the three crypto carriers. -/

theorem real_gate_decision_accepts :
    kimchiVerifyDecisionGates (R := Fp)
        0 5 15 6 15 7 1 N
        VV UU EVZ EVZW CIP
        OMEGA ZETA BETA GAMMA A0 A1 A2
        SZ SHIFT GEV
        ZZ ZZW PZ DINV FT0
        true true true = true := by decide

/-- Non-vacuity of the gate composition: every tamper that reaches `linConstTerm` — a round
constant, a ζω witness eval, the Poseidon selector, `alpha` — makes `ft(ζ)` disagree and the
decision REJECT; so do a tampered `cip`, a tampered `ft_eval0`, a bogus inverse, and a bad shape. -/
theorem real_gate_decision_discriminates :
    kimchiVerifyDecisionGates (R := Fp) 0 5 15 6 15 7 1 N VV UU EVZ EVZW CIP
        OMEGA ZETA BETA GAMMA A0 A1 A2 SZ SHIFT GEV ZZ ZZW PZ DINV FT0 true true true = true
    ∧ kimchiVerifyDecisionGates (R := Fp) 0 5 15 6 15 7 1 N VV UU EVZ EVZW CIP
        OMEGA ZETA BETA GAMMA A0 A1 A2 SZ SHIFT { GEV with coeff := COEFFZ.set 14 (0 : Fp) }
        ZZ ZZW PZ DINV FT0 true true true = false        -- a Poseidon ROUND CONSTANT
    ∧ kimchiVerifyDecisionGates (R := Fp) 0 5 15 6 15 7 1 N VV UU EVZ EVZW CIP
        OMEGA ZETA BETA GAMMA A0 A1 A2 SZ SHIFT { GEV with wNext := WZW.set 1 (0 : Fp) }
        ZZ ZZW PZ DINV FT0 true true true = false        -- a ζω witness eval (5th round equation)
    ∧ kimchiVerifyDecisionGates (R := Fp) 0 5 15 6 15 7 1 N VV UU EVZ EVZW CIP
        OMEGA ZETA BETA GAMMA A0 A1 A2 SZ SHIFT { GEV with posSel := 0 }
        ZZ ZZW PZ DINV FT0 true true true = false        -- the Poseidon selector
    ∧ kimchiVerifyDecisionGates (R := Fp) 0 5 15 6 15 7 1 N VV UU EVZ EVZW CIP
        OMEGA ZETA BETA GAMMA A0 A1 A2 SZ SHIFT { GEV with cC := CC + 1 }
        ZZ ZZW PZ DINV FT0 true true true = false        -- a bogus EndomulScalar quotient
    ∧ kimchiVerifyDecisionGates (R := Fp) 0 5 15 6 15 7 1 N VV UU EVZ EVZW (CIP + 1)
        OMEGA ZETA BETA GAMMA A0 A1 A2 SZ SHIFT GEV ZZ ZZW PZ DINV FT0 true true true = false
    ∧ kimchiVerifyDecisionGates (R := Fp) 0 5 15 6 15 7 1 N VV UU EVZ EVZW CIP
        OMEGA ZETA BETA GAMMA A0 A1 A2 SZ SHIFT GEV ZZ ZZW PZ (DINV + 1) FT0 true true true = false
    ∧ kimchiVerifyDecisionGates (R := Fp) 0 0 15 6 15 7 1 N VV UU EVZ EVZW CIP
        OMEGA ZETA BETA GAMMA A0 A1 A2 SZ SHIFT GEV ZZ ZZW PZ DINV FT0 true true true = false
    := by refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

/-! ### §8b — the C3 derivation inside the accept.

`challengesOk` re-derives v and u from the transcript and α, ζ from their prechallenges. The Fr
sponge permutation does not fit the `by decide` proof-term path (K3's standing limitation), so the
composed `kimchiVerifyDecisionChallenges` is evaluated by `#guard` — kernel evaluation of the same
`Bool`, the identical check K3 uses for its Poseidon gold vectors. -/

#guard challengesOk ENDO_R FRSTREAM ALPHA_CHAL ZETA_CHAL ALPHA ZETA VV UU BETA_N GAMMA_N == true
#guard challengesOk ENDO_R (FRSTREAM.set 90 0) ALPHA_CHAL ZETA_CHAL ALPHA ZETA VV UU BETA_N GAMMA_N
  == false                                                        -- tampered absorbed evaluation
#guard challengesOk ENDO_R FRSTREAM (ALPHA_CHAL + 1) ZETA_CHAL ALPHA ZETA VV UU BETA_N GAMMA_N
  == false                                                        -- tampered α prechallenge
#guard challengesOk ENDO_R FRSTREAM ALPHA_CHAL ZETA_CHAL ALPHA ZETA (VV + 1) UU BETA_N GAMMA_N
  == false                                                        -- tampered v

/-! The FULL composed accept — C1 ∧ C8 ∧ C5-from-the-six-gate-bodies ∧ the C3 challenge derivation —
on the real Poseidon-firing proof. -/
#guard kimchiVerifyDecisionChallenges (R := Fp)
    0 5 15 6 15 7 1 N VV UU EVZ EVZW CIP
    OMEGA ZETA BETA GAMMA A0 A1 A2 SZ SHIFT GEV
    ZZ ZZW PZ DINV FT0
    ENDO_R FRSTREAM ALPHA_CHAL ZETA_CHAL BETA_N GAMMA_N
    true true true == true
-- and it REJECTS a tampered transcript that C6/C5 alone would have accepted.
#guard kimchiVerifyDecisionChallenges (R := Fp)
    0 5 15 6 15 7 1 N VV UU EVZ EVZW CIP
    OMEGA ZETA BETA GAMMA A0 A1 A2 SZ SHIFT GEV
    ZZ ZZW PZ DINV FT0
    ENDO_R (FRSTREAM.set 5 0) ALPHA_CHAL ZETA_CHAL BETA_N GAMMA_N
    true true true == false

