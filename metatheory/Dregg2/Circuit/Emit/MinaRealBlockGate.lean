/-! ## §1 — C1 on the REAL Wrap shape: the freeze REFUSES a real Mina block.

`shapeOk` is `shapeOkRec` at an index declaring **no** previous challenges. The real devnet
blockchain verifier index declares `prev_challenges = 2` and the real proof carries
2. So the frozen check is not merely conservative on this object — it rejects it. -/

/-- **`real_block_refused_by_freeze`** — K5's frozen `shapeOk` REJECTS the real Mina block. -/
theorem real_block_refused_by_freeze :
    shapeOk PREV PUBLIC COLUMNS (PERMUTS - 1) COLUMNS 7 1 = false := by decide

/-- **`real_block_shape_accepts`** — `shapeOkRec` at the REAL verifier index accepts it. -/
theorem real_block_shape_accepts :
    shapeOkRec IDX_PREV PREV PUBLIC COLUMNS (PERMUTS - 1) COLUMNS 7 1 = true := by decide

/-- **`real_block_shape_discriminates`** — and the accepted shape is load-bearing: every single
tamper of the real counts is refused. -/
theorem real_block_shape_discriminates :
    shapeOkRec IDX_PREV PREV PUBLIC COLUMNS (PERMUTS - 1) COLUMNS 7 1 = true
    ∧ shapeOkRec IDX_PREV 1 PUBLIC COLUMNS (PERMUTS - 1) COLUMNS 7 1 = false  -- prev count
    ∧ shapeOkRec 1 PREV PUBLIC COLUMNS (PERMUTS - 1) COLUMNS 7 1 = false      -- index count
    ∧ shapeOkRec IDX_PREV PREV 0 COLUMNS (PERMUTS - 1) COLUMNS 7 1 = false    -- no public input
    ∧ shapeOkRec IDX_PREV PREV PUBLIC 14 (PERMUTS - 1) COLUMNS 7 1 = false    -- w count
    ∧ shapeOkRec IDX_PREV PREV PUBLIC COLUMNS 5 COLUMNS 7 1 = false           -- σ count
    ∧ shapeOkRec IDX_PREV PREV PUBLIC COLUMNS (PERMUTS - 1) COLUMNS 8 1 = false := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

/-- **`real_block_decision_shape`** — the shipped decision (C1 + the three carriers) on the real
counts: accepted through `kimchiVerifyDecisionRec`, refused through the frozen
`kimchiVerifyDecision`. -/
theorem real_block_decision_shape :
    kimchiVerifyDecisionRec IDX_PREV PREV PUBLIC COLUMNS (PERMUTS - 1) COLUMNS 7 1 true true true
      = true
    ∧ kimchiVerifyDecision PREV PUBLIC COLUMNS (PERMUTS - 1) COLUMNS 7 1 true true true = false := by
  refine ⟨?_, ?_⟩ <;> decide

