namespace Dregg2.Circuit.Emit.ParamComposeGoldenShapes

open Dregg2.Circuit.DescriptorIR2 (EffectVmDescriptor2 emitVmJson2)
open Dregg2.Circuit.Emit.ParamComposeEmit

set_option autoImplicit false

/-- **`pcLeaf`** — shape `n3 p4 l3 k2 i28`: the WORKHORSE test shape: `composition.rs`/`turn_door.rs`/`prove_fold.rs`'s `shape()` and `size.rs`'s "n3 p4 l3 k2 (leaf test)" census row.
346 columns / 53 PIs / 387 constraints / 9 Poseidon2 `node8` sites.
Definitionally an instance of `paramComposeDesc`, so every theorem `ParamComposeRefine` proves at an
arbitrary shape holds here unchanged. -/
def pcLeaf : ComposeShape := ⟨3, 4, 3, 2, 28⟩

#guard pcLeaf.identityBitsSound
#guard (paramComposeDesc pcLeaf).traceWidth == 346
#guard (paramComposeDesc pcLeaf).piCount == 53
#guard (paramComposeDesc pcLeaf).constraints.length == 387
#guard (paramComposeDesc pcLeaf).tables == []
#guard (paramComposeDesc pcLeaf).hashSites.length == 0
#guard (paramComposeDesc pcLeaf).ranges.length == 0
#guard pcLeaf.hashSites == 9
-- the fuel meter equals the wide chip lookups the descriptor actually emits
#guard ((paramComposeDesc pcLeaf).constraints.filter
          (fun c => match c with | .lookup _ => true | _ => false)).length == pcLeaf.hashSites
-- every PI binding is emitted: 5 scalars + 4 roots x 8 lanes
#guard ((paramComposeDesc pcLeaf).constraints.filter
          (fun c => match c with | .base (.piBinding _ _ _) => true | _ => false)).length == 37

