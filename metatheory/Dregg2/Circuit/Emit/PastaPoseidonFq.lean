/-! ## §1 — The parametric Poseidon core (ONE schedule, two fields). -/

/-- A Poseidon instantiation: the field modulus, the 3×3 MDS, the 55×3 round constants. Rate,
capacity, round count and the S-box exponent are `PlonkSpongeConstantsKimchi` and are shared. -/
structure Params where
  modulus : Nat
  mds : List (List Nat)
  rcs : List (List Nat)

/-- `fp_kimchi` over `ZMod pN` — K3's instantiation, re-expressed in the parametric core. -/
def fpParams : Params := ⟨pN, PastaPoseidon.mdsN, PastaPoseidon.rcsN⟩

/-- `fq_kimchi` over `ZMod qN` — the instantiation this file adds. -/
def fqParams : Params := ⟨qN, mdsQ, rcsQ⟩

namespace Core

/-- MDS entry `j,i` (row `j`, column `i`); `0` out of range. -/
def mc (P : Params) (j i : Nat) : Nat := (P.mds.getD j []).getD i 0

/-- The Kimchi S-box `x^α`, `α = 7` (`poseidon.rs:29-42`). -/
def sbox (P : Params) (x : Nat) : Nat := x ^ PastaPoseidon.sboxAlpha % P.modulus

/-- One full round: S-box, MDS matvec, add the round's constants (`permutation.rs:55-70`). -/
def round (P : Params) (rc hs : List Nat) : List Nat :=
  (List.range 3).map (fun j =>
    (mc P j 0 * sbox P (hs.getD 0 0) + mc P j 1 * sbox P (hs.getD 1 0)
      + mc P j 2 * sbox P (hs.getD 2 0) + rc.getD j 0) % P.modulus)

/-- Rounds `r0 .. r0+n−1` folded over the state. -/
def permFrom (P : Params) (r0 n : Nat) (hs : List Nat) : List Nat :=
  (List.range n).foldl (fun st i => round P (P.rcs.getD (r0 + i) []) st) hs

/-- The full permutation: 55 rounds, no initial ARK (`poseidon_block_cipher`). -/
def perm (P : Params) (hs : List Nat) : List Nat := permFrom P 0 PastaPoseidon.rounds hs

/-- Add input `x` into state lane `j`. -/
def absorbAt (P : Params) (st : List Nat) (j x : Nat) : List Nat :=
  st.set j ((st.getD j 0 + x) % P.modulus)

/-- **The absorb loop, the SAME lane-counter transcription K3 was repaired to**
(`poseidon.rs:107-126`): permute only when an element ARRIVES and finds the rate full; a final
full block is left unpermuted and `squeeze` (the `[]` clause) supplies the one closing permutation.
There is exactly one copy of this function in the tree, and both fields run it. -/
def absorbFrom (P : Params) (st : List Nat) (n : Nat) : List Nat → List Nat
  | [] => perm P st
  | x :: rest =>
      if n = PastaPoseidon.rate then absorbFrom P (absorbAt P (perm P st) 0 x) 1 rest
      else absorbFrom P (absorbAt P st n x) (n + 1) rest

/-- Absorb from a fresh `Absorbed(0)` state and close with the squeeze permutation. -/
def absorbAll (P : Params) (st xs : List Nat) : List Nat := absorbFrom P st 0 xs

/-- `Poseidon.hash`: zero state, absorb, one squeeze = lane 0. -/
def hash (P : Params) (xs : List Nat) : Nat := (absorbAll P [0, 0, 0] xs).getD 0 0

end Core

/-! ## §2 — The anti-drift theorems: the parametric core IS K3, at Fp. -/

theorem sbox_at_fp (x : Nat) : Core.sbox fpParams x = PastaPoseidon.Ref.sbox x := rfl

theorem round_at_fp (rc hs : List Nat) :
    Core.round fpParams rc hs = PastaPoseidon.Ref.round rc hs := rfl

theorem perm_at_fp (hs : List Nat) : Core.perm fpParams hs = PastaPoseidon.Ref.perm hs := rfl

theorem absorbAt_at_fp (st : List Nat) (j x : Nat) :
    Core.absorbAt fpParams st j x = PastaPoseidon.Ref.absorbAt st j x := rfl

/-- The absorb SCHEDULE agrees for every input and every lane-counter state — by induction, so a
divergence at any length would be a red, not an unpinned case. -/
theorem absorbFrom_at_fp (xs : List Nat) : ∀ (st : List Nat) (n : Nat),
    Core.absorbFrom fpParams st n xs = PastaPoseidon.Ref.absorbFrom st n xs := by
  induction xs with
  | nil => intro st n; rfl
  | cons x rest ih =>
      intro st n
      simp only [Core.absorbFrom, PastaPoseidon.Ref.absorbFrom, ih, perm_at_fp, absorbAt_at_fp]

/-- **`core_is_Ref_at_Fp`** — the parametric core at `⟨pN, mdsN, rcsN⟩` IS `PastaPoseidon.Ref.hash`,
for EVERY input. So the Fq sponge below is not a second transcription of the schedule: it is this
one schedule at different constants, and K3's ten repaired gold vectors are statements about it. -/
theorem core_is_Ref_at_Fp (xs : List Nat) : Core.hash fpParams xs = PastaPoseidon.Ref.hash xs := by
  simp only [Core.hash, PastaPoseidon.Ref.hash, Core.absorbAll, PastaPoseidon.Ref.absorbAll,
    absorbFrom_at_fp]

/-! ## §3 — The `fq_kimchi` parameter shape, and that it is genuinely the OTHER field. -/

/-- **`fq_kimchi_params_shape`** — 3×3 MDS, 55 rows of 3 round constants, every entry reduced mod
`qN`; and the Fq constants are DIFFERENT elements from the Fp ones. The last clause is the check
that would fire if `static_params()` had been read off the wrong module — the failure mode the K3
audit called out by name (`mdsN[0][0]` is `fp_kimchi`, not `fq_kimchi`). -/
theorem fq_kimchi_params_shape :
    mdsQ.length = 3
    ∧ (mdsQ.all (fun r => r.length == 3)) = true
    ∧ rcsQ.length = PastaPoseidon.rounds
    ∧ (rcsQ.all (fun r => r.length == 3)) = true
    ∧ (mdsQ.all (fun r => r.all (fun x => decide (x < qN)))) = true
    ∧ (rcsQ.all (fun r => r.all (fun x => decide (x < qN)))) = true
    ∧ Core.mc fqParams 0 0 ≠ Core.mc fpParams 0 0
    ∧ (rcsQ.getD 0 []).getD 0 0 ≠ (PastaPoseidon.rcsN.getD 0 []).getD 0 0 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

