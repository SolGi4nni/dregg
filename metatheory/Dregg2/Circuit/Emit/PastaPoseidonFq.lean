/-! ## §5 — The `DefaultFqSponge` state machine (`poseidon/src/sponge.rs:317-410`).

The phase-1 sponge is NOT just `hash`: it interleaves absorbs and squeezes, and the upstream
`SpongeState` machine (`poseidon.rs:100-146`) makes the two orders differ. Transcribed:

* `absorb` from `Absorbed n`: permute first iff `n = rate`, then add into the lane;
  from `Squeezed _`: add into lane 0 and reset to `Absorbed 1` (`poseidon.rs:117-121`).
* `squeeze` from `Absorbed _`: permute, `Squeezed 1`, read lane 0;
  from `Squeezed n`: permute iff `n = rate`, else read lane `n` and advance
  (`poseidon.rs:128-146`). **This is why γ costs no permutation: it is lane 1 of β's state.**
* `absorb_g` absorbs each point as `x` then `y`, and a point at infinity as `(0, 0)`
  (`sponge.rs:335-345`); `absorb_commitment` is `absorb_g` over the commitment's chunks
  (`commitment.rs:503-514`).
* `challenge()` = `squeeze(CHALLENGE_LENGTH_IN_LIMBS = 2)`. Since `HIGH_ENTROPY_LIMBS = 2` as well
  (`sponge.rs:54,56`), the limb cache is drained by exactly one `challenge()`, so each challenge is
  ONE `sponge.squeeze()` truncated to its low 128 bits — no cache state to carry.
* `digest()` = `squeeze_field()` reinterpreted in the scalar field, `0` if it does not fit
  (`sponge.rs:388-397`). -/

/-- The upstream `SpongeState`. -/
inductive Mode where
  | absorbed (n : Nat)
  | squeezed (n : Nat)
  deriving Repr, DecidableEq

/-- A sponge: the 3-lane state plus the lane counter. -/
structure SpongeSt where
  st : List Nat
  mode : Mode
  deriving Repr, DecidableEq

/-- `ArithmeticSponge::new`: zero state, `Absorbed 0`. -/
def newSponge : SpongeSt := ⟨[0, 0, 0], .absorbed 0⟩

/-- One absorbed element (`poseidon.rs:107-126`). -/
def absorb1 (P : Params) (s : SpongeSt) (x : Nat) : SpongeSt :=
  match s.mode with
  | .absorbed n =>
      if n = PastaPoseidon.rate then ⟨Core.absorbAt P (Core.perm P s.st) 0 x, .absorbed 1⟩
      else ⟨Core.absorbAt P s.st n x, .absorbed (n + 1)⟩
  | .squeezed _ => ⟨Core.absorbAt P s.st 0 x, .absorbed 1⟩

/-- Absorb a list, left to right. -/
def absorbMany (P : Params) (s : SpongeSt) (xs : List Nat) : SpongeSt := xs.foldl (absorb1 P) s

/-- One squeeze (`poseidon.rs:128-146`), returning the advanced sponge and the raw lane value. -/
def squeeze1 (P : Params) (s : SpongeSt) : SpongeSt × Nat :=
  match s.mode with
  | .squeezed n =>
      if n = PastaPoseidon.rate then
        let t := Core.perm P s.st
        (⟨t, .squeezed 1⟩, t.getD 0 0)
      else (⟨s.st, .squeezed (n + 1)⟩, s.st.getD n 0)
  | .absorbed _ =>
      let t := Core.perm P s.st
      (⟨t, .squeezed 1⟩, t.getD 0 0)

/-- `DefaultFqSponge::challenge()` — one squeeze, low 128 bits (`sponge.rs:310-314,402-404`). -/
def challenge (P : Params) (s : SpongeSt) : SpongeSt × Nat :=
  let r := squeeze1 P s
  (r.1, r.2 % 2 ^ 128)

/-- `DefaultFqSponge::digest()` — one squeeze, reinterpreted in the scalar field of modulus `m`;
`0` when the base-field value does not fit (`sponge.rs:388-397`, the documented `(q−p)/q` bias). -/
def digestInto (P : Params) (s : SpongeSt) (m : Nat) : Nat :=
  let r := (squeeze1 P s).2
  if r < m then r else 0

