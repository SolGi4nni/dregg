/-
# Dregg2.Circuit.Emit.ShieldedSpendExactMembershipEmit — the EMITTED FSI2 exact-linked membership
descriptor (Fork B pass 6): the real `EffectVmDescriptor2` that pins an 8-lane `piCOMMITTED` to the
exact-linked node fold, with `root_is_pinned8` PROVEN over `Satisfied2`.

**This is Lean-authored AIR, emitted.** It assembles the five proven rungs into a real descriptor Rust
parses and proves through:
  * the per-row FSN2 node sponge — `spongePlan` over the pass-4 `childExpr` (PROVED to realize the
    deployed `exactChildren4`, `ShieldedSpendExactMembershipDescriptor.childExpr_pos0..3`);
  * 8-lane continuity chaining each level's node digest to the next row's `current`;
  * the locked two-carrier PI layout (pass 5): 8× `.piBinding .last` to `piCommitted` (the #15 root
    pin) and 16× `.piBinding .first` to `piWide` (the same-opening full-`u64` carrier);
  * `root_is_pinned8` — a satisfying trace forces the LAST row's node digest (all 8 lanes) ≡ the
    committed-root PI. This is the 8-lane analogue of `shieldedSpendDesc.root_is_pinned`, and the pin
    that lets the route (pass 7) source `piCommitted` from `note_shielded.root8()` and REFUSE a forged
    root.

VK name: `dregg-shielded-spend-exact-fsi2::v1`.

## Scope (honest) — what this descriptor is and is NOT
⚑ **NOT THE ROUTE TARGET (pass B, 2026-08-07).** This is the proven MEMBERSHIP CORE RUNG; the
ROUTABLE object is `ShieldedSpendCompleteEmit.shieldedSpendCompleteDesc`
(`dregg-shielded-spend-complete-fsi2::v1`), whose constraint list extends this one verbatim and
adds the FSI2 leaf sponge, the nullifier derivation and the wide-carrier binding. Routing THIS
descriptor would drop the nullifier and value-binding checks — a regression worse than #15.
It is the MEMBERSHIP FOLD + two-carrier PI exposure. It does NOT include
(the completion rungs, landed in `ShieldedSpendCompleteEmit`):
  * the FSI2 LEAF sponge tying row-0 `current` to the note-commitment preimage (the value/nullifier
    side; `current` is the opened membership leaf, a witness here);
  * the BINDING of the 16 carrier lanes to the real `cap_node8` image (the reserved non-identity
    obligation from pass 5 — `.piBinding` reserves the lanes; the wide-carrier same-opening constraint
    is the follow-on);
  * position-bit RANGE tables and the nullifier PI.
`root_is_pinned8` needs none of those — it is the pin extraction, over the real sponge-built fold.
No `native_decide` (the pin proof is PI-binding extraction; no Poseidon2 evaluation). #15 does NOT
flip here — that is the route pass (7), which wires this descriptor into `apply_shielded_transfer`.

`#assert_axioms` ⊆ {propext, Classical.choice, Quot.sound}.
-/
import Dregg2.Circuit.Emit.ShieldedSpendExactMembershipDescriptor
import Dregg2.Circuit.GateExpr

namespace Dregg2.Circuit.Emit.ShieldedSpendExactMembershipEmit

open Dregg2.Exec.CircuitEmit (EmittedExpr)
open Dregg2.Circuit (Assignment)
open Dregg2.Circuit.DescriptorIR2
  (EffectVmDescriptor2 VmConstraint2 Satisfied2 VmTrace zeroAsg envAt mainTableDef
   poseidon2State16ChipTableDef emitVmJson2)
open Dregg2.Circuit.Emit.EffectVmEmit (VmConstraint)
open Dregg2.Circuit.Emit.FaithfulNoteSpendDescriptorPlan (spongePlan)
open Dregg2.Circuit.Emit.ExactNullifierAafiDescriptorPlan (v3State16Lookup digestColsAt)
open Dregg2.Circuit.Emit.BlindedMembershipEmit (ek emul esub)
open Dregg2.Circuit.Emit.ShieldedSpendExactMembershipDescriptor
  (childExpr piCommitted piWide piNUL PI_COMMITTED_BASE PI_COMMITTED_LANES PI_WIDE_BASE PI_WIDE_LANES
   SPEND_PI_COUNT)

set_option autoImplicit false

/-! ## §1 — column layout (one Merkle level per row). -/

/-- Current digest (8 lanes; row 0 = the opened membership leaf). -/
def MCUR : Nat := 0
/-- Position bits. -/
def MB0 : Nat := 8
def MB1 : Nat := 9
/-- Three sibling digests (3 × 8 lanes). -/
def MSIB : Nat := 10
/-- The 16-lane wide-`u64` value carrier (the pass-5 reserved lanes). -/
def MWIDE : Nat := 34
/-- The FSN2 node sponge state (10 `state16` steps × 16 lanes). -/
def MNODE : Nat := 50
def M_WIDTH : Nat := MNODE + 16 * 10

/-- The 8 node-digest columns (the fold's per-level parent), squeezed from the sponge. -/
def nodeDigestCols : List Nat := digestColsAt MNODE 9

/-! ## §2 — the FSN2 node preimage over the PROVEN `childExpr`, and its sponge. -/

/-- The exact-linked node preimage: `FSN2` + the four children's eight lanes, each child placed by the
pass-4 `childExpr` (proved to realize `exactChildren4`). 33 felts. -/
def nodePreimage : List EmittedExpr :=
  (.const 0x46534e32) ::
    ((List.range 4).flatMap fun slot => (List.range 8).map fun lane =>
      childExpr slot (.var MB0) (.var MB1) (.var (MCUR + lane))
        (.var (MSIB + lane)) (.var (MSIB + 8 + lane)) (.var (MSIB + 16 + lane)))

/-- The per-level node sponge — the deployed `hash_many_8` schedule (`spongePlan`, 10 `state16` steps). -/
def nodeSponge : List VmConstraint2 := (spongePlan MNODE nodePreimage).map v3State16Lookup

/-! ## §3 — the gates, continuity, and the two-carrier pins. -/

/-- Position-bit validity `b·(b−1)`. -/
def posBody (b : Nat) : EmittedExpr := emul (.var b) (esub (.var b) (ek 1))

def bitGates : List VmConstraint2 := [.base (.gate (posBody MB0)), .base (.gate (posBody MB1))]

/-- 8-lane continuity: `next.current = this.node-digest` (the fold chains level to level). -/
def contConstraints : List VmConstraint2 :=
  (List.range 8).map fun lane =>
    .windowGate ⟨Dregg2.Circuit.GateExpr.render Dregg2.Circuit.GateExpr.toWindow
      (Dregg2.Circuit.GateExpr.gThread (MCUR + lane) (nodeDigestCols.getD lane 0)), true⟩

/-- **The #15 root pin**: the last row's node digest (the fold root), lane-wise ≡ the 8-lane
`piCommitted` (executor-sourced from `note_shielded.root8()`). -/
def rootPins : List VmConstraint2 :=
  (List.range 8).map fun lane =>
    .base (.piBinding .last (nodeDigestCols.getD lane 0) (PI_COMMITTED_BASE + lane))

/-- **The same-opening carrier pins**: the 16 wide-carrier columns exposed as `piWide`. -/
def carrierPins : List VmConstraint2 :=
  (List.range 16).map fun i => .base (.piBinding .first (MWIDE + i) (PI_WIDE_BASE + i))

/-! ## §4 — the emitted descriptor. -/

/-- **`shieldedSpendExactDesc`** — the emitted FSI2 exact-linked membership descriptor with the 8-lane
committed-root pin and the 16-lane wide carrier exposed. VK `dregg-shielded-spend-exact-fsi2::v1`. -/
def shieldedSpendExactDesc : EffectVmDescriptor2 :=
  { name        := "dregg-shielded-spend-exact-fsi2::v1"
  , traceWidth  := M_WIDTH
  , piCount     := SPEND_PI_COUNT
  , tables      := [mainTableDef M_WIDTH, poseidon2State16ChipTableDef]
  , constraints := nodeSponge ++ bitGates ++ contConstraints ++ rootPins ++ carrierPins
  , hashSites   := []
  , ranges      := [] }

-- Structural pins (non-vacuous shapes).
#guard nodePreimage.length == 33
#guard nodeSponge.length == 10
#guard nodeDigestCols.length == 8
#guard rootPins.length == 8
#guard carrierPins.length == 16
#guard shieldedSpendExactDesc.traceWidth == 210
#guard shieldedSpendExactDesc.piCount == 25
#guard shieldedSpendExactDesc.name == "dregg-shielded-spend-exact-fsi2::v1"

/-! ## §5 — `root_is_pinned8`: a satisfying trace forces the fold root ≡ the committed-root PI. -/

/-- **⚑ THE #15 KEYSTONE (`root_is_pinned8`).** For every lane, a satisfying trace's LAST-row node
digest ≡ the committed-root PI (mod p). The membership fold's root is pinned to the executor-sourced
committed accumulator root on all eight lanes — so a spend against a self-chosen tree (whose fold root
differs from the committed root) has NO satisfying assignment. This is the pin the route makes bite. -/
theorem root_is_pinned8 (hash : List ℤ → ℤ) (minit : ℤ → ℤ) (mfin : ℤ → ℤ × Nat)
    (maddrs : List ℤ) (t : VmTrace) (hne : t.rows ≠ [])
    (hsat : Satisfied2 hash shieldedSpendExactDesc minit mfin maddrs t) (lane : Fin 8) :
    t.rows.getD (t.rows.length - 1) zeroAsg (nodeDigestCols.getD lane.val 0)
      ≡ t.pub (PI_COMMITTED_BASE + lane.val) [ZMOD 2013265921] := by
  have hlt : t.rows.length - 1 < t.rows.length := by
    cases hr : t.rows with
    | nil => exact absurd hr hne
    | cons _ _ => simp
  have hmem : (VmConstraint2.base
      (.piBinding .last (nodeDigestCols.getD lane.val 0) (PI_COMMITTED_BASE + lane.val)))
      ∈ shieldedSpendExactDesc.constraints := by
    have h1 : (VmConstraint2.base
        (.piBinding .last (nodeDigestCols.getD lane.val 0) (PI_COMMITTED_BASE + lane.val)))
        ∈ rootPins :=
      List.mem_map.mpr ⟨lane.val, List.mem_range.mpr lane.isLt, rfl⟩
    simp only [shieldedSpendExactDesc]
    exact List.mem_append.mpr (Or.inl (List.mem_append.mpr (Or.inr h1)))
  have h := hsat.rowConstraints (t.rows.length - 1) hlt _ hmem
  have hlastb : ((t.rows.length - 1) + 1 == t.rows.length) = true := by
    have : t.rows.length - 1 + 1 = t.rows.length := by omega
    simpa using this
  simp only [Dregg2.Circuit.DescriptorIR2.VmConstraint2.holdsAt,
    Dregg2.Circuit.Emit.EffectVmEmit.VmConstraint.holdsVm, envAt] at h
  exact h hlastb

