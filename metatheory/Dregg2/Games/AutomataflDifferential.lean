import Dregg2.Games.AutomataflRules

open Dregg2.Games.Automatafl
open Dregg2.Games.AutomataflRules

namespace AutomataflDiff

def cfgRow : GameConfig := ⟨.row⟩
def noGoals : GoalAssignment := ⟨[]⟩

def chOf : Particle → Char
  | .vacuum => '.'
  | .attractor => 'A'
  | .repulsor => 'R'
  | .automaton => '@'

def serBoard (size : Nat) (b : Board) : String :=
  let cells : List Char :=
    (List.range size).flatMap (fun y => (List.range size).map (fun x => chOf (b.cellAt ⟨x, y⟩)))
  s!"{size}:{String.mk cells}:{b.automaton.x},{b.automaton.y}"

def serCoords (cs : List Coord) : String :=
  ";".intercalate (cs.map (fun c => s!"{c.x},{c.y}"))

def serNats (ns : List Nat) : String :=
  ";".intercalate (ns.map toString)

/-- Whole move-round outcome for the differential, agent-EXCLUDED resolution board. -/
def serMoves (size : Nat) (b : Board) (seats : List Pid) (ms : List Move) : String :=
  let ro := roundStep cfgRow noGoals (openRound b seats) ms
  let resB := serBoard size (resolveMoves b (ms.filter (fun m => moveLegalB b [] m)))
  s!"AGAIN={ro.isAgain}|MARKS={serCoords ro.marks}|WAIT={serNats ro.waiting}|RES={resB}"

def serAuto (size : Nat) (b : Board) : String :=
  serBoard size (automatonStepCfg cfgRow b)

end AutomataflDiff

open AutomataflDiff

