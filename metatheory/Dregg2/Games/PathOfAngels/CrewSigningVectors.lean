use fips204::ml_dsa_65;
use fips204::traits::{KeyGen, SerDes, Signer, Verifier};
use rand_core::{impls, CryptoRng, Error, RngCore};

/// Deterministic rng for the HEDGED part of signing only (FIPS 204 `rnd`).
/// Not security-relevant for a KAT: the outputs are pinned verbatim afterwards.
struct KatRng(u64);
impl RngCore for KatRng {
    fn next_u32(&mut self) -> u32 {
        self.next_u64() as u32
    }
    fn next_u64(&mut self) -> u64 {
        // splitmix64
        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
        let mut z = self.0;
        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
        z ^ (z >> 31)
    }
    fn fill_bytes(&mut self, dest: &mut [u8]) {
        impls::fill_bytes_via_next(self, dest)
    }
    fn try_fill_bytes(&mut self, dest: &mut [u8]) -> Result<(), Error> {
        self.fill_bytes(dest);
        Ok(())
    }
}
impl CryptoRng for KatRng {}

/// xi seeds for `keygen_from_seed` — 32 bytes each, pinned so keygen is reproducible.
const SEAT0_XI: &[u8; 32] = b"POA-CREW-KAT-SEAT0-XI-SEED-0001!";
const WRONG_XI: &[u8; 32] = b"POA-CREW-KAT-WRONG-XI-SEED-0002!";

/// Signature-level domain separation, must byte-match the Lean abbrevs.
const CTX_SEAT: &[u8] = b"POA-CREW-SEAT-MLDSA65-1";
const CTX_HANDOFF: &[u8] = b"POA-CREW-HANDOFF-MLDSA65-1";

fn lean_literal(name: &str, bytes: &[u8]) {
    let body: Vec<String> = bytes.iter().map(|b| b.to_string()).collect();
    println!("def {} : Array UInt8 := #[{}]", name, body.join(", "));
    println!("-- {} length: {}", name, bytes.len());
}

fn main() {
    let args: Vec<String> = std::env::args().collect();
    let (pk0, sk0) = ml_dsa_65::KG::keygen_from_seed(SEAT0_XI);
    let (pk_wrong, sk_wrong) = ml_dsa_65::KG::keygen_from_seed(WRONG_XI);

    match args.get(1).map(String::as_str) {
        Some("keys") => {
            lean_literal("katSeat0PublicKey", &pk0.clone().into_bytes());
            lean_literal("katWrongPublicKey", &pk_wrong.clone().into_bytes());
        }
        Some("sign") => {
            let seat_msg = std::fs::read(args.get(2).expect("seat message path")).expect("read seat msg");
            let handoff_msg =
                std::fs::read(args.get(3).expect("handoff message path")).expect("read handoff msg");
            eprintln!("seat message: {} bytes; handoff message: {} bytes", seat_msg.len(), handoff_msg.len());

            let mut rng = KatRng(0x504f_4145_0000_0001);
            let seat_sig = sk0
                .try_sign_with_rng(&mut rng, &seat_msg, CTX_SEAT)
                .expect("seat sign");
            let handoff_sig = sk0
                .try_sign_with_rng(&mut rng, &handoff_msg, CTX_HANDOFF)
                .expect("handoff sign");
            let wrong_key_sig = sk_wrong
                .try_sign_with_rng(&mut rng, &handoff_msg, CTX_HANDOFF)
                .expect("wrong-key sign");

            // Self-check with the CRATE's verify: honest accepts, cross pairings refuse.
            assert!(pk0.verify(&seat_msg, &seat_sig, CTX_SEAT), "crate accepts seat sig");
            assert!(pk0.verify(&handoff_msg, &handoff_sig, CTX_HANDOFF), "crate accepts handoff sig");
            assert!(
                pk_wrong.verify(&handoff_msg, &wrong_key_sig, CTX_HANDOFF),
                "crate accepts wrong-key sig under its own pk"
            );
            assert!(
                !pk0.verify(&handoff_msg, &wrong_key_sig, CTX_HANDOFF),
                "crate refuses wrong-key sig under seat0 pk"
            );
            assert!(
                !pk0.verify(&handoff_msg, &handoff_sig, CTX_SEAT),
                "crate refuses handoff sig under seat ctx"
            );
            assert!(
                !pk0.verify(&seat_msg, &handoff_sig, CTX_HANDOFF),
                "crate refuses handoff sig over seat msg"
            );
            eprintln!("crate self-checks passed");

            lean_literal("katSeatSignature", &seat_sig);
            lean_literal("katHandoffSignature", &handoff_sig);
            lean_literal("katWrongKeyHandoffSignature", &wrong_key_sig);
            lean_literal("katSeatMessagePinned", &seat_msg);
            lean_literal("katHandoffMessagePinned", &handoff_msg);
        }
        _ => {
            eprintln!("usage: crew-kat-gen keys | crew-kat-gen sign <seat.bin> <handoff.bin>");
            std::process::exit(2);
        }
    }
}
