#!/usr/bin/env sh
# Pre-push: (1) secret-scan the to-be-pushed commits and BLOCK if a real secret is found,
# (2) BLOCK on dead documentation references and on a tip that does not resolve from a clean
# checkout of itself, then (3) preserve git-lfs's pre-push behavior (this repo uses LFS; the
# default hook lived here).
#
# Today's incident was a routine `git push origin main` carrying a secret public. This hook is the
# backstop on the push path. Installed by scripts/install-git-hooks.sh (symlinked into .git/hooks,
# replacing the stock git-lfs pre-push — which we re-invoke below so LFS keeps working).
#
# ── WHY (2) BLOCKS, AND WHY HERE ──────────────────────────────────────────────────────────────
# `check-doc-refs.sh` was driven 330 -> 0 on 2026-06-12 and was back to 34 DEAD by 2026-07-27,
# every one of them landed in that window. It reported and did not block, and that IS the
# mechanism: the only thing that ever looked at it was `.github/workflows/docs-refs.yml`, which
# fires on `pull_request` — and work lands on `main` here directly, at a median 92 seconds
# between commits, against a CI verdict that takes ~87 minutes and of whose last 60 runs ZERO
# succeeded. A verdict nobody receives is not a gate. That workflow also filters on
# `paths: docs/**`, which cannot see the dominant cause: a reference dies when the CODE it points
# at is moved or deleted, in a commit that touches no markdown at all.
#
# `main` is not branch-protected, so the remote cannot refuse a push. The push hook is the last
# point at which anything can. pre-COMMIT is the wrong place — these scans are ~22s and ~12s and
# commits land every 92 seconds — so they run once per push instead.
#
# ⚠ THE TWO CHECKS DELIBERATELY LOOK AT DIFFERENT THINGS, because they assert different things.
#   * workspace-closure runs against a CLEAN EXTRACT of the tip: its whole question is "does this
#     commit resolve for someone who only has this commit", which the working tree cannot answer.
#   * doc-refs runs against the WORKING TREE, the same target `scripts/local-gates.sh` and a human
#     use. Measured 2026-07-28: running it against an extract instead makes it STRICTER than its
#     own contract — `docs/audit/TRIAGE-2026-07-16.md` cites
#     `chain/broadcast/DeploySettlement.s.sol/84532/run-latest.json` as evidence of a real
#     Base-Sepolia broadcast, `chain/broadcast/` is gitignored foundry output, and the reference is
#     therefore alive in every checkout and dead in every archive. A gate must assert what it means.
#
# A push of N commits certifies the TIP; intermediate commits can still be broken bisect points.
# Audit them with `python3 scripts/check-workspace-closure.py --commits N`.
#
# THE ESCAPE IS DECLARED AND LOUD, never silent — same shape as pre-commit's
# DREGG_ALLOW_LIST_SHRINK:
#     DREGG_ALLOW_DEAD_DOC_REFS=1 git push …
#     DREGG_ALLOW_UNRESOLVED_TIP=1 git push …
set -u
repo_root="$(git rev-parse --show-toplevel)"

# git feeds the ref updates on stdin; we need them twice (scan + git-lfs), so buffer once.
stdin_data="$(cat)"

# (1) secret scan over each pushed range — blocks the push on a real secret.
if [ -x "$repo_root/scripts/git-hooks/secret-scan.sh" ]; then
  printf '%s\n' "$stdin_data" | "$repo_root/scripts/git-hooks/secret-scan.sh" push-stdin || exit 1
fi

# (2) doc-reference integrity + manifest self-containment, on the TIP being pushed.
#
# The tip is read out of the ref updates git put on stdin: "<localref> <localsha> <remoteref>
# <remotesha>". An all-zero localsha is a DELETE, which pushes no content — skipped.
push_tip=''
while read -r _lref lsha _rref _rsha; do
  [ -n "${lsha:-}" ] || continue
  # ⚑ A NOTES REF IS NOT A CODE TIP. `refs/notes/*` carries annotations — no manifests,
  # no source — so "does this resolve from a clean checkout of itself?" has no meaning
  # for it. The closure check ran anyway and blocked `git push origin refs/notes/commits`,
  # which is HOW A CORRECTION GETS RECORDED in this repo — `git notes` is what this tree
  # uses to annotate a commit whose subject turned out wrong, and it cannot rewrite
  # history to fix one. A gate that blocks the mechanism for recording corrections is
  # worse than no gate. Measured 2026-07-28 while annotating a commit that had swept
  # another lane's file into a subject about something else.
  case "$_lref" in refs/notes/*) continue ;; esac
  # ⚑ A NOTES REF IS NOT A CODE TIP. `refs/notes/*` carries annotations — no manifests,
  # no source — so "does this resolve from a clean checkout of itself?" has no meaning
  # for it. The closure check ran anyway and blocked `git push origin refs/notes/commits`,
  # which is HOW A CORRECTION GETS RECORDED in this repo. A gate that blocks the
  # mechanism for recording corrections is worse than no gate. Measured 2026-07-28
  # while annotating a commit that had swept another lane's file.
  case "$_lref" in refs/notes/*) continue ;; esac
  case "$lsha" in *[!0]*) push_tip="$lsha" ;; esac
done <<PUSH_REFS
$stdin_data
PUSH_REFS

if [ -n "$push_tip" ]; then
  if [ -f "$repo_root/scripts/check-doc-refs.sh" ]; then
    doc_out="$(bash "$repo_root/scripts/check-doc-refs.sh" 2>&1)"; doc_rc=$?
    if [ "$doc_rc" -ne 0 ]; then
      printf '%s\n' "$doc_out" | grep -E '^(DEAD|check-doc-refs:)' >&2
      if [ -n "${DREGG_ALLOW_DEAD_DOC_REFS:-}" ]; then
        printf '\npre-push: ALLOWED — dead doc references, permitted by DREGG_ALLOW_DEAD_DOC_REFS=%s\n' \
          "$DREGG_ALLOW_DEAD_DOC_REFS" >&2
        printf '  (declared intent, recorded here and in your transcript)\n' >&2
      else
        printf '\npre-push: BLOCKED — this tree carries dead documentation references.\n' >&2
        printf '  Reproduce:  bash scripts/check-doc-refs.sh\n' >&2
        printf '  A reference dies when the CODE moves, so this fires on commits that touch no markdown.\n' >&2
        printf '  Repair the reference (a :NNN must still be the line the prose names), or declare it:\n' >&2
        printf '    DREGG_ALLOW_DEAD_DOC_REFS=1 git push …\n' >&2
        exit 1
      fi
    fi
  fi

  if [ -f "$repo_root/scripts/check-workspace-closure.py" ]; then
    ws_out="$(python3 "$repo_root/scripts/check-workspace-closure.py" --rev "$push_tip" 2>&1)"; ws_rc=$?
    if [ "$ws_rc" -ne 0 ]; then
      printf '%s\n' "$ws_out" >&2
      if [ -n "${DREGG_ALLOW_UNRESOLVED_TIP:-}" ]; then
        printf '\npre-push: ALLOWED — tip does not resolve, permitted by DREGG_ALLOW_UNRESOLVED_TIP=%s\n' \
          "$DREGG_ALLOW_UNRESOLVED_TIP" >&2
      else
        printf '\npre-push: BLOCKED — %s does not resolve from a clean checkout of ITSELF.\n' "$push_tip" >&2
        printf '  Usually a partial `git add` in this shared tree: your manifests name a sibling\n' >&2
        printf '  lane%s still-uncommitted work. It is green for you and a broken bisect point for\n' "'" >&2
        printf '  everyone. Commit what is missing, or declare it: DREGG_ALLOW_UNRESOLVED_TIP=1 git push …\n' >&2
        exit 1
      fi
    fi
  fi
fi

# (3) preserve git-lfs's pre-push (byte-for-byte the stock hook's behavior).
if command -v git-lfs >/dev/null 2>&1; then
  printf '%s\n' "$stdin_data" | git lfs pre-push "$@"
else
  printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory."
  exit 2
fi
