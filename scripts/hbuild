#!/usr/bin/env bash
# hbuild — run the existing isolated-lane pbuild protocol on hbox.
#
# hbox is the primary GPU/RAM host for fhEgg and prover workloads, and an
# available desktop-class CPU host for PartyMPC and verified-PQ runtime gates.
# `pbuild` remains the one implementation of rsync, lane warmth checks, and
# toolchain setup; this wrapper only selects the host, so commands and cache
# semantics stay identical:
#
#   scripts/hbuild games-deploy cargo nextest run --release -p <crate> ...
#
# Use a warm lane (`games-deploy`, `gpu-e2e`, or `privnode` today). `pbuild`
# refuses a cold lane unless `--force-cold` is explicit. Gitignored remote
# `.lake`, target caches, and a native Lean seed are preserved by rsync. That
# makes verified PQ gates executable, but does not attest them or waive their
# `DREGG_REQUIRE_LEAN` / verified-core checks; the invoked test remains the
# authority for whether its exact archive is accepted.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PBUILD_HOST="${HBUILD_HOST:-hbox}"
# The lease must live on the box the build runs on, or it warns nobody.
# `lane-lease.sh` defaults to `HOST="${LANE_LEASE_HOST:-persvati}"`, and the lease FILE lives ON THE
# BOX — so a lane that claimed `eth-lc-air` while building here filed its claim on persvati, where no
# hbox reader ever looks. Measured consequence on 2026-07-28: lanes were repeatedly taken mid-build by
# other agents, each theft surfacing as a wave of missing-`.olean` cascades (one root build logged ~190)
# that reads exactly like a code failure and is not one. The lane that finally diagnosed it put it
# plainly: "my lease was never visible to hbox readers; that is a real gap worth fixing."
export LANE_LEASE_HOST="${LANE_LEASE_HOST:-$PBUILD_HOST}"
export PBUILD_REMOTE_WRAPPER="${HBUILD_REMOTE_WRAPPER:-swarm-build}"
export PBUILD_MIN_FREE_GIB="${HBUILD_MIN_FREE_GIB:-20}"
if [ -n "${HBUILD_WARM_DEPS:-}" ] && [ -z "${PBUILD_WARM_DEPS:-}" ]; then
  export PBUILD_WARM_DEPS="$HBUILD_WARM_DEPS"
fi
exec "$ROOT/scripts/pbuild" "$@"
