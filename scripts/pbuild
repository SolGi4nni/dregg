#!/usr/bin/env bash
# pbuild — offload a CARGO build/test to persvati (24-core build host), in an
# ISOLATED per-lane dir so concurrent lanes don't fight one target lock.
#
#   Usage:  scripts/pbuild [--force-cold] <lane-name> <command...>
#   e.g.    scripts/pbuild swap cargo build -p dregg-turn
#           scripts/pbuild crypto cargo test -p dregg-lightclient
#
# It rsyncs the LOCAL working tree (carrying uncommitted WIP) — gitignore-filtered
# so target/ and .lake/ are NOT synced (persvati keeps its own warm build caches
# per lane). Then runs the command there with the toolchain env sourced.
#
# NOTE: use this for CARGO (Rust) builds — the CPU-heavy crypto/circuit/lightclient
# ones. Keep LEAN (lake) builds LOCAL (the local .lake/mathlib cache is warm;
# a fresh persvati lane-dir would re-download mathlib = catastrophic).
#
# COLD-LANE GUARD: a lane dir with no warm build cache (no populated cargo
# target/ and no warm .lake/mathlib) compiles the WHOLE dependency graph from
# scratch — the load-95+ box-spike this guard exists to prevent. By default an
# agent that invents a fresh lane name is REFUSED and shown the warm lanes to
# reuse; pass --force-cold to deliberately seed a new lane.
set -euo pipefail

# The remote build box. Overridable so pbuild is not hardwired to the maintainer's host (#39):
# a fresh clone / other contributor can point it at their own box, or (below) is taught to build
# locally when no host is reachable.
HOST="${PBUILD_HOST:-persvati}"
# Warmth threshold: a lane counts as warm if its cargo target/{release,debug}/deps
# holds at least this many built artifacts (a fresh lane has 0). Override with
# PBUILD_WARM_DEPS. A warm .lake/packages/mathlib also counts as warm.
WARM_DEPS="${PBUILD_WARM_DEPS:-100}"
# Optional host policy. Persvati keeps the historical defaults (no wrapper and
# no extra disk floor). Hosts that are also production co-tenants can require a
# cgroup wrapper and a free-space reserve without duplicating pbuild's protocol.
REMOTE_WRAPPER="${PBUILD_REMOTE_WRAPPER:-}"
MIN_FREE_GIB="${PBUILD_MIN_FREE_GIB:-0}"

case "$MIN_FREE_GIB" in
  ''|*[!0-9]*)
    echo "pbuild: PBUILD_MIN_FREE_GIB must be a non-negative integer" >&2
    exit 2
    ;;
esac

FORCE_COLD=0
if [ "${1:-}" = "--force-cold" ]; then FORCE_COLD=1; shift; fi
LANE="${1:?usage: pbuild [--force-cold] <lane> <command...>}"; shift
[ "$#" -ge 1 ] || { echo "pbuild: no command given" >&2; exit 2; }

# Repo root, derived from THIS script's own location (scripts/pbuild) — NOT a hardcoded maintainer
# path (#39). The old absolute `SRC` silently rsync'd the wrong tree from any other clone.
SRC="$(cd "$(dirname "$0")/.." && pwd)/"
REMOTE="dregg-build/${LANE}"

# pbuild is a maintainer OFFLOAD to a warm remote build box; a fresh clone / non-maintainer machine
# has no such host. Fail with a TEACHING message instead of a raw `ssh: could not resolve` (#39).
# (The `if !` context is exempt from `set -e`, so an unreachable host does not abort here.)
if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" true 2>/dev/null; then
  cat >&2 <<MSG
pbuild: cannot reach remote build host '$HOST'.
  pbuild offloads builds to a warm remote box (maintainer setup). From a fresh clone you can:
    • build locally:                 $*
    • point pbuild at your own box:  PBUILD_HOST=your-host scripts/pbuild $LANE <cmd>
MSG
  exit 2
fi

# A co-tenant wrapper is an authority boundary, not a best-effort preference:
# fail before mkdir/rsync if it is absent. Quote the command name so an unusual
# contributor-owned path remains one remote shell word.
if [ -n "$REMOTE_WRAPPER" ]; then
  printf -v REMOTE_WRAPPER_Q '%q' "$REMOTE_WRAPPER"
  # shellcheck disable=SC2029 # REMOTE_WRAPPER_Q is deliberately client-quoted for the remote shell.
  if ! ssh "$HOST" "command -v ${REMOTE_WRAPPER_Q} >/dev/null 2>&1"; then
    echo "pbuild: REFUSING — required remote wrapper '${REMOTE_WRAPPER}' is absent on ${HOST}." >&2
    exit 4
  fi
fi

# Check the remote home filesystem before any mutation. A Cargo link can grow a
# warm lane by several GiB; hosts with live services need space left for those
# services even when the build itself is memory-contained.
if [ "$MIN_FREE_GIB" -gt 0 ]; then
  FREE_KIB="$(ssh "$HOST" "df -Pk \"\$HOME\" | awk 'NR == 2 { print \$4 }'")"
  case "$FREE_KIB" in
    ''|*[!0-9]*)
      echo "pbuild: REFUSING — could not measure free space on ${HOST}." >&2
      exit 4
      ;;
  esac
  MIN_FREE_KIB=$((MIN_FREE_GIB * 1024 * 1024))
  if [ "$FREE_KIB" -lt "$MIN_FREE_KIB" ]; then
    FREE_GIB=$((FREE_KIB / 1024 / 1024))
    cat >&2 <<MSG
pbuild: REFUSING — ${HOST} has only ~${FREE_GIB} GiB free; host policy requires
        ${MIN_FREE_GIB} GiB (PBUILD_MIN_FREE_GIB). No mkdir or rsync was attempted.
MSG
    exit 4
  fi
fi

# ---- cold-lane guard ------------------------------------------------------
# Probe the remote (BEFORE any mkdir/rsync — a brand-new lane dir does not yet
# exist, so it reads as cold) for this lane's warmth + the list of warm lanes.
# shellcheck disable=SC2087 # WARM_DEPS/LANE are intentionally interpolated locally into the probe.
PROBE="$(ssh "$HOST" "bash -s" <<PROBE_EOF
set -e
warm_of() {
  d="\$1"
  [ -d "\${d}/.lake/packages/mathlib" ] && { echo warm; return; }
  n=\$(ls "\${d}/target/release/deps" "\${d}/target/debug/deps" 2>/dev/null | wc -l | tr -d ' ')
  if [ "\${n:-0}" -ge ${WARM_DEPS} ]; then echo warm; else echo cold; fi
}
echo "STATUS:\$(warm_of "dregg-build/${LANE}")"
echo "WARM_BEGIN"
for x in dregg-build/*/; do
  [ -d "\$x" ] || continue
  xd="\${x%/}"
  [ "\$(warm_of "\$xd")" = warm ] && echo "\${xd#dregg-build/}"
done
echo "WARM_END"
PROBE_EOF
)"

STATUS="$(printf '%s\n' "$PROBE" | sed -n 's/^STATUS://p')"
WARM_LANES="$(printf '%s\n' "$PROBE" | sed -n '/^WARM_BEGIN$/,/^WARM_END$/p' | sed '/^WARM_BEGIN$/d;/^WARM_END$/d')"

if [ "$STATUS" != "warm" ]; then
  if [ "$FORCE_COLD" -eq 1 ]; then
    echo "pbuild: WARNING — lane '${LANE}' is COLD; --force-cold given, seeding a" >&2
    echo "        fresh build. The Lean half is cheap (mathlib oleans are FETCHED below," >&2
    echo "        not compiled); the Rust dep graph still compiles from scratch." >&2
    SEED_LEAN_CACHE=1
  else
    {
      echo "pbuild: REFUSING — lane '${LANE}' is COLD on ${HOST} (no warm cargo target/,"
      echo "        no warm .lake/mathlib). Running it would rebuild EVERYTHING from"
      echo "        scratch (~20min+, box load 95+ — the exact spike this guard prevents)."
      echo ""
      if [ -n "$WARM_LANES" ]; then
        echo "        Reuse a WARM lane instead (these already have a build cache):"
        # shellcheck disable=SC2086 # Deliberate newline/word split: one formatted lane per row.
        printf '          %s\n' $WARM_LANES
      else
        echo "        (no warm lanes found on ${HOST} to reuse)"
      fi
      echo ""
      echo "        Or pass --force-cold to deliberately seed lane '${LANE}':"
      echo "          scripts/pbuild --force-cold ${LANE} $*"
    } >&2
    exit 3
  fi
fi

# Sync working tree (WIP included) -> isolated lane dir. gitignore filter keeps
# target/.lake out so persvati's per-lane build cache survives across invocations.
#
# ⚠ THE LEAN ARCHIVE IS AN EXPLICIT EXCEPTION TO THE GITIGNORE FILTER (2026-07-25).
# `dregg-lean-ffi/.gitignore` says `*.a`, which catches `libdregg_lean.a` (~106 MB) — so
# for as long as this script has existed, the verified Lean archive NEVER REACHED the
# remote lane. The failure mode is silent and expensive: every executor-touching test
# binary there dies with a bare `SIGABRT` and NO Rust panic message, because
# `Custodian::generate` -> ML-DSA-65 keygen aborts without the verified cores. Three
# separate lanes hit it in one night; one lost hours before proving it was not their code
# (it reproduced only where the archive was absent, and vanished on two boxes once
# present). `dregg-app-framework`'s own 164 tests abort identically, so a lane cannot even
# use a neighbouring crate as a control.
#
# The `+` rule is listed BEFORE the merge filter because rsync takes the first matching
# rule. If the archive is absent locally the rule is simply a no-op, and the preflight
# below says so out loud rather than letting the remote discover it as a signal 6.
LEAN_ARCHIVE="dregg-lean-ffi/libdregg_lean.a"

# ⚠ THE ARCHIVE IS AN ARCH-SPECIFIC BUILD PRODUCT — never ship it cross-platform.
# The first version of this fix rsync'd it unconditionally and immediately broke a
# macOS->Linux lane: the members are `Mach-O 64-bit object arm64`, so `rust-lld` on
# x86_64 reports "archive member 'Aesop.o' is neither ET_REL nor LLVM bitcode" and
# then `undefined symbol: dregg_exec_full_forest_auth`. Loud, at least — a link
# error naming the symbol beats the bare SIGABRT it replaced — but still wrong.
# Ship it only when host and remote agree on OS and machine; otherwise the remote
# must build its own, which `lake exe cache get` below now makes affordable.
LOCAL_PLATFORM="$(uname -s)-$(uname -m)"
REMOTE_PLATFORM="$(ssh "$HOST" 'echo "$(uname -s)-$(uname -m)"' 2>/dev/null || echo unknown)"
ARCHIVE_FILTER=()
if [ "$LOCAL_PLATFORM" = "$REMOTE_PLATFORM" ]; then
  ARCHIVE_FILTER=(--filter="+ /${LEAN_ARCHIVE}")
else
  echo "pbuild: host is ${LOCAL_PLATFORM}, ${HOST} is ${REMOTE_PLATFORM} — NOT shipping" >&2
  echo "        ${LEAN_ARCHIVE} (it is arch-specific; a cross-shipped archive links as" >&2
  echo "        'neither ET_REL nor LLVM bitcode'). The lane must build its own." >&2
fi

if [ ! -f "${SRC%/}/${LEAN_ARCHIVE}" ]; then
  printf '%s\n' \
    "pbuild: WARNING — ${LEAN_ARCHIVE} is absent locally, so the lane will not receive it." \
    "        Executor-touching tests on ${HOST} will abort with a bare SIGABRT and no panic" \
    "        message (ML-DSA keygen without the verified cores). That is an ENVIRONMENT" \
    "        fault, not your code. Seed it with ./scripts/bootstrap.sh, or set" \
    "        DREGG_ALLOW_UNAUDITED_PQ=1 to run marshal-only knowing what you traded away." >&2
fi

# shellcheck disable=SC2029 # REMOTE is a locally-owned, validated lane path.
ssh "$HOST" "mkdir -p '${REMOTE}'"
rsync -az --delete \
  "${ARCHIVE_FILTER[@]}" \
  --filter=':- .gitignore' --exclude='.git/' \
  "$SRC" "${HOST}:${REMOTE}/"

# ---- FETCH mathlib, never compile it (2026-07-25) --------------------------
# THE measurement that unlocks parallel remote lanes:
#
#   compiling the mathlib closure : ~13 HOURS  (measured: 3,337/8,098 objects at ~6/min)
#   `lake exe cache get`          :  40 SECONDS (measured: 8,463 files, 2,680 -> 8,105 oleans)
#
# Mathlib ships a prebuilt olean cache and NOTHING in this repo has ever called it. That single
# omission is why a cold lane was catastrophic, why the guard above had to refuse cold lanes at
# all, and therefore why work piled onto one laptop's shared target lock while two 24-core boxes
# sat idle. A cold lane's Lean half is now a 40-second download; only the Rust dep graph still
# compiles, and that parallelises across lanes because each lane owns its own target dir.
#
# Idempotent and additive — `cache get` only fills in missing oleans, so running it on a warm
# lane is safe and repairs a partially-populated one. Failure is NON-FATAL: a lane with no
# network still builds, just the slow way, and says so.
if [ "${SEED_LEAN_CACHE:-0}" -eq 1 ] || [ "${PBUILD_ALWAYS_CACHE_GET:-0}" -eq 1 ]; then
  echo "pbuild: fetching the mathlib olean cache into lane '${LANE}' (seconds, not hours) …" >&2
  # shellcheck disable=SC2029 # REMOTE is a locally-owned, validated lane path.
  ssh "$HOST" "set -e; source ~/.elan/env 2>/dev/null || true; \
    export PATH=\"\$HOME/.elan/bin:\$PATH\"; \
    cd '${REMOTE}/metatheory' 2>/dev/null || exit 0; \
    lake exe cache get 2>&1 | tail -2" \
    || echo "pbuild: WARNING — mathlib cache fetch failed; the lane will COMPILE mathlib \
instead (hours). Check network/elan on ${HOST} before blaming the build." >&2
fi

# ---- forward the DREGG_* build knobs to the remote shell ------------------
# `ssh` does not carry the caller's environment, so `DREGG_FOO=1 scripts/pbuild …`
# silently had NO EFFECT on the remote build — the variable was consumed by the
# local pbuild process and never crossed. That is a quiet, expensive kind of wrong:
# a lane sets `DREGG_ALLOW_UNAUDITED_PQ=1`, sees the same SIGABRT it was trying to
# opt out of, and concludes its CODE is broken. (Cost one cycle to find, tonight.)
#
# Only DREGG_-prefixed names are forwarded, and each value is shell-quoted, so this
# cannot smuggle PATH/LD_PRELOAD or any other ambient influence onto the box.
# Explicit `env VAR=… cargo …` in the command still works and still wins.
REMOTE_ENV=""
for _v in $(env | sed -n 's/^\(DREGG_[A-Z0-9_]*\)=.*/\1/p'); do
  printf -v _q '%q' "${!_v}"
  REMOTE_ENV+="export ${_v}=${_q}; "
done
[ -n "$REMOTE_ENV" ] && echo "pbuild: forwarding $(printf '%s' "$REMOTE_ENV" | grep -o 'DREGG_[A-Z0-9_]*' | tr '\n' ' ')to ${HOST}" >&2

# Build with cargo + elan env sourced (non-login shells lack them). Persvati's
# empty-wrapper path is intentionally byte-for-byte the historical behavior.
if [ -z "$REMOTE_WRAPPER" ]; then
  # shellcheck disable=SC2029 # Historical pbuild command interpolation on the remote shell.
  ssh "$HOST" "set -e; source ~/.cargo/env 2>/dev/null || true; \
    [ -f ~/.elan/env ] && source ~/.elan/env 2>/dev/null || true; \
    export PATH=\"\$HOME/.cargo/bin:\$HOME/.elan/bin:\$PATH\"; \
    cd '${REMOTE}' && $*"
else
  # One argument retains the established compound-command interface. Multiple
  # arguments are shell-quoted individually so nextest filters and feature
  # lists cross ssh with their argv intact.
  if [ "$#" -eq 1 ]; then
    REMOTE_COMMAND="$1"
  else
    printf -v REMOTE_COMMAND '%q ' "$@"
  fi
  printf -v REMOTE_COMMAND_Q '%q' "$REMOTE_COMMAND"
  # shellcheck disable=SC2029 # REMOTE_COMMAND_Q/WRAPPER_Q are client-shell-quoted by construction.
  ssh "$HOST" "set -e; source ~/.cargo/env 2>/dev/null || true; \
    [ -f ~/.elan/env ] && source ~/.elan/env 2>/dev/null || true; \
    export PATH=\"\$HOME/.cargo/bin:\$HOME/.elan/bin:\$PATH\"; \
    cd '${REMOTE}' && exec ${REMOTE_WRAPPER_Q} bash -c ${REMOTE_COMMAND_Q}"
fi
