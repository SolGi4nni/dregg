#!/usr/bin/env bash
# pbuild — offload a CARGO build/test to persvati (24-core build host), in an
# ISOLATED per-lane dir so concurrent lanes don't fight one target lock.
#
#   Usage:  scripts/pbuild [--force-cold] <lane-name> <command...>
#   e.g.    scripts/pbuild swap cargo build -p dregg-turn
#           scripts/pbuild crypto cargo test -p dregg-lightclient
#
# It rsyncs the LOCAL working tree (carrying uncommitted WIP) — gitignore-filtered
# so target/ and .lake/ are NOT synced (persvati keeps its own warm build caches
# per lane). Then runs the command there with the toolchain env sourced.
#
# NOTE: use this for CARGO (Rust) builds — the CPU-heavy crypto/circuit/lightclient
# ones. Keep LEAN (lake) builds LOCAL (the local .lake/mathlib cache is warm;
# a fresh persvati lane-dir would re-download mathlib = catastrophic).
#
# ── WHERE TO BUILD (the swarm rule, paid for on 2026-07-25) ─────────────────────
# The symptom that produced this block: hour-long subagents, all of them because
# every lane started its OWN build instead of waiting or offloading. Two different
# resources, two different answers:
#
#   LEAN (`lake build`) → LOCAL, always. The local metatheory/.lake is warm
#       (mathlib + ~1730 Dregg2 oleans); persvati's Lean .lake is cold/divergent,
#       so "offloading" a Lean build means re-downloading and re-elaborating
#       mathlib. Concurrent lake builds in the shared metatheory/ tree are FINE —
#       lake's own file locks and incrementality handle them — but bound the
#       fan-out: `lake` has NO `-j`/`--jobs` flag; the knob that works is
#       LEAN_NUM_THREADS=<n> (measured 2026-07-25: unset → 10-12 concurrent
#       `lean` on this 12-core box, =4 → exactly 4, =2 → exactly 2). One `lean`
#       per ready module, GBs each: 55 unbounded jobs took this laptop to load
#       average 154 and 54 GB of swap. dregg-lean-ffi/build.rs applies this cap
#       itself and now VERIFIES it held (build_parallel::run_bounded_lake).
#
#   CARGO → do NOT start a second one against the shared target/. There is ONE
#       lock per target dir, it has been observed held 45+ minutes with several
#       cargos queued behind it, and a queued cargo looks exactly like a slow
#       build from inside a lane. Either use the build already running (read its
#       log), or `scripts/pbuild <lane> cargo …` to get an isolated remote lane
#       dir with its own lock and its own warm cache. `CARGO_TARGET_DIR` to a
#       scratch path is the LAST resort: a cold target dir re-runs every build
#       script, and dregg-lean-ffi's cold path is the mathlib-sized one.
#
#   PROFILE = LOCK, so "one lock per target dir" is really TWO LANES. The lock
#       lives at `target/<profile>/.cargo-lock`, and `debug` and `release` are
#       separate files. A debug build and a release build run CONCURRENTLY; only
#       same-profile builds queue behind each other. So "a cargo is already
#       running" does not by itself mean wait — check WHICH profile:
#           lsof target/debug/.cargo-lock target/release/.cargo-lock
#       and take the free lane. Prefer `--release` for VERIFICATION runs: it is
#       the lane agents forget, so it is usually the shorter queue (a sibling
#       measured 3m54s release against 50m32s contended debug for the same
#       `dregg-circuit` check). Neither lane is reserved, though — on 2026-07-26
#       this tree had EIGHT concurrent cargos and both locks were held at once.
#       `lsof` first; do not assume release is idle.
#
#   FIVE CRATES HAD NO RELEASE LANE AT ALL until 2026-07-26, which is what made
#       the rule above unusable for the crates that needed it most.
#       `dregg-turn`, `dregg-intent`, `dregg-exec-lean`, `dregg-turn-prover` and
#       `dregg-tests` could build their TEST targets ONLY in `debug`, so every
#       lane verifying them was forced onto the one contended debug lock.
#       Cause: `cell/src/predicate.rs` gated a `compile_error!` on
#       `test-stubs && !debug_assertions`, i.e. "release implies production".
#       False — `dregg-cell` is a *dependency* of those five, so `cfg(test)` is
#       not set for it in a test build either, and a release TEST build is the
#       same compilation as a release PRODUCTION build. The gate fired on both.
#       It now also requires the absence of `test-stubs-release-test-target`,
#       a pure attestation those crates' `[dev-dependencies]` set; a production
#       release with `test-stubs` still fails to compile, verbatim as before.
#       See `cell/Cargo.toml` and `tests/tests/test_stubs_firewall.rs`.
#
# Being slow costs one lane some minutes; being greedy costs everyone the box.
#
# COLD-LANE GUARD: a lane dir with no warm build cache (no populated cargo
# target/ and no warm .lake/mathlib) compiles the WHOLE dependency graph from
# scratch — the load-95+ box-spike this guard exists to prevent. By default an
# agent that invents a fresh lane name is REFUSED and shown the warm lanes to
# reuse; pass --force-cold to deliberately seed a new lane.
set -euo pipefail

# The remote build box. Overridable so pbuild is not hardwired to the maintainer's host (#39):
# a fresh clone / other contributor can point it at their own box, or (below) is taught to build
# locally when no host is reachable.
HOST="${PBUILD_HOST:-persvati}"
# Warmth threshold: a lane counts as warm if its cargo target/{release,debug}/deps
# holds at least this many built artifacts (a fresh lane has 0). Override with
# PBUILD_WARM_DEPS. A warm metatheory/.lake/packages/mathlib (the lake package root)
# also counts as warm — see the probe below for why that path matters.
WARM_DEPS="${PBUILD_WARM_DEPS:-100}"
# Optional host policy. Persvati keeps the historical defaults (no wrapper and
# no extra disk floor). Hosts that are also production co-tenants can require a
# cgroup wrapper and a free-space reserve without duplicating pbuild's protocol.
REMOTE_WRAPPER="${PBUILD_REMOTE_WRAPPER:-}"
MIN_FREE_GIB="${PBUILD_MIN_FREE_GIB:-0}"
# ---- the LANE LEASE (contract, 2026-07-25) ---------------------------------
# pbuild is the WRITER of `<lane>/.pbuild-lease`; scripts/sweep-build-lanes.sh is the READER
# and refuses to reclaim any lane whose lease exists AND has not expired. Exactly one line:
#
#   owner=<string> pid=<int> host=<string> expires=<unix-seconds>
#
# It is a HINT WITH AN EXPIRY, never a lock: pbuild does not check anyone else's lease and
# never blocks on one, and a lease left by a crashed run ages out on its own. `pid`/`host`
# name the CLIENT process that owns the lane (the pbuild that wrote it) — the lease file
# itself already says which box it is on, so naming the box again would carry no
# information, whereas the client pair lets a human find the session responsible.
# `expires` is computed ON THE BOX (`date +%s` there), so a reader on the box never has to
# trust the client's clock. Measured skew today was 1s to persvati and 2s to hbox; correct
# by construction beats small-enough.
LEASE_TTL="${PBUILD_LEASE_TTL:-3600}"
LEASE_CLIENT_HOST="$(hostname -s 2>/dev/null || echo unknown)"
LEASE_OWNER="${PBUILD_LEASE_OWNER:-pbuild:$(id -un 2>/dev/null || echo unknown)@${LEASE_CLIENT_HOST}}"
# The lease line is fixed-shape and space-delimited, so no field may contain a space.
LEASE_OWNER="${LEASE_OWNER// /_}"
LEASE_CLIENT_HOST="${LEASE_CLIENT_HOST// /_}"

for _pb_int in MIN_FREE_GIB LEASE_TTL; do
  case "${!_pb_int}" in
    ''|*[!0-9]*)
      echo "pbuild: PBUILD_${_pb_int} must be a non-negative integer" >&2
      exit 2
      ;;
  esac
done

FORCE_COLD=0
if [ "${1:-}" = "--force-cold" ]; then FORCE_COLD=1; shift; fi
LANE="${1:?usage: pbuild [--force-cold] <lane> <command...>}"; shift
[ "$#" -ge 1 ] || { echo "pbuild: no command given" >&2; exit 2; }

# The lane name is interpolated into remote shell strings (the warmth probe, the archive
# provisioner, the lease write) and into rsync paths. Constrain it to a charset that cannot
# carry a quote or a path escape, so none of those interpolations can be broken by a lane
# name. Every lane in use on either box is already within this set.
case "$LANE" in
  ''|*[!A-Za-z0-9._-]*|.|..|-*)
    echo "pbuild: lane name '$LANE' must be non-empty [A-Za-z0-9._-] and not start with '-'" >&2
    exit 2
    ;;
esac

# ---- THE VERDICT LINE -----------------------------------------------------
# Agents are told "check the VERDICT line, never the exit code". Until 2026-07-25
# there WAS no verdict line, so that instruction could not be followed — and the
# failure it exists to prevent kept happening. Three lanes in one night read
# `scripts/pbuild … ; echo "EXIT=$?"` as a PASS when `$?` was the status of the
# trailing `echo`/`tail`, not of the build; one of those "successes" had a log
# whose entire content was this script's own COLD-LANE REFUSAL. A background-task
# notification saying "completed (exit code 0)" for a compound command reports on
# the last command of the compound, and nothing upstream can fix that.
#
# So pbuild states its own outcome, once, in a line that is hard to lose:
#
#   pbuild: VERDICT outcome=PASS|FAIL|REFUSED|ENVFAULT status=<n> lane=<lane> host=<host> cmd=<cmd>
#
# On STDOUT deliberately. Every idiom agents actually use — `> log 2>&1`,
# `2>&1 | tee log`, `| tail -n 50` — carries stdout; a stderr-only line is exactly
# what `| tail` drops. Emitted from an EXIT trap so it covers `set -e` aborts and
# the `exit 3`/`exit 4` guard refusals too, not just the happy path.
#
#   grep 'pbuild: VERDICT' <log>     # the only line worth trusting
#
# ⚠⚠ TWO WAYS TO DEFEAT THIS LINE, both hit THREE TIMES on 2026-07-26 by the person who wrote it:
#
#   1. DO NOT PIPE INSIDE THE REMOTE COMMAND.
#        scripts/pbuild <lane> bash -c 'lake build Foo 2>&1 | tail -6'    # <- WRONG
#      A pipeline exits with the status of its LAST stage, so `tail` returns 0 and pbuild
#      faithfully reports `outcome=PASS status=0` about `tail`. The VERDICT is only ever
#      trustworthy about the command you actually hand pbuild; a pipe moves the status
#      boundary INSIDE pbuild's blind spot. Redirect to a file and read it after, instead:
#        scripts/pbuild <lane> bash -c 'lake build Foo > /tmp/x.log 2>&1'
#
#   2. `timeout N scripts/pbuild ...` DOES NOT STOP THE REMOTE WORK.
#      timeout kills the LOCAL ssh; the remote build detaches and keeps running, and the
#      harness truthfully reports that the WRAPPER exited. A warming `lake build Dregg2`
#      survived two such kills and was still going, 8 `lean` procs deep, long after two
#      "completed (exit code 0)" notifications. If you must bound the wall clock, bound it
#      ON THE REMOTE (`timeout N lake build ...` inside the command) so the thing that dies
#      is the build, not your view of it — and re-check the box, never the notification.
#
# REFUSED is called out separately from FAIL on purpose: a refusal means the build
# NEVER RAN, so neither a red nor a green may be read off that log at all.
#
# ENVFAULT means the build STARTED and was KILLED BY THE BOX — so like REFUSED it
# carries no verdict, but unlike REFUSED it is not this script's decision. There are TWO
# ways the box does this and until 2026-07-26 only one of them was detected:
#
#   MEMORY — the original, censused below.
#   DISK   — added 2026-07-26. ENOSPC surfaces as `error: linking with cc failed` and
#            `could not compile <crate>`, i.e. as an ordinary compile break, and was
#            reported as `outcome=FAIL`. Measured that evening: persvati filled twice
#            (8 lanes, ~720 GB) and each run printed a screenful of what reads exactly
#            like a broken tree. The verdict line is what agents are told to trust, so
#            a mislabelled ENVFAULT sends the reader into their own diff.
#
# The memory half exists because the failure it names was invisible for eight days
# (2026-07-25 census):
#
#   hbox's user journal holds 198 `Failed with result 'oom-kill'` events, 2026-07-17
#   → 07-24. Measured over 3111 scopes that reported a peak: every one of the 67
#   killed scopes peaked at EXACTLY a cap value (24G x60, 32G x5, 40G, 70G) and NOT
#   ONE of the 3044 survivors exceeded ~14G. So the killer is always the per-build
#   `SWARM_MEM_MAX` cap, never slice pressure and never the box running dry — and 60
#   of the 60 kills at 24G trace to one copy-pasteable recipe (`SWARM_MEM_MAX=24G
#   swarm-build lake build …`, metatheory/Dregg2/Crypto/AXIOM-PICTURE.md) applied to
#   Crypto/PQ refinement modules that genuinely need more than 24G.
#
#   The cost was not the kills. It was that nothing told the lane: `swarm-build`
#   surfaces an OOM-kill as an ordinary nonzero status, so from inside a lane it is
#   indistinguishable from a proof error. On 07-24 one lane retried the same
#   `lake build Dregg2.Crypto.VerifyCoreArgAssembly` every 2-3 minutes from 21:33 to
#   22:05 — nine consecutive kills — then abandoned the box for the laptop, which is
#   how that night reached load 154 and 54 GB of swap.
#
# The probe runs ONLY after a nonzero status, so the happy path pays nothing. It
# checks both kill mechanisms these boxes actually use: the systemd cgroup OOM
# (hbox, via swarm-build scopes) and a kernel/earlyoom kill (persvati runs earlyoom
# with `--prefer cargo|rustc`, so a Rust build there is the PREFERRED victim).
# Disable with PBUILD_OOM_PROBE=0.
PBUILD_CMD_DESC="$*"
# PHASE, not the exit code, decides REFUSED vs FAIL. Keying off status numbers would
# be its own version of this bug: a remote `cargo` is free to exit 3 or 4, and a
# guard refusal and a genuine build failure must never be confusable.
PBUILD_PHASE=guard
# Set by the run phase when the remote reports the build was killed for memory.
PBUILD_ENVFAULT=""
_pbuild_verdict() {
  _pb_status=$?
  if [ "$PBUILD_PHASE" = guard ]; then
    _pb_outcome=REFUSED
  elif [ -n "$PBUILD_ENVFAULT" ]; then
    _pb_outcome=ENVFAULT
  elif [ "$_pb_status" -eq 0 ]; then
    _pb_outcome=PASS
  else
    _pb_outcome=FAIL
  fi
  printf 'pbuild: VERDICT outcome=%s status=%s lane=%s host=%s cmd=%s\n' \
    "$_pb_outcome" "$_pb_status" "$LANE" "$HOST" "$PBUILD_CMD_DESC"
  return "$_pb_status"
}
trap _pbuild_verdict EXIT

# Ask the remote whether the thing that just died was killed for memory. Prints the
# evidence line it found (so the claim is never bare) and returns 0 on a hit.
_pbuild_oom_evidence() {
  [ "${PBUILD_OOM_PROBE:-1}" = 1 ] || return 1
  ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" '
    since="-20 min"
    # 1. systemd cgroup OOM — what swarm-build scopes hit when SWARM_MEM_MAX binds.
    journalctl --user --since "$since" --no-pager 2>/dev/null \
      | grep -E "oom-kill|killed by the OOM killer" | tail -n 2
    # 2. kernel OOM / earlyoom — the persvati path (no cgroup wrapper there).
    journalctl --since "$since" --no-pager 2>/dev/null \
      | grep -E "earlyoom.*(sending SIGKILL|Killed process)|Out of memory: Killed process" | tail -n 2
  ' 2>/dev/null | grep -E '.'
}

# THE OTHER WAY THE BOX KILLS A BUILD: the disk fills.
#
# `_pbuild_oom_evidence` covers memory and only memory, so ENOSPC — which is just as
# much "the box did this, not your code" — has been landing as `outcome=FAIL` and
# reading as a red against the tree. Measured 2026-07-26: persvati hit 100% twice in
# one evening (8 lanes, ~720 GB) and reported `VERDICT outcome=FAIL status=101` with a
# screenful of `error: linking with cc failed` and `could not compile <crate>` — the
# exact shape of a real compile break, for a disk that was full. An agent reading the
# verdict line as instructed would have gone hunting through its own diff.
#
# ⚠ HONEST LIMIT, stated because it decides how to read a miss: this probes the BOX, not
# the build's output. pbuild streams the remote command straight to its own stdout and
# keeps no log of its own, so there is nothing to grep for `os error 28`. Asking the box
# is therefore the available signal, and it is a *sufficient* one — a lane filesystem
# still at capacity moments after a nonzero exit is not a coincidence — but it is not
# NECESSARY: if a concurrent sweep freed space between the failure and this check, the
# probe comes back clean and the verdict falls back to FAIL. A miss here means "no
# evidence", never "your code".
_pbuild_enospc_evidence() {
  [ "${PBUILD_DISK_PROBE:-1}" = 1 ] || return 1
  ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" "
    df -P -- 'dregg-build/${LANE}' 2>/dev/null || df -P -- \"\$HOME\" 2>/dev/null
  " 2>/dev/null | awk '
    # BOTH conditions, and the second is the load-bearing one. `df -P`'"'"'s Use% excludes
    # reserved blocks, so persvati reads "100%" with 17 GB genuinely free — a percentage
    # alone would label ordinary compile failures as environment faults, which is the
    # fail-OPEN direction and strictly worse than todays under-reporting. 8 GiB is well
    # under what any workspace link needs and well over the ~4 GB the measured ENOSPC
    # died at, so this fires only when the box is actually out.
    NR>1 && $5+0 >= 99 && $4+0 < 8388608 {
      printf "  %s is %s full — only %.1f GiB free\n", $6, $5, $4/1048576
    }' | grep -E '.'
}

# Repo root, derived from THIS script's own location (scripts/pbuild) — NOT a hardcoded maintainer
# path (#39). The old absolute `SRC` silently rsync'd the wrong tree from any other clone.
SRC="$(cd "$(dirname "$0")/.." && pwd)/"
REMOTE="dregg-build/${LANE}"

# pbuild is a maintainer OFFLOAD to a warm remote build box; a fresh clone / non-maintainer machine
# has no such host. Fail with a TEACHING message instead of a raw `ssh: could not resolve` (#39).
# (The `if !` context is exempt from `set -e`, so an unreachable host does not abort here.)
if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" true 2>/dev/null; then
  cat >&2 <<MSG
pbuild: cannot reach remote build host '$HOST'.
  pbuild offloads builds to a warm remote box (maintainer setup). From a fresh clone you can:
    • build locally:                 $*
    • point pbuild at your own box:  PBUILD_HOST=your-host scripts/pbuild $LANE <cmd>
MSG
  exit 2
fi

# A co-tenant wrapper is an authority boundary, not a best-effort preference:
# fail before mkdir/rsync if it is absent. Quote the command name so an unusual
# contributor-owned path remains one remote shell word.
if [ -n "$REMOTE_WRAPPER" ]; then
  printf -v REMOTE_WRAPPER_Q '%q' "$REMOTE_WRAPPER"
  # shellcheck disable=SC2029 # REMOTE_WRAPPER_Q is deliberately client-quoted for the remote shell.
  if ! ssh "$HOST" "command -v ${REMOTE_WRAPPER_Q} >/dev/null 2>&1"; then
    echo "pbuild: REFUSING — required remote wrapper '${REMOTE_WRAPPER}' is absent on ${HOST}." >&2
    exit 4
  fi
fi

# Check the remote home filesystem before any mutation. A Cargo link can grow a
# warm lane by several GiB; hosts with live services need space left for those
# services even when the build itself is memory-contained.
if [ "$MIN_FREE_GIB" -gt 0 ]; then
  FREE_KIB="$(ssh "$HOST" "df -Pk \"\$HOME\" | awk 'NR == 2 { print \$4 }'")"
  case "$FREE_KIB" in
    ''|*[!0-9]*)
      echo "pbuild: REFUSING — could not measure free space on ${HOST}." >&2
      exit 4
      ;;
  esac
  MIN_FREE_KIB=$((MIN_FREE_GIB * 1024 * 1024))
  if [ "$FREE_KIB" -lt "$MIN_FREE_KIB" ]; then
    FREE_GIB=$((FREE_KIB / 1024 / 1024))
    cat >&2 <<MSG
pbuild: REFUSING — ${HOST} has only ~${FREE_GIB} GiB free; host policy requires
        ${MIN_FREE_GIB} GiB (PBUILD_MIN_FREE_GIB). No mkdir or rsync was attempted.
MSG
    exit 4
  fi
fi

# ---- cold-lane guard ------------------------------------------------------
# Probe the remote (BEFORE any mkdir/rsync — a brand-new lane dir does not yet
# exist, so it reads as cold) for this lane's warmth + the list of warm lanes.
# shellcheck disable=SC2087 # WARM_DEPS/LANE are intentionally interpolated locally into the probe.
PROBE="$(ssh "$HOST" "bash -s" <<PROBE_EOF
set -e
warm_of() {
  d="\$1"
  # ⚠ THE LEAN PACKAGE ROOT IS <lane>/metatheory, NOT <lane> (fixed 2026-07-25).
  # metatheory/lakefile.toml is the lake package, so lake resolves mathlib to
  # <lane>/metatheory/.lake/packages/mathlib — which is exactly where THIS SCRIPT's
  # own \`cache get\` step puts it (\`cd '\${REMOTE}/metatheory'\`, below). The probe
  # looked at <lane>/.lake, a path that never exists, so the mathlib arm was DEAD:
  # measured on hbox 2026-07-25, lane \`games-deploy\` held 8105 oleans and pbuild
  # called it COLD and refused it.
  #
  # That made the same-day "fetch mathlib, never compile it" win (13h -> 40s)
  # unclaimable: a lane pbuild had just warmed still read cold on the next call, so
  # the only ways forward were --force-cold (which rebuilds the whole cargo dep graph,
  # the very spike the guard exists to prevent) or give up and build on the laptop.
  # Every Lean-warm/cargo-cold lane on the Lean box was refused. Check BOTH paths.
  for m in "\${d}/metatheory/.lake/packages/mathlib" "\${d}/.lake/packages/mathlib"; do
    [ -d "\$m" ] && { echo warm; return; }
  done
  n=\$(ls "\${d}/target/release/deps" "\${d}/target/debug/deps" 2>/dev/null | wc -l | tr -d ' ')
  if [ "\${n:-0}" -ge ${WARM_DEPS} ]; then echo warm; else echo cold; fi
}
echo "STATUS:\$(warm_of "dregg-build/${LANE}")"
echo "WARM_BEGIN"
for x in dregg-build/*/; do
  [ -d "\$x" ] || continue
  xd="\${x%/}"
  [ "\$(warm_of "\$xd")" = warm ] && echo "\${xd#dregg-build/}"
done
echo "WARM_END"
PROBE_EOF
)"

STATUS="$(printf '%s\n' "$PROBE" | sed -n 's/^STATUS://p')"
WARM_LANES="$(printf '%s\n' "$PROBE" | sed -n '/^WARM_BEGIN$/,/^WARM_END$/p' | sed '/^WARM_BEGIN$/d;/^WARM_END$/d')"

if [ "$STATUS" != "warm" ]; then
  if [ "$FORCE_COLD" -eq 1 ]; then
    echo "pbuild: WARNING — lane '${LANE}' is COLD; --force-cold given, seeding a" >&2
    echo "        fresh build. The Lean half is cheap (mathlib oleans are FETCHED below," >&2
    echo "        not compiled); the Rust dep graph still compiles from scratch." >&2
    SEED_LEAN_CACHE=1
  else
    {
      echo "pbuild: REFUSING — lane '${LANE}' is COLD on ${HOST} (no warm cargo target/,"
      echo "        no warm .lake/mathlib). Running it would rebuild EVERYTHING from"
      echo "        scratch (~20min+, box load 95+ — the exact spike this guard prevents)."
      echo ""
      if [ -n "$WARM_LANES" ]; then
        echo "        Reuse a WARM lane instead (these already have a build cache):"
        # shellcheck disable=SC2086 # Deliberate newline/word split: one formatted lane per row.
        printf '          %s\n' $WARM_LANES
      else
        echo "        (no warm lanes found on ${HOST} to reuse)"
      fi
      echo ""
      echo "        Or pass --force-cold to deliberately seed lane '${LANE}':"
      echo "          scripts/pbuild --force-cold ${LANE} $*"
    } >&2
    exit 3
  fi
fi

# Sync working tree (WIP included) -> isolated lane dir. gitignore filter keeps
# target/.lake out so persvati's per-lane build cache survives across invocations.
#
# ⚠ THE LEAN ARCHIVE IS AN EXPLICIT EXCEPTION TO THE GITIGNORE FILTER (2026-07-25).
# `dregg-lean-ffi/.gitignore` says `*.a`, which catches `libdregg_lean.a` (~106 MB) — so
# for as long as this script has existed, the verified Lean archive NEVER REACHED the
# remote lane. The failure mode is silent and expensive: every executor-touching test
# binary there dies with a bare `SIGABRT` and NO Rust panic message, because
# `Custodian::generate` -> ML-DSA-65 keygen aborts without the verified cores. Three
# separate lanes hit it in one night; one lost hours before proving it was not their code
# (it reproduced only where the archive was absent, and vanished on two boxes once
# present). `dregg-app-framework`'s own 164 tests abort identically, so a lane cannot even
# use a neighbouring crate as a control.
#
# The `+` rule is listed BEFORE the merge filter because rsync takes the first matching
# rule. If the archive is absent locally the rule is simply a no-op, and the preflight
# below says so out loud rather than letting the remote discover it as a signal 6.
LEAN_ARCHIVE="dregg-lean-ffi/libdregg_lean.a"
# Written by the provisioner below; read by it on the next call so an 8-second `nm` scan over a
# ~478 MB archive is not paid on every invocation. It records the archive's size+mtime, so an
# archive that changed underneath it invalidates the record instead of being vouched for.
LEAN_ARCHIVE_PROV="dregg-lean-ffi/.libdregg_lean.a.provenance"

# ⚠ THE ARCHIVE IS AN ARCH-SPECIFIC BUILD PRODUCT — never ship it cross-platform.
# The first version of this fix rsync'd it unconditionally and immediately broke a
# macOS->Linux lane: the members are `Mach-O 64-bit object arm64`, so `rust-lld` on
# x86_64 reports "archive member 'Aesop.o' is neither ET_REL nor LLVM bitcode" and
# then `undefined symbol: dregg_exec_full_forest_auth`. Loud, at least — a link
# error naming the symbol beats the bare SIGABRT it replaced — but still wrong.
# Ship it only when host and remote agree on OS and machine; otherwise the remote
# must build its own, which `lake exe cache get` below now makes affordable.
LOCAL_PLATFORM="$(uname -s)-$(uname -m)"
REMOTE_PLATFORM="$(ssh "$HOST" 'echo "$(uname -s)-$(uname -m)"' 2>/dev/null || echo unknown)"
ARCHIVE_FILTER=()
if [ "$LOCAL_PLATFORM" = "$REMOTE_PLATFORM" ]; then
  ARCHIVE_FILTER=(--filter="+ /${LEAN_ARCHIVE}")
elif [ -f "${SRC%/}/${LEAN_ARCHIVE}" ]; then
  echo "pbuild: host is ${LOCAL_PLATFORM}, ${HOST} is ${REMOTE_PLATFORM} — NOT shipping" >&2
  echo "        ${LEAN_ARCHIVE} (it is arch-specific; a cross-shipped archive links as" >&2
  echo "        'neither ET_REL nor LLVM bitcode'). The lane gets a platform-native one from" >&2
  echo "        the release instead — see ARCHIVE PROVISIONING below." >&2
fi

# ---- SHIP .git (2026-07-25) ------------------------------------------------
# For as long as this script existed it did `--exclude='.git/'`, and that exclusion was never
# justified — it was inherited. It has a specific, expensive consequence.
#
# `scripts/lean-seed-key.sh` derives the seed's content key from
# `git rev-parse HEAD:metatheory/Dregg2` (line 58) — the COMMITTED tree object. With no `.git` it
# silently falls back to a sha256 of concatenated `.lean` files (lines 61-65). That fallback is a
# DIFFERENT KEY SPACE: it can never equal a git tree-object id, so it can never name a published
# asset. Therefore `scripts/fetch-lean-seed.sh` could NEVER succeed inside a lane, which is why
# every persvati lane sat with no `libdregg_lean.a` while CI published a platform-native one on
# every push to main. The consequence is not a slow build, it is FALSE REDS: an oracle-backed test
# with no archive aborts with a bare SIGABRT, and a lane reads that as its own bug (measured
# elsewhere in this repo as 405/28 remote vs 422/14 local, the whole delta being the archive).
#
# Shipping `.git` fixes that at the root rather than by a side-channel: the lane computes the SAME
# key the publisher did, so fetch simply works, and a lane can also answer "what commit is this?".
#
# COST, measured 2026-07-25 by `rsync --dry-run --stats`: 832 MB / 3,710 files on the first sync
# per lane, incremental after. `.git` here is 1.3 GB, but 525 MB of that is `.git/lfs` — a local
# blob cache the lane never needs, since the checked-out files are already in the tree. Excluded.
#
# CONCURRENCY: this repo has ~10 terminals committing at once, so the copy is taken while `.git`
# is being written. That is safe for this use. Git writes objects and packfiles temp-then-rename,
# so anything visible is immutable and complete, and a ref only advances AFTER its objects are
# durable — so a copy can be slightly STALE but not incoherent, and `rev-parse HEAD:<path>` stays
# consistent. `*.lock` and in-flight `tmp_*` are excluded so a torn lock never lands.
# `.git` deliberately does NOT get `--delete` protection concerns: nothing on the remote writes it.
#
# ⚠ DEFAULT OFF, AND THE REASON IS A MEASUREMENT, NOT CAUTION (2026-07-25).
# Predicted ~1 min for 832 MB on a LAN. MEASURED: 594 MB in ~25 minutes into a real lane, i.e.
# ~0.5 MB/s. The bytes are not the problem — the FILE COUNT is. `.git` here is 3,710 files of which
# ~400 are tiny loose objects, and rsync-over-ssh pays a round trip per file. So enabling this by
# default would add ~25 minutes to the NEXT pbuild call of every lane, which is a worse tax than the
# problem it solves.
#
# rsync is simply the wrong transport for a git directory. The right fixes, in order:
#   1. `git gc` / `git repack -ad` locally first — collapsing ~400 loose objects into a pack turns
#      thousands of round trips into a handful of large sequential transfers.
#   2. Better: skip rsync for this entirely. `git bundle create` + one file copy, or
#      `git clone --shared --no-checkout` on the remote against a single synced bare mirror, gives
#      the lane a real `.git` for a fraction of the calls.
# Until one of those lands, this stays opt-in:  PBUILD_SHIP_GIT=1 scripts/pbuild <lane> <cmd>
#
# WHAT IT BUYS when you do enable it (verified as the mechanism, not yet end-to-end): the lane can
# run `git rev-parse HEAD:metatheory/Dregg2`, so `scripts/lean-seed-key.sh` computes the SAME key
# the publisher used instead of falling into the file-hash fallback — which is the only reason
# `scripts/fetch-lean-seed.sh` cannot currently work in a lane.
# ⚠⚠ TESTED AND IT DOES NOT WORK — rsync CANNOT ship a live `.git` COHERENTLY. PROVEN, not feared:
# a completed sync into lane `packed-merkle` produced a repo where `git rev-parse --short HEAD` reads
# `8ef2fe29d` (correct, current) but `git ls-tree HEAD --name-only` returns NOTHING and
# `git rev-parse HEAD:metatheory/Dregg2` says "exists on disk, but not in 'HEAD'". Both packs landed
# (35 MB + 538 MB, 807 MB total, 211 loose dirs) — the object store is healthy. What is missing is the
# ROOT TREE of the commit the ref names.
#
# MECHANISM: rsync walks the tree once, in directory order, and this walk took 25 MINUTES. Two commits
# landed DURING it. rsync had already passed `objects/` when their objects were written, and reached
# `refs/` afterwards — so it copied a ref NEWER THAN THE OBJECTS it copied. The result is a repo that
# is not stale, it is INCOHERENT: a ref pointing into nothing.
#
# I had argued the opposite in this very file — that git writes temp-then-rename and a ref only
# advances after its objects are durable, so a concurrent copy is "stale but not incoherent". That
# holds for a LIVE REPOSITORY. It does NOT hold for a non-atomic multi-minute COPY of one that is
# being committed to. With ~10 terminals committing, this state is not a risk, it is the expected
# outcome. The measurement corrected the argument.
#
# SO: do not "fix" this with more rsync passes or a better exclude list. The transport must take a
# CONSISTENT SNAPSHOT. `git bundle create` (one file, atomic by construction) or
# `git clone --shared --no-checkout` from a single synced bare mirror are the correct shapes.
# THE BAR for whoever finishes it: show the in-lane key EQUAL to the local one, AND
# `git ls-tree HEAD` non-empty in the lane. Anything less is a ref into a void.
GIT_FILTER=()
if [ "${PBUILD_SHIP_GIT:-0}" = 1 ] && [ -d "${SRC%/}/.git" ]; then
  # ⚠ ORDER IS LOAD-BEARING: rsync takes the FIRST matching rule, so every exclusion must be
  # listed BEFORE the broad include. Written the other way round, `--include='/.git/**'` matches
  # `.git/lfs/<blob>` first and ships all 525 MB of the cache this is meant to skip.
  GIT_FILTER=(
    --exclude='/.git/lfs/'            # 525 MB local blob cache; the worktree already has the files
    --exclude='/.git/lfs/**'          # (both forms: the bare dir entry AND its contents)
    --exclude='/.git/**/*.lock'       # never ship a lock taken mid-commit by another terminal
    --exclude='/.git/objects/**/tmp_*'
    --include='/.git/'  --include='/.git/**'
  )
else
  GIT_FILTER=(--exclude='.git/')
fi

# ---- PROTECT the remote-owned files from --delete --------------------------
# Three files live in the lane, are OWNED BY THE REMOTE SIDE, and have no local counterpart:
# the Lean archive (arch-specific, usually fetched by the provisioner below), its provenance
# sidecar, and the lease. `--delete` removes anything on the receiver that the sender does not
# have, and only EXCLUDED files are spared — so each of these needs to be either gitignored or
# explicitly protected.
#
# ⚠ ORDER IS LOAD-BEARING, AND `+` IS A DELETION RISK. For the receiver's delete scan rsync
# reads the SAME filter list and takes the FIRST matching rule, where `-` protects, `+` RISKS,
# and `P`/`R` are the delete-only equivalents. So the pre-existing `+ /dregg-lean-ffi/…a` rule
# (added so a same-platform host receives the archive) also CANCELS the gitignore protection it
# was relying on: on a Linux→Linux pbuild with no local archive, that include is what would have
# let `--delete` remove a perfectly good 478 MB archive out of the lane. `P` must therefore come
# BEFORE the include — it protects from deletion without affecting the transfer, so a host that
# CAN ship the archive still ships it.
#
# Only the archive is covered by a .gitignore (`dregg-lean-ffi/.gitignore`: `*.a`). The sidecar
# and the lease are not, and protecting them here rather than editing a shared `.gitignore`
# keeps the whole mechanism inside this script.
PROTECT_FILTER=(
  --filter="P /${LEAN_ARCHIVE}"
  --filter="P /${LEAN_ARCHIVE_PROV}"
  --filter="P /.pbuild-lease"
)

# ---- claim the lane (the lease) --------------------------------------------
# Written HERE, before rsync, and not later: rsync into a cold lane has been measured at 25
# minutes, and that window — where the lane is half-written and holds no build yet — is exactly
# when a sweeper reclaiming it does the most damage. Folded into the mkdir round trip so the
# lease costs no extra ssh. `expires` is computed on the box; the temp-then-rename means a
# reader never sees a torn line.
#
# A REFUSAL NEVER LEASES: every guard above exits before this point, so a lane that pbuild
# declined (cold, no wrapper, no disk) is not left claimed for an hour by a run that never
# touched it. That is a deliberate reading of "on every invocation" — an invocation that does
# not take the lane does not claim it.
# shellcheck disable=SC2029 # REMOTE/LEASE_* are locally owned and charset-validated above.
ssh "$HOST" "set -e; mkdir -p '${REMOTE}'; \
  printf 'owner=%s pid=%s host=%s expires=%s\n' \
    '${LEASE_OWNER}' '$$' '${LEASE_CLIENT_HOST}' \"\$(( \$(date +%s) + ${LEASE_TTL} ))\" \
    > '${REMOTE}/.pbuild-lease.tmp.$$'; \
  mv -f '${REMOTE}/.pbuild-lease.tmp.$$' '${REMOTE}/.pbuild-lease'"

rsync -az --delete \
  "${PROTECT_FILTER[@]}" \
  "${ARCHIVE_FILTER[@]}" \
  "${GIT_FILTER[@]}" \
  --filter=':- .gitignore' \
  "$SRC" "${HOST}:${REMOTE}/"

# ---- FETCH mathlib, never compile it (2026-07-25) --------------------------
# THE measurement that unlocks parallel remote lanes:
#
#   compiling the mathlib closure : ~13 HOURS  (measured: 3,337/8,098 objects at ~6/min)
#   `lake exe cache get`          :  40 SECONDS (measured: 8,463 files, 2,680 -> 8,105 oleans)
#
# Mathlib ships a prebuilt olean cache and NOTHING in this repo has ever called it. That single
# omission is why a cold lane was catastrophic, why the guard above had to refuse cold lanes at
# all, and therefore why work piled onto one laptop's shared target lock while two 24-core boxes
# sat idle. A cold lane's Lean half is now a 40-second download; only the Rust dep graph still
# compiles, and that parallelises across lanes because each lane owns its own target dir.
#
# Idempotent and additive — `cache get` only fills in missing oleans, so running it on a warm
# lane is safe and repairs a partially-populated one. Failure is NON-FATAL: a lane with no
# network still builds, just the slow way, and says so.
if [ "${SEED_LEAN_CACHE:-0}" -eq 1 ] || [ "${PBUILD_ALWAYS_CACHE_GET:-0}" -eq 1 ]; then
  echo "pbuild: fetching the mathlib olean cache into lane '${LANE}' (seconds, not hours) …" >&2
  # shellcheck disable=SC2029 # REMOTE is a locally-owned, validated lane path.
  ssh "$HOST" "set -e; source ~/.elan/env 2>/dev/null || true; \
    export PATH=\"\$HOME/.elan/bin:\$PATH\"; \
    cd '${REMOTE}/metatheory' 2>/dev/null || exit 0; \
    lake exe cache get 2>&1 | tail -2" \
    || echo "pbuild: WARNING — mathlib cache fetch failed; the lane will COMPILE mathlib \
instead (hours). Check network/elan on ${HOST} before blaming the build." >&2
fi

# ═══ ARCHIVE PROVISIONING — killing the FALSE-RED class (2026-07-25) ═════════
# THE WOUND. A lane with no `dregg-lean-ffi/libdregg_lean.a` builds MARSHAL-ONLY, and an
# executor-touching test binary there dies with a BARE SIGABRT and no Rust panic message (the PQ
# audit gate `process::abort()`s rather than let the unaudited crate answer). Nothing on that path
# says "environment", so lanes read it as their own bug: measured 405/28 remote vs 422/14 local,
# the entire delta being the archive, and three separate lanes burned hours on it in one night.
# 3 of 18 persvati lanes and 3 of 32 hbox lanes held an archive when this was written, and every
# one of those was placed BY HAND.
#
# WHY IT COULD NOT FIX ITSELF. `scripts/fetch-lean-seed.sh` exists and works — but the key it
# resolves comes from `scripts/lean-seed-key.sh`, which derives the Dregg2 half from
# `git rev-parse HEAD:metatheory/Dregg2`. A lane has no `.git` (pbuild excludes it), so that call
# fails, and the script SILENTLY falls back to a sha256 of concatenated `.lean` files — a
# DIFFERENT KEY SPACE that can never equal a git tree id, hence can never name a published asset.
# So fetch could never succeed inside a lane, for as long as lanes have existed.
#
# ⚠ AND `.git` CANNOT BE RSYNC'd. Proven, not feared (2026-07-25): a COMPLETED opt-in sync left a
# lane where `git rev-parse --short HEAD` was correct but `git ls-tree HEAD` was EMPTY. Both packs
# landed, 807 MB, object store healthy — what was missing was the ROOT TREE of the commit the ref
# named. rsync walks once in directory order and that walk took 25 MINUTES; commits landed during
# it, so it copied a ref NEWER THAN THE OBJECTS it had already copied. With ~10 terminals
# committing, that is the expected outcome, not a risk. The transport would have to be a
# CONSISTENT SNAPSHOT (`git bundle`, or one synced bare mirror + `git clone --shared`).
#
# ⚠ SO THIS DOES NOT SHIP `.git` AT ALL — IT SHIPS THE ONE MISSING FACT.
# The lane does not need a repository. It needs exactly one value it cannot compute: the git tree
# oid of `metatheory/Dregg2`. pbuild runs LOCALLY, where `.git` is real and coherent, so it reads
# the oid here and injects it into the lane through a `git` shim on PATH that answers ONLY
# `rev-parse <rev>:metatheory/Dregg2` and delegates everything else to the real git. Then the
# lane's OWN `lean-seed-key.sh` + `fetch-lean-seed.sh` run unmodified and do all the real work:
# platform detection (correct BY CONSTRUCTION there — no cross-platform key guessing), toolchain
# and mathlib pin from the synced files, asset naming, download, sha256 verification against the
# published sidecar, the seven-export check, atomic install. NOTHING about the key recipe, the
# asset naming, or the acceptance criteria is duplicated in this script — a duplicate would drift,
# and the whole point is that a lane resolves the SAME key the publisher used. The shim carries a
# SELF-CHECK (`PB_SEED_TREE=shimprobe git rev-parse HEAD:metatheory/Dregg2` must echo shimprobe)
# because the failure it prevents is silent: lean-seed-key.sh swallows a git error and falls into
# that other key space, which would look exactly like "no seed has been published".
#
# ⚠ THE PUBLISHER IS NOW MANUAL-ONLY, SO "MATCHES HEAD" IS NOT AN OPTION. .github/workflows/
# lean-seed.yml lost its `push` trigger AND its nightly on 2026-07-25 (it saturated hbox for 19-25
# min on every metatheory commit, and hbox is triple-booked). An asset for the CURRENT
# `HEAD:metatheory/Dregg2` therefore usually does NOT exist — at the time of writing HEAD's key
# had no asset and 150 assets were published. A design that only accepted an exact match would be
# a design that refuses almost always.
#   So the candidates are HEAD's Dregg2 tree AND ITS ANCESTORS', walked back through the commit
#   history, newest first. Every candidate key is computed with the CURRENT platform, toolchain and
#   mathlib pin — only the Dregg2 tree varies — so a hit is a precise statement: "this seed was
#   built by CI from an ANCESTOR of this checkout, on the same toolchain and the same mathlib
#   revision", not a guess that some archive is probably close enough. Measured on the tree this
#   landed in: HEAD missed, and the nearest hit was 12 commits back (a667abe45).
#   Staleness is then REPORTED, never hidden — and it is not this script's call to make anyway:
#   dregg-lean-ffi/build.rs re-splices the current Dregg2 slice over the seed from a warm `.lake`,
#   warns loudly when the objects it is about to link do not correspond to HEAD, and REFUSES
#   outright under DREGG_REQUIRE_LEAN=1. pbuild's job is PRESENCE plus LEGIBLE PROVENANCE; the
#   build is the authority on whether that exact archive is acceptable.
#
# THE LADDER, in order, and what each costs (measured on persvati 2026-07-25):
#   0. KEEP        — the lane's archive is vouched by its provenance sidecar (size+mtime match,
#                    exports already checked). 0 s, no network. The steady state.
#   0b. ADOPT      — an archive is present with no sidecar (hand-placed, like 3 lanes today). Its
#                    exports are scanned and it is adopted with provenance UNKNOWN, said out loud.
#                    8 s. A hand-placed archive is never deleted for lacking paperwork.
#   1. RELEASE     — fetch the keyed asset for HEAD or the nearest published ancestor:
#                    13.8 s download (35.8 MB) + 0.1 s sha256 + 0.8 s unzstd (→ 478 MB) + 8.1 s
#                    export scan ≈ 23 s. Every lane pays this once.
#   2. DONOR       — copy from a sibling lane on the same box that holds a verified archive. This
#                    is the cheap half of "build it once on the box and copy it into lanes", and
#                    it is what keeps the box working with no network and no published seed.
#   3. REFUSE      — legibly, naming the exact asset that does not exist and the exact command
#                    that would publish it. Never a bare signal 6, and never a silent
#                    marshal-only.
# What is NOT implemented: building the seed from source on the box (hours of leanc). It is named
# in the refusal, not started — a build tool that silently launches an hours-long box-saturating
# compile is the spike the cold-lane guard above exists to prevent.
#
# KNOBS:
#   PBUILD_PROVISION_ARCHIVE=0   skip this block entirely (pre-2026-07-25 behaviour)
#   PBUILD_REQUIRE_ARCHIVE=auto  auto (default) = REFUSE only when the command runs tests/binaries
#                                (cargo test/nextest/run/bench); 1 = always refuse; 0 = never
#   PBUILD_REFRESH_ARCHIVE=1     re-provision even when the lane's archive is acceptable
#   PBUILD_SEED_ANCESTORS=<n>    how far back to look for a published ancestor (default 40)
#   PBUILD_SEED_SOURCES=release,donor   which rungs may be used (default both). `release` alone
#                                is the strict policy: only a seed whose sha256 matched its
#                                PUBLISHED sidecar, never a copy of whatever a neighbouring lane
#                                happens to hold. It is also how the REFUSAL path is exercised on
#                                a box that has donors — a refusal nobody can reach is not one.
#   PBUILD_SEED_DONOR_LANE=<l>   try this lane first as a donor
#   PBUILD_SEED_TAG / PBUILD_SEED_REPO   override the release tag / owner-repo
if [ "${PBUILD_PROVISION_ARCHIVE:-1}" = 1 ]; then
  SEED_ANCESTORS="${PBUILD_SEED_ANCESTORS:-40}"
  case "$SEED_ANCESTORS" in
    ''|*[!0-9]*)
      echo "pbuild: PBUILD_SEED_ANCESTORS='${SEED_ANCESTORS}' is not a number; using 40." >&2
      SEED_ANCESTORS=40 ;;
  esac
  SEED_TAG="${PBUILD_SEED_TAG:-${DREGG_SEED_TAG:-$(sed -n 's/^TAG=//p' "${SRC%/}/dregg-lean-ffi/lean-seed.pin" 2>/dev/null | head -1)}}"
  SEED_TAG="${SEED_TAG:-lean-seed}"
  SEED_REPO="${PBUILD_SEED_REPO:-${DREGG_SEED_REPO:-}}"
  if [ -z "$SEED_REPO" ]; then
    SEED_REPO="$(git -C "${SRC%/}" remote get-url origin 2>/dev/null \
      | sed -E 's#(git@github.com:|https://github.com/)##; s#\.git$##' || true)"
  fi

  # Every one of these values is interpolated into a single-quoted string inside the remote
  # shell script below, so a single quote in any of them would end that string and the rest
  # would be executed. The tag and the repo slug come from a committed file and a git remote —
  # both editable by anyone who can push — so this is a guard, not a formality.
  for _pb_v in SEED_TAG SEED_REPO PBUILD_REFRESH_ARCHIVE PBUILD_SEED_SOURCES PBUILD_SEED_DONOR_LANE; do
    case "${!_pb_v:-}" in
      *[!A-Za-z0-9._,:/@-]*)
        echo "pbuild: REFUSING — ${_pb_v}='${!_pb_v}' contains a character that cannot be safely" >&2
        echo "        passed to the remote shell ([A-Za-z0-9._,:/@-] only)." >&2
        exit 2 ;;
    esac
  done

  # ---- the candidate Dregg2 trees, computed HERE where .git is real ---------
  # ONE `rev-list` + ONE `cat-file --batch-check` (not N `rev-parse` forks): `<rev>:<path>` is a
  # valid batch input, so the whole walk is two processes. `paste` re-attaches the commit each
  # tree came from, and the paste line number IS the distance from HEAD, so the FIRST time a tree
  # is seen we also learn the nearest commit that carries it. Columns: tree, commit, distance.
  SEED_TREE_INFO=""
  if git -C "${SRC%/}" rev-parse --git-dir >/dev/null 2>&1; then
    SEED_TREE_INFO="$(paste \
      <(git -C "${SRC%/}" rev-list -n "$SEED_ANCESTORS" HEAD 2>/dev/null \
          | sed 's|$|:metatheory/Dregg2|' \
          | git -C "${SRC%/}" cat-file --batch-check 2>/dev/null) \
      <(git -C "${SRC%/}" rev-list -n "$SEED_ANCESTORS" HEAD 2>/dev/null) \
      | awk '$2 == "tree" && !seen[$1]++ { print $1 "\t" $4 "\t" (NR - 1) }' || true)"
  fi
  SEED_TREES="$(printf '%s\n' "$SEED_TREE_INFO" | awk 'NF { print $1 }')"
  SEED_HEAD_TREE="$(printf '%s\n' "$SEED_TREE_INFO" | awk 'NR == 1 { print $1 }')"
  if [ -z "$SEED_TREES" ]; then
    echo "pbuild: WARNING — could not read metatheory/Dregg2 tree oids from git here, so the" >&2
    echo "        release fast path has nothing to ask for. Only the donor path is available." >&2
  fi

  # Describe a tree oid the way a human needs it: which commit, how far back.
  _pb_tree_desc() {
    local _t="$1" _row
    [ -n "$_t" ] && [ "$_t" != "-" ] || { printf 'UNKNOWN (no provenance recorded)'; return; }
    _row="$(printf '%s\n' "$SEED_TREE_INFO" | awk -v t="$_t" '$1 == t { print $2, $3; exit }')"
    if [ -z "$_row" ]; then
      printf 'tree %s — NOT any of the last %s commits of this history' "${_t:0:12}" "$SEED_ANCESTORS"
    elif [ "$_t" = "$SEED_HEAD_TREE" ]; then
      printf 'EXACT — HEAD:metatheory/Dregg2 (%s)' "${_t:0:12}"
    else
      printf 'commit %s, %s commits behind HEAD' \
        "$(git -C "${SRC%/}" rev-parse --short "${_row%% *}" 2>/dev/null || echo "${_row%% *}")" \
        "${_row##* }"
    fi
  }

  # ---- run the provisioner on the box (one round trip) ---------------------
  PROV_STATUS=0
  # shellcheck disable=SC2087 # LANE/SEED_* are charset-validated locals, deliberately interpolated.
  PROV_OUT="$(ssh "$HOST" "bash -s" 2>&1 <<PROV_EOF
set -u
LANE_DIR="\$HOME/dregg-build/${LANE}"
ARCH="\$LANE_DIR/${LEAN_ARCHIVE}"
PROV="\$LANE_DIR/${LEAN_ARCHIVE_PROV}"
FETCH="\$LANE_DIR/scripts/fetch-lean-seed.sh"
KEYSH="\$LANE_DIR/scripts/lean-seed-key.sh"
TAG='${SEED_TAG}'
SLUG='${SEED_REPO}'
REFRESH='${PBUILD_REFRESH_ARCHIVE:-0}'
SOURCES='${PBUILD_SEED_SOURCES:-release,donor}'
DONOR_PREF='${PBUILD_SEED_DONOR_LANE:-}'
SELF_LANE='${LANE}'
TREES='${SEED_TREES}'
T0=\$(date +%s)

say() { printf 'pbuild:   %s\n' "\$*"; }
res() { printf 'PROVRESULT %s\n' "\$*"; }
st_size()  { stat -c %s "\$1" 2>/dev/null || stat -f %z "\$1" 2>/dev/null || echo 0; }
st_mtime() { stat -c %Y "\$1" 2>/dev/null || stat -f %m "\$1" 2>/dev/null || echo 0; }

# ---- the required exports: the LANE'S OWN fetch script is the source ------
# Hardcoding this list here would be a second place to update, and the failure of a drifted copy
# is a REJECTED GOOD ARCHIVE (fail-closed, invisible). So it is read out of the acceptance block
# of the lane's fetch-lean-seed.sh. The pinned list below is a FALLBACK for when that parse yields
# fewer than the seven known symbols — and it says so out loud rather than quietly disagreeing.
SYMS="\$(sed -n '/for sym in/,/^[[:space:]]*do[[:space:]]*\$/p' "\$FETCH" 2>/dev/null \\
  | grep -oE 'dregg_[a-z0-9_]+' | sort -u)"
NSYMS=\$(printf '%s\n' "\$SYMS" | grep -c . || true)
if [ "\${NSYMS:-0}" -lt 7 ]; then
  say "WARNING — parsed only \${NSYMS:-0} required exports out of scripts/fetch-lean-seed.sh"
  say "          (expected at least 7). Falling back to the pinned list; that parse has DRIFTED."
  SYMS='dregg_exec_full_forest_auth
dregg_fips204_verify_real
dregg_fips204_sign_real
dregg_mldsa_keygen_real
dregg_mlkem_encaps_real
dregg_mlkem_decaps_real
dregg_mlkem_keygen_real'
fi

# Prints the MISSING symbols, one per line; prints __NO_NM__ when it cannot look.
missing_exports() {
  command -v nm >/dev/null 2>&1 || { echo __NO_NM__; return 0; }
  _pat="\$(printf '%s\n' "\$SYMS" | paste -sd'|' -)"
  # NEVER \`nm … | grep -q\`: grep -q exits at the first match and SIGPIPEs nm, and a pipefail
  # shell then reports FAILURE for a symbol that was FOUND. fetch-lean-seed.sh documents that
  # exact bug. This grep reads to EOF and keeps only the seven names, so the result stays tiny.
  _have="\$(nm "\$1" 2>/dev/null | grep -oE "(\$_pat)" | sort -u || true)"
  for _s in \$SYMS; do
    case "\$_have" in *"\$_s"*) ;; *) echo "\$_s" ;; esac
  done
}

prov_read() {
  P_KEY=unknown; P_TREE=-; P_SRC=-; P_ASSET=-; P_SIZE=0; P_MTIME=0; P_EXPORTS=no
  [ -f "\$1" ] || return 1
  for _kv in \$(cat "\$1" 2>/dev/null); do
    case "\$_kv" in
      key=*)     P_KEY="\${_kv#key=}" ;;
      tree=*)    P_TREE="\${_kv#tree=}" ;;
      source=*)  P_SRC="\${_kv#source=}" ;;
      asset=*)   P_ASSET="\${_kv#asset=}" ;;
      size=*)    P_SIZE="\${_kv#size=}" ;;
      mtime=*)   P_MTIME="\${_kv#mtime=}" ;;
      exports=*) P_EXPORTS="\${_kv#exports=}" ;;
    esac
  done
  return 0
}
# key tree source asset  — size/mtime/checked are read off the file that is actually there.
prov_write() {
  printf 'key=%s tree=%s source=%s asset=%s size=%s mtime=%s exports=ok checked=%s by=pbuild\n' \\
    "\$1" "\$2" "\$3" "\$4" "\$(st_size "\$ARCH")" "\$(st_mtime "\$ARCH")" \\
    "\$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "\$PROV.tmp.\$\$"
  mv -f "\$PROV.tmp.\$\$" "\$PROV"
}

# ---- the git shim: inject the ONE fact a lane cannot compute --------------
SHIM="\$(mktemp -d)"
trap 'rm -rf "\$SHIM"' EXIT
PB_REAL_GIT="\$(command -v git 2>/dev/null || true)"
export PB_REAL_GIT
cat > "\$SHIM/git" <<'SHIM_EOF'
#!/bin/sh
# pbuild shim. Answers ONLY \`rev-parse <rev>:metatheory/Dregg2\`, from \$PB_SEED_TREE — the one
# value a lane cannot know because it has no .git. Everything else goes to the real git.
for _a in "\$@"; do
  case "\$_a" in
    *:metatheory/Dregg2)
      if [ -n "\${PB_SEED_TREE:-}" ]; then printf '%s\n' "\$PB_SEED_TREE"; exit 0; fi ;;
  esac
done
[ -n "\${PB_REAL_GIT:-}" ] || exit 1
exec "\$PB_REAL_GIT" "\$@"
SHIM_EOF
chmod +x "\$SHIM/git"
   # Probed through a FRESH shell, the way lean-seed-key.sh will reach it: a \`git\` already
   # hashed by this shell would resolve without consulting PATH and the probe would prove nothing
   # about the nested call that actually matters.
if [ "\$(PB_SEED_TREE=shimprobe PATH="\$SHIM:\$PATH" bash -c 'git rev-parse HEAD:metatheory/Dregg2' 2>/dev/null)" != shimprobe ]; then
  say "the git shim did NOT take effect on this box — abandoning the release path rather than"
  say "letting lean-seed-key.sh fall into its file-hash fallback (a different key space, which"
  say "can never name a published asset and would look exactly like 'nothing is published')."
  TREES=""
fi

asset_of() { PB_SEED_TREE="\$1" PATH="\$SHIM:\$PATH" bash "\$KEYSH" --asset 2>/dev/null || true; }
key_of()   { PB_SEED_TREE="\$1" PATH="\$SHIM:\$PATH" bash "\$KEYSH" --key   2>/dev/null || true; }

# ---- 0. is what the lane already has usable? -----------------------------
USABLE=0
P_KEY=unknown; P_TREE=-; P_SRC=-; P_ASSET=-; P_SIZE=0; P_MTIME=0; P_EXPORTS=no
if [ -f "\$ARCH" ]; then
  _sz=\$(st_size "\$ARCH"); _mt=\$(st_mtime "\$ARCH")
  prov_read "\$PROV" || true
  if [ "\$P_EXPORTS" = ok ] && [ "\$P_SIZE" = "\$_sz" ] && [ "\$P_MTIME" = "\$_mt" ]; then
    USABLE=1
    say "archive present, vouched by its provenance record (skipping the ~8s export rescan)."
  else
    say "archive present with no valid provenance record — scanning its exports (~8s at 478 MB)…"
    _miss="\$(missing_exports "\$ARCH")"
    case "\$_miss" in
      "")
        USABLE=1; P_KEY=unknown; P_TREE=-; P_SRC=adopted
        prov_write unknown - adopted -
        say "ADOPTED it: every required export is present. Provenance UNKNOWN — pbuild did not"
        say "place this file, so which Dregg2 tree it was built from cannot be established here." ;;
      __NO_NM__)
        USABLE=1
        say "WARNING — no \\\`nm\\\` on this box, so the exports could NOT be checked. Treating the"
        say "          archive as present and UNVERIFIED." ;;
      *)
        say "the archive in this lane is MISSING required exports — it cannot back a verified run:"
        printf 'pbuild:     - %s\n' \$_miss
        _bad="\$ARCH.rejected-\$(date +%s).bak"
        mv -f "\$ARCH" "\$_bad" && rm -f "\$PROV"
        say "moved aside to \$_bad (kept, not deleted — a .bak is gitignored here so it neither"
        say "reaches git nor survives as a surprise input). Re-provisioning." ;;
    esac
  fi
fi

# Snapshot what the lane already has: the P_* globals get reused when reading a DONOR's record.
U_KEY="\$P_KEY"; U_TREE="\$P_TREE"; U_SRC="\$P_SRC"; U_ASSET="\$P_ASSET"
if [ "\$USABLE" = 1 ] && [ "\$REFRESH" != 1 ]; then
  res "state=kept key=\$U_KEY tree=\$U_TREE source=\$U_SRC asset=\$U_ASSET elapsed=\$(( \$(date +%s) - T0 ))"
  exit 0
fi

# ---- 1. the release fast path -------------------------------------------
rung_enabled() { case ",\$SOURCES," in *",\$1,"*) return 0 ;; *) return 1 ;; esac; }

from_release() {
  rung_enabled release || { say "the 'release' rung is disabled by PBUILD_SEED_SOURCES=\$SOURCES."; return 1; }
  [ -n "\$TREES" ] || { say "no candidate Dregg2 trees available — skipping the release path."; return 1; }
  [ -n "\$SLUG" ]  || { say "no owner/repo for the seed release (set PBUILD_SEED_REPO)."; return 1; }
  command -v zstd >/dev/null 2>&1 || { say "zstd is absent on this box; a seed asset cannot be decompressed."; return 1; }
  _list=""
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    _list="\$(gh release view "\$TAG" --repo "\$SLUG" --json assets --jq '.assets[].name' 2>/dev/null || true)"
  fi
  if [ -z "\$_list" ]; then
    _list="\$(curl -fsSL "https://api.github.com/repos/\$SLUG/releases/tags/\$TAG" 2>/dev/null \\
      | grep -oE '"name": *"libdregg_lean[^"]*"' | sed 's/.*"\\(libdregg_lean[^"]*\\)"/\\1/' || true)"
  fi
  if [ -z "\$_list" ]; then
    say "could not list assets of release '\$TAG' in \$SLUG (no gh auth here and no API reach)."
    return 1
  fi
  # A seed decompresses to ~478 MB. /tmp on these boxes is a tmpfs, i.e. RAM — 12.4 GB of
  # unreclaimable tmpfs inside the build cgroup was reclaimed on hbox today. Stage inside the
  # lane's own gitignored target/ instead: it is on disk, and on the SAME filesystem as the
  # destination, which is also what makes fetch-lean-seed.sh's final \`mv\` a real atomic rename
  # rather than a cross-device copy another build could read half of.
  _stage="\$LANE_DIR/target/.pbuild-seed"
  mkdir -p "\$_stage"
  _tried=0
  for _t in \$TREES; do
    _a="\$(asset_of "\$_t")"
    [ -n "\$_a" ] || continue
    case "\$_list" in *"\$_a"*) ;; *) continue ;; esac
    _tried=\$((_tried + 1))
    say "published asset found for Dregg2 tree \$_t:"
    say "  \$_a"
    _out="\$(PB_SEED_TREE="\$_t" PATH="\$SHIM:\$PATH" DREGG_SEED_REPO="\$SLUG" DREGG_SEED_TAG="\$TAG" \\
             TMPDIR="\$_stage" bash "\$FETCH" --force 2>&1)"; _st=\$?
    printf '%s\n' "\$_out" | sed 's/^/pbuild:     /'
    if [ "\$_st" -eq 0 ] && [ -f "\$ARCH" ]; then
      prov_write "\$(key_of "\$_t")" "\$_t" release "\$_a"
      prov_read "\$PROV" || true
      res "state=placed source=release key=\$P_KEY tree=\$_t asset=\$_a elapsed=\$(( \$(date +%s) - T0 ))"
      return 0
    fi
    say "that fetch FAILED (status \$_st) — trying the next candidate."
  done
  say "no published asset for HEAD or any of \$(printf '%s\n' \$TREES | grep -c .) ancestor Dregg2 trees (\$_tried attempted)."
  return 1
}

# ---- 2. the donor path: another lane on this same box --------------------
from_donor() {
  rung_enabled donor || { say "the 'donor' rung is disabled by PBUILD_SEED_SOURCES=\$SOURCES."; return 1; }
  _cands=""
  [ -n "\$DONOR_PREF" ] && [ -f "\$HOME/dregg-build/\$DONOR_PREF/${LEAN_ARCHIVE}" ] && _cands="\$DONOR_PREF"
  # Newest archive first — on this box that is the closest thing to "most recently provisioned".
  for _d in \$(ls -dt "\$HOME"/dregg-build/*/dregg-lean-ffi/libdregg_lean.a 2>/dev/null); do
    _l="\${_d#\$HOME/dregg-build/}"; _l="\${_l%%/*}"
    [ "\$_l" = "\$SELF_LANE" ] && continue
    [ "\$_l" = "\$DONOR_PREF" ] && continue
    _cands="\$_cands \$_l"
  done
  [ -n "\$_cands" ] || { say "no other lane on this box holds an archive to copy."; return 1; }
  for _l in \$_cands; do
    _src="\$HOME/dregg-build/\$_l/${LEAN_ARCHIVE}"
    [ -f "\$_src" ] || continue
    _sprov="\$HOME/dregg-build/\$_l/${LEAN_ARCHIVE_PROV}"
    _dkey=unknown; _dtree=-
    if prov_read "\$_sprov" \\
       && [ "\$P_EXPORTS" = ok ] \\
       && [ "\$P_SIZE" = "\$(st_size "\$_src")" ] && [ "\$P_MTIME" = "\$(st_mtime "\$_src")" ]; then
      _dkey="\$P_KEY"; _dtree="\$P_TREE"
      say "donor lane '\$_l' is vouched by its own provenance record."
    else
      say "checking donor lane '\$_l' exports…"
      _miss="\$(missing_exports "\$_src")"
      case "\$_miss" in
        "") ;;
        __NO_NM__) say "  cannot check exports here (no nm) — refusing to copy an unverifiable donor."; continue ;;
        *) say "  donor '\$_l' is missing required exports; skipping it:"
           printf 'pbuild:     - %s\n' \$_miss; continue ;;
      esac
    fi
    say "copying the archive from lane '\$_l' …"
    if cp --reflink=auto "\$_src" "\$ARCH.tmp.\$\$" 2>/dev/null || cp "\$_src" "\$ARCH.tmp.\$\$"; then
      mv -f "\$ARCH.tmp.\$\$" "\$ARCH"
      prov_write "\$_dkey" "\$_dtree" "donor:\$_l" -
      res "state=placed source=donor:\$_l key=\$_dkey tree=\$_dtree asset=- elapsed=\$(( \$(date +%s) - T0 ))"
      return 0
    fi
    rm -f "\$ARCH.tmp.\$\$"
    say "  the copy from '\$_l' failed."
  done
  return 1
}

if from_release || from_donor; then exit 0; fi
if [ "\$USABLE" = 1 ]; then
  say "a refresh was requested but nothing better was reachable — keeping the archive already here."
  res "state=kept key=\$U_KEY tree=\$U_TREE source=\$U_SRC asset=\$U_ASSET elapsed=\$(( \$(date +%s) - T0 ))"
  exit 0
fi
# Name the asset that does NOT exist — but only if a real tree oid was injected. With no
# candidates the shim is inert, KEYSH falls into its file-hash fallback, and the "expected asset"
# it would print is a name from a key space no publisher ever used. Printing that as the thing to
# go publish would send someone hunting for an asset that could never exist.
_head_asset="-"
if [ -n "\$TREES" ]; then _head_asset="\$(asset_of "\$(printf '%s\n' \$TREES | head -1)")"; fi
res "state=unprovisioned head_asset=\${_head_asset:--} elapsed=\$(( \$(date +%s) - T0 ))"
exit 7
PROV_EOF
)" || PROV_STATUS=$?
  printf '%s\n' "$PROV_OUT" | grep -v '^PROVRESULT ' >&2 || true

  _pb_prov_field() {
    printf '%s\n' "$PROV_OUT" \
      | awk -v k="$1" '/^PROVRESULT /{for(i=2;i<=NF;i++){n=index($i,"=");if(n>0&&substr($i,1,n-1)==k)v=substr($i,n+1)}} END{print v}'
  }
  PROV_STATE="$(_pb_prov_field state)"
  PROV_TREE="$(_pb_prov_field tree)"
  PROV_SOURCE="$(_pb_prov_field source)"
  PROV_ELAPSED="$(_pb_prov_field elapsed)"

  # Is the archive REQUIRED for this command? `cargo build` with no archive degrades to
  # marshal-only and says so; a command that RUNS a binary is where the bare SIGABRT lands, and
  # that is the false red worth refusing over. Compound shell commands are matched on the same
  # text, so `pbuild lane 'cd x && cargo test -p y'` is caught too.
  ARCHIVE_REQUIRED=0
  case "${PBUILD_REQUIRE_ARCHIVE:-auto}" in
    1) ARCHIVE_REQUIRED=1 ;;
    0) ARCHIVE_REQUIRED=0 ;;
    *) case "$PBUILD_CMD_DESC" in
         *"cargo test"*|*"cargo nextest"*|*"nextest run"*|*"cargo run"*|*"cargo bench"*)
           ARCHIVE_REQUIRED=1 ;;
       esac ;;
  esac
  # An explicit operator opt-in to the unaudited path is a decision already taken; do not
  # second-guess it, but never let it pass silently either.
  if [ "${DREGG_ALLOW_UNAUDITED_PQ:-0}" = 1 ] && [ "$ARCHIVE_REQUIRED" = 1 ]; then
    ARCHIVE_REQUIRED=0
    echo "pbuild: DREGG_ALLOW_UNAUDITED_PQ=1 is set, so a missing archive will not refuse — you" >&2
    echo "        have asked for the UNAUDITED marshal-only path and will get it." >&2
  fi

  if [ "$PROV_STATUS" -eq 0 ] && [ -n "$PROV_STATE" ]; then
    echo "pbuild: lean archive ${PROV_STATE} in lane '${LANE}' (${PROV_SOURCE:-?}, ${PROV_ELAPSED:-?}s)" >&2
    echo "        Dregg2 provenance: $(_pb_tree_desc "$PROV_TREE")" >&2
    if [ -n "$(git -C "${SRC%/}" status --porcelain -- metatheory/Dregg2 2>/dev/null)" ]; then
      echo "        ⚠ metatheory/Dregg2 is DIRTY here, and the lane received the WORKING tree while" >&2
      echo "          a seed is keyed to a COMMITTED one — so no published asset can correspond to" >&2
      echo "          the sources being built. dregg-lean-ffi/build.rs is the authority: it splices" >&2
      echo "          the current slice over the seed from a warm .lake and refuses a stale one" >&2
      echo "          under DREGG_REQUIRE_LEAN=1." >&2
    fi
  elif [ "$ARCHIVE_REQUIRED" = 1 ]; then
    {
      echo ""
      echo "pbuild: REFUSING — lane '${LANE}' on ${HOST} has NO usable ${LEAN_ARCHIVE},"
      echo "        and the command you gave RUNS test binaries. Without that archive the build is"
      echo "        marshal-only and every executor-touching test dies with a BARE SIGABRT and no"
      echo "        panic message — an ENVIRONMENT fault that reads exactly like your own bug."
      echo "        Refusing is the whole point: nothing may be read off that log."
      echo ""
      echo "        WHAT IS MISSING — the platform-native seed for this checkout:"
      _pb_head_asset="$(_pb_prov_field head_asset)"
      if [ -n "$_pb_head_asset" ] && [ "$_pb_head_asset" != "-" ]; then
        echo "          release ${SEED_TAG} in ${SEED_REPO:-<unknown repo>} has no asset named"
        echo "            ${_pb_head_asset}"
        echo "          nor one for any of the last ${SEED_ANCESTORS} commits' Dregg2 trees."
        echo "          What each rung actually reported — release, then donor — is in the"
        echo "          provisioner lines above; read those rather than assuming which one failed."
      else
        echo "          the expected asset name could not even be COMPUTED — see the provisioner"
        echo "          output above (no git history to read Dregg2 tree oids from, or the box"
        echo "          could not run the lane's own scripts/lean-seed-key.sh)."
      fi
      echo ""
      echo "        HOW TO GET ONE (in increasing cost):"
      echo "          • publish a seed for THIS tree — the workflow is MANUAL-ONLY since 2026-07-25:"
      echo "              gh workflow run lean-seed.yml -f platforms=linux-x86_64"
      echo "            it is idempotent on the content key, and ~19-25 min on hbox when it must"
      echo "            actually build. Then re-run this pbuild; the fetch is ~23 s."
      echo "          • commit your metatheory/Dregg2 changes first if they are uncommitted: the key"
      echo "            is over the COMMITTED tree, so CI cannot publish a seed for a dirty worktree."
      echo "          • seed a donor lane from source on the box (HOURS of leanc, saturates it):"
      echo "              ssh ${HOST} 'cd dregg-build/${LANE} && ./scripts/bootstrap.sh'"
      echo ""
      echo "        OR STATE THE TRADE EXPLICITLY, and it will run:"
      echo "          PBUILD_REQUIRE_ARCHIVE=0 scripts/pbuild ${LANE} $*   # no archive, tests may abort"
      echo "          DREGG_ALLOW_UNAUDITED_PQ=1 …                          # marshal-only, unverified PQ"
      echo ""
    } >&2
    exit 5
  else
    echo "pbuild: WARNING — no usable ${LEAN_ARCHIVE} in lane '${LANE}', and this command does not" >&2
    echo "        run test binaries, so pbuild is not refusing. Anything that DOES run one here" >&2
    echo "        will build marshal-only and abort with a bare SIGABRT. See the provisioner output" >&2
    echo "        above for what was missing." >&2
  fi
fi

# ---- forward the DREGG_* build knobs to the remote shell ------------------
# `ssh` does not carry the caller's environment, so `DREGG_FOO=1 scripts/pbuild …`
# silently had NO EFFECT on the remote build — the variable was consumed by the
# local pbuild process and never crossed. That is a quiet, expensive kind of wrong:
# a lane sets `DREGG_ALLOW_UNAUDITED_PQ=1`, sees the same SIGABRT it was trying to
# opt out of, and concludes its CODE is broken. (Cost one cycle to find, tonight.)
#
# An ALLOWLIST of names is forwarded, each value shell-quoted, so this cannot smuggle
# PATH/LD_PRELOAD or any other ambient influence onto the box. Explicit
# `env VAR=… cargo …` in the command still works and still wins.
#
# ⚠ THE ALLOWLIST INCLUDES THE RESOURCE KNOBS (2026-07-25), because until it did, the
# documented remedy for an OOM-killed build did not exist. `swarm-build` reads
# SWARM_MEM_MAX from its OWN environment on the remote, and lake's only fan-out knob
# is LEAN_NUM_THREADS (it has no -j) — neither is DREGG_-prefixed, so
# `SWARM_MEM_MAX=64G scripts/hbuild …` was consumed by the local process and the
# remote build ran at the 96G default with the caller believing otherwise. A lane
# could SEE the cap was the problem and still have no way to change it.
#
# CARGO_PROFILE_DEV_* is allowlisted so a lane can measure a profile change WITHOUT editing
# Cargo.toml (2026-07-25). Editing `[profile.dev]` changes the fingerprint of EVERY artifact in the
# workspace and invalidates every cache in every lane — a full fleet-wide rebuild. The env form
# invalidates only the lane that opts in, so the measurement is affordable and nobody else pays.
# The measurement that motivated it: a `dreggnet_web_server` debug binary is 1.46 GB, of which
# 83.4% is DWARF (.debug_str 490 MB, .debug_info 375 MB, .debug_loc 226 MB) against 107 MB of
# .text. `.debug_loc` is that large because of `opt-level = 3`, not because of `debug` — an
# optimized variable needs a location LIST per live range instead of one stack slot. So:
#   CARGO_PROFILE_DEV_DEBUG=line-tables-only scripts/pbuild <lane> cargo test -p <crate>
# keeps file:line in panics (this repo has many panic-based `must_refuse` teeth) and should drop
# roughly 1.15 GB of the 1.21 GB. MEASURE it on one lane before proposing the shared-profile flip.
PBUILD_ENV_ALLOW_RE='^(DREGG_[A-Z0-9_]*|SWARM_MEM_MAX|LEAN_NUM_THREADS|RUST_BACKTRACE|RUSTFLAGS|CARGO_PROFILE_DEV_[A-Z0-9_]*|CARGO_INCREMENTAL)$'
REMOTE_ENV=""
_pb_fwd_names=""
while IFS= read -r _v; do
  [ -n "$_v" ] || continue
  printf -v _q '%q' "${!_v}"
  REMOTE_ENV+="export ${_v}=${_q}; "
  _pb_fwd_names+="${_v} "
done <<<"$(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | grep -E "$PBUILD_ENV_ALLOW_RE" || true)"
[ -n "$REMOTE_ENV" ] && echo "pbuild: forwarding ${_pb_fwd_names}to ${HOST}" >&2

# Every guard has passed and the tree is synced: from here a nonzero status is the
# BUILD's verdict, not a refusal. (See the VERDICT block at the top.)
PBUILD_PHASE=run

# Build with cargo + elan env sourced (non-login shells lack them).
#
# ⚠ ARGV IS QUOTED ON BOTH BRANCHES (2026-07-25). The no-wrapper branch used to end
# in an UNQUOTED `cd '$REMOTE' && $*`, so the remote shell re-split every argument on
# whitespace. persvati is the no-wrapper host, so persvati was the branch that had it.
# The comment six lines down claiming "nextest filters and feature lists cross ssh
# with their argv intact" described only the WRAPPER branch — a true sentence about
# the code it did not sit above.
#
# What it actually breaks: `pbuild lane cargo test -p p --test t -- --exact 'a b'`
# arrives as ... --exact a b, and a test filter that names nothing is not an error —
# it is `0 passed; 0 filtered out`, i.e. a GREEN with no test in it. That is the
# silent-green shape this repo keeps paying for, wired into the build tool itself.
#
# Both branches now use one rule: a SINGLE argument is passed verbatim (that is the
# established compound-command interface — `pbuild lane 'cd x && y; z'` must keep
# working, and quoting it would break every caller), and MULTIPLE arguments are
# individually `%q`-quoted so argv survives the remote shell.
if [ "$#" -eq 1 ]; then
  REMOTE_COMMAND="$1"
else
  printf -v REMOTE_COMMAND '%q ' "$@"
fi

_pb_run_status=0
if [ -z "$REMOTE_WRAPPER" ]; then
  # shellcheck disable=SC2029 # REMOTE/REMOTE_ENV/REMOTE_COMMAND are locally owned and quoted above.
  ssh "$HOST" "set -e; source ~/.cargo/env 2>/dev/null || true; \
    [ -f ~/.elan/env ] && source ~/.elan/env 2>/dev/null || true; \
    export PATH=\"\$HOME/.cargo/bin:\$HOME/.elan/bin:\$PATH\"; \
    ${REMOTE_ENV}\
    cd '${REMOTE}' && ${REMOTE_COMMAND}" || _pb_run_status=$?
else
  printf -v REMOTE_COMMAND_Q '%q' "$REMOTE_COMMAND"
  # ⚠ ${REMOTE_ENV} BELONGS ON THIS BRANCH TOO (2026-07-25). It was interpolated into
  # the no-wrapper branch only, so every forwarded knob was DROPPED on hbox — while
  # the line above still printed "pbuild: forwarding DREGG_… to hbox". An announcement
  # with no mechanism, and on the branch that carries the Lean box: `DREGG_REQUIRE_LEAN`
  # is precisely the knob that decides whether a test consults the verified core or
  # degrades to its Rust twin, and on hbox it was silently ignored. It also has to sit
  # BEFORE the `exec` so swarm-build itself inherits SWARM_MEM_MAX.
  # shellcheck disable=SC2029 # REMOTE_COMMAND_Q/WRAPPER_Q are client-shell-quoted by construction.
  ssh "$HOST" "set -e; source ~/.cargo/env 2>/dev/null || true; \
    [ -f ~/.elan/env ] && source ~/.elan/env 2>/dev/null || true; \
    export PATH=\"\$HOME/.cargo/bin:\$HOME/.elan/bin:\$PATH\"; \
    ${REMOTE_ENV}\
    cd '${REMOTE}' && exec ${REMOTE_WRAPPER_Q} bash -c ${REMOTE_COMMAND_Q}" || _pb_run_status=$?
fi

# A nonzero status is the moment — and the only moment — worth asking the box whether
# it did this. See the ENVFAULT block at the top for why this is not a nicety.
if [ "$_pb_run_status" -ne 0 ]; then
  if _pb_disk_lines="$(_pbuild_enospc_evidence)"; then
    PBUILD_ENVFAULT=1
    {
      echo ""
      echo "pbuild: ⚠ THE BOX RAN OUT OF DISK — this is an ENVIRONMENT fault, NOT your code,"
      echo "        and NOT a verdict. ENOSPC surfaces as \`error: linking with cc failed\` and"
      echo "        \`could not compile <crate>\`, which is EXACTLY the shape of a real compile"
      echo "        break — so a red read off this log is a red about the disk."
      echo ""
      echo "        Evidence from ${HOST}:"
      printf '%s\n' "$_pb_disk_lines"
      echo ""
      echo "        What to do instead:"
      echo "          • scripts/sweep-build-lanes.sh --apply      (orphan generations, safe)"
      echo "          • scripts/lane-lease.sh reap-orphaned --host ${HOST}"
      echo "            then sweep again — a corpse-held lease blocks its lane from the sweep."
      echo "          • If it refills immediately, the sweep is NOT the remedy: it can only"
      echo "            delete SUPERSEDED generations, and a box full of live KEEP across many"
      echo "            lanes needs fewer lanes. Check \`scripts/box-health.sh\`."
      echo "          • Narrow the unit meanwhile: \`-p <crate>\` beats \`--workspace\`, which is"
      echo "            what the testing doctrine says anyway."
      echo ""
    } >&2
  elif _pb_oom_lines="$(_pbuild_oom_evidence)"; then
    PBUILD_ENVFAULT=1
    {
      echo ""
      echo "pbuild: ⚠ THE BOX KILLED THIS BUILD FOR MEMORY — this is an ENVIRONMENT fault,"
      echo "        NOT your code, and NOT a verdict. Do not read a red off this log, and"
      echo "        do not retry the identical command: on 2026-07-24 a lane retried one"
      echo "        OOM-killed \`lake build\` nine times in 32 minutes and learned nothing."
      echo ""
      echo "        Evidence from ${HOST}:"
      printf '          %s\n' "$_pb_oom_lines"
      echo ""
      echo "        What to do instead:"
      echo "          • RAISE THE CAP first. Every OOM-kill measured on hbox sat exactly on"
      echo "            a per-build \`SWARM_MEM_MAX\` value, never on box pressure — and no"
      echo "            surviving build has ever exceeded ~14G. If you inherited"
      echo "            SWARM_MEM_MAX=24G from a doc recipe, that cap is the whole problem:"
      echo "              SWARM_MEM_MAX=64G scripts/hbuild ${LANE} <cmd>"
      echo "          • Narrow the unit. One module (\`lake build Some.One.Module\`) rather"
      echo "            than a nine-module line, so the peak is one module's peak."
      echo "          • Bound Lean's fan-out: LEAN_NUM_THREADS=4 (lake has no -j)."
      echo "          • Serialize. Another lane's build may be sharing the cgroup ceiling."
      echo ""
    } >&2
  fi
  exit "$_pb_run_status"
fi
